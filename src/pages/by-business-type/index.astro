---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CTASection from '../../components/CTASection.astro';

const locale = 'en' as const;

const types = [
  { slug: 'bakery-shop', name: 'Bakery Shop', icon: '🥐', desc: 'Independent bakery, 1–3 locations. Owner-operator pain.' },
  { slug: 'coffee-chain', name: 'Coffee Chain', icon: '☕', desc: '5–50 locations. SOP consistency at scale.' },
  { slug: 'patisserie', name: 'Patisserie', icon: '🧁', desc: 'French-style pastry. Delicate molds, premium service.' },
  { slug: 'cake-shop', name: 'Cake Shop', icon: '🎂', desc: 'Birthday & wedding cakes. Cream and fondant residue.' },
  { slug: 'small-restaurant', name: 'Small Restaurant', icon: '🍽️', desc: '50–150 seats. Mixed bakeware + dishware.' },
  { slug: 'cafeteria', name: 'Cafeteria', icon: '🥪', desc: 'Employee canteens, schools. Peak-hour throughput.' },
  { slug: 'hotel-pastry-kitchen', name: 'Hotel Pastry Kitchen', icon: '🏨', desc: 'Breakfast buffet, banquet pastry. High volume.' },
  { slug: 'cloud-kitchen', name: 'Cloud Kitchen', icon: '👨‍🍳', desc: 'Ghost kitchen, virtual restaurant. No front-of-house.' },
];
---
<BaseLayout
  title="For Your Business — JD-3 by Business Type | Bakery Tray Washer"
  description="See how the V-TAI JD-3 bakery tray washer fits your specific business — bakery, café chain, patisserie, cake shop, restaurant, cafeteria, hotel, or cloud kitchen."
  locale={locale}
  canonicalPath="/by-business-type/"
  schemaType="Article"
>
<BreadcrumbNav items={[{label: 'Home', href: '/'}, {label: 'For Your Business'}]} />

<section class="section">
  <div class="container-page">
    <h1 class="mb-4 text-center">For Your Business</h1>
    <p class="text-bakery-navy/70 text-lg max-w-2xl mx-auto text-center mb-10">
      The JD-3 isn't a generic dishwasher — it solves specific painpoints. Pick your business type to see ROI calculations, configuration recommendations, and what other operators in your category have learned.
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {types.map((t) => (
        <a href={`/by-business-type/${t.slug}/`} class="card hover:scale-[1.02] transition">
          <div class="text-4xl mb-3">{t.icon}</div>
          <h3 class="text-lg mb-2">{t.name}</h3>
          <p class="text-sm text-bakery-navy/70">{t.desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<CTASection locale={locale} />
</BaseLayout>
