---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'fr' as const;
---
<BaseLayout title="Exigences Électriques | JD-3" description="Exigences Électriques" locale={locale} canonicalPath="/guides/electrical-requirements-bakery-dishwasher/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/fr/' },
  { label: t(locale, 'nav.guides') },
  { label: "Exigences Électriques" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Exigences Électriques</h1>
<p class="text-lg mb-6">Guide pratique pour les boulangers utilisant le V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/electrical-requirements-bakery-dishwasher/" class="underline">Voir la version anglaise complète</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
