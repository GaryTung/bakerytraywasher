---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'fr' as const;
---
<BaseLayout title="Comment Choisir un Lave-Plaques | JD-3" description="Comment Choisir un Lave-Plaques" locale={locale} canonicalPath="/guides/how-to-choose-bakery-tray-washer/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/fr/' },
  { label: t(locale, 'nav.guides') },
  { label: "Comment Choisir un Lave-Plaques" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Comment Choisir un Lave-Plaques</h1>
<p class="text-lg mb-6">Guide pratique pour les boulangers utilisant le V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/how-to-choose-bakery-tray-washer/" class="underline">Voir la version anglaise complète</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
