---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'fr' as const;
---
<BaseLayout title="Le Coût Réel du Lavage Manuel | JD-3" description="Le Coût Réel du Lavage Manuel" locale={locale} canonicalPath="/guides/cost-of-manual-tray-cleaning/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/fr/' },
  { label: t(locale, 'nav.guides') },
  { label: "Le Coût Réel du Lavage Manuel" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Le Coût Réel du Lavage Manuel</h1>
<p class="text-lg mb-6">Guide pratique pour les boulangers utilisant le V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/cost-of-manual-tray-cleaning/" class="underline">Voir la version anglaise complète</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
