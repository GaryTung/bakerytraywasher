---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'fr' as const;
---
<BaseLayout title="La Norme Boulangère 600×400 mm Expliquée | JD-3" description="La Norme Boulangère 600×400 mm Expliquée" locale={locale} canonicalPath="/guides/600x400-bakery-norm-explained/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/fr/' },
  { label: t(locale, 'nav.guides') },
  { label: "La Norme Boulangère 600×400 mm Expliquée" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">La Norme Boulangère 600×400 mm Expliquée</h1>
<p class="text-lg mb-6">Guide pratique pour les boulangers utilisant le V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/600x400-bakery-norm-explained/" class="underline">Voir la version anglaise complète</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
