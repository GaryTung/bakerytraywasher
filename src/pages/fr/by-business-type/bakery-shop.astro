---
import BusinessTypeLayout from '../../../layouts/BusinessTypeLayout.astro';
const locale = 'fr' as const;
---
<BusinessTypeLayout locale={locale} canonicalPath="/by-business-type/bakery-shop/" slug="bakery-shop" businessName="Boulangerie"
  icon="🥐"
  title="Lave-Plaques pour Boulangerie Indépendante"
  description="Le JD-3 est la bonne machine pour une boulangerie indépendante mono-site — dimensionnée pour votre cuisine, avec un prix adapté à votre budget."
  reality="Vous avez ouvert votre boulangerie parce que vous aimez ce qui sort du four, pas pour passer trois heures chaque soir à récurer les plaques. Si vous tenez une boulangerie indépendante de 1 à 3 sites, vous lavez probablement 150-200 plaques/jour. C'est 2-3 heures de main-d'œuvre quotidienne."
  needs="Votre lave-vaisselle doit : 1) Accepter vos plaques (si Convotherm/Rational/Unox = 600×400). 2) Se rentabiliser vite (6-12 mois). 3) Fonctionner sans surveillance. 4) S'adapter à votre espace."
  fit="Le JD-3 est configuré par défaut pour une boulangerie mono-site : panier 650×550, capacité 180 plaques/h, encombrement 850×850 mm, prix d'entrée le plus bas du marché qualité."
  roi="Une boulangerie typique : 1 plongeur temps partiel × 12$/h × 3h/jour × 26 jours = 936$/mois. Avec JD-3 : 30 min/jour. Économie : ~10 000$/an. Retour : 7-9 mois."
  faqs={[{q:'Mon moule Pullman ?',a:'Oui — jusqu\'à 33 cm verticalement.'},{q:'Si j\'ouvre un second site ?',a:'Commandez un second JD-3 — mêmes spécifications.'}]}
/>
