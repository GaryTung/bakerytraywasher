---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'fr' as const;
---
<BaseLayout title="Bibliothèque vidéo | JD-3" description="Bibliothèque vidéo" locale={locale} canonicalPath="/resources/video-library/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/fr/'},{label: t(locale,'nav.resources'), href:'/fr/resources/'},{label: 'Bibliothèque vidéo'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Bibliothèque vidéo</h1>
<p class="text-lg mb-6 text-bakery-navy/70">Cette page est disponible en anglais :</p>
<p><a href="/resources/video-library/" class="btn-primary inline-block">Bibliothèque vidéo (EN) →</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
