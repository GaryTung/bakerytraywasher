---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'fr' as const;
---
<BaseLayout title="Guide de l'acheteur (PDF) | JD-3" description="Guide de l'acheteur (PDF)" locale={locale} canonicalPath="/resources/buyers-guide-pdf/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/fr/'},{label: t(locale,'nav.resources'), href:'/fr/resources/'},{label: 'Guide de l\'acheteur (PDF)'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Guide de l'acheteur (PDF)</h1>
<p class="text-lg mb-6 text-bakery-navy/70">Cette page est disponible en anglais :</p>
<p><a href="/resources/buyers-guide-pdf/" class="btn-primary inline-block">Guide de l'acheteur (PDF) (EN) →</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
