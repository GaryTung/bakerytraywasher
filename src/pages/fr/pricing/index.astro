---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import PriceCalloutBox from '../../../components/PriceCalloutBox.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'fr' as const;
---
<BaseLayout title="Tarifs JD-3 — À partir de 4 400 $ FOB" description="Tarification honnête pour V-TAI JD-3." locale={locale} canonicalPath="/pricing/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/fr/'},{label: t(locale,'nav.pricing')}]} />
<section class="section"><div class="container-page">
<h1 class="text-center mb-4">Tarification honnête et transparente</h1>
<p class="text-center text-bakery-navy/70 mb-10 max-w-2xl mx-auto">Pas de frais cachés. Voici exactement ce que coûte la JD-3.</p>
<div class="grid md:grid-cols-3 gap-5 max-w-5xl mx-auto">
<div class="card"><h3>JD-3 Standard</h3><p class="text-3xl font-bold text-bakery-orange">4 400 $</p><p class="text-xs text-bakery-navy/60 mb-3">FOB Shenzhen</p><p class="text-sm">Configuration de base. 380V/3N/50Hz. Inclut 2 racks, outils, manuel, certificat CE.</p></div>
<div class="card border-2 border-bakery-orange"><p class="eyebrow text-bakery-orange mb-1">★ Le plus populaire</p><h3>+ Doseur automatique</h3><p class="text-3xl font-bold text-bakery-orange">4 600 $</p><p class="text-sm">Pompe automatique de produit + agent de rinçage. Élimine le dosage manuel.</p></div>
<div class="card"><h3>+ Récupération de chaleur</h3><p class="text-3xl font-bold text-bakery-orange">4 900 $</p><p class="text-sm">Module amélioré : l'eau chaude du rinçage final alimente la cuve de lavage. Économies d'énergie 15–25%.</p></div>
</div>
<p class="text-center mt-6 text-sm text-bakery-navy/60">Tous les prix en USD, FOB Shenzhen. Fret et droits de douane variables selon le pays.</p>
<div class="mt-10 max-w-md mx-auto"><PriceCalloutBox locale={locale} /></div>
<div class="mt-10 text-center"><a href="/fr/pricing/by-country/" class="btn-primary">Voir les prix DDP rendus par pays (17 marchés)</a></div>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
