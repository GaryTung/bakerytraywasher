---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'fr' as const;
const rows = [
  { label: 'Taille panier', jd3: '650×550 mm', competitor: '500×500 mm' },
  { label: 'Plaques 600×400', jd3: '✓ Oui', competitor: '✗ Non', highlight: true },
  { label: 'Prix', jd3: '4 400 $ FOB', competitor: '5 500–7 500 $' },
];
---
<BaseLayout title="JD-3 vs Jackson TempStar | Comparaison" description="Comparaison JD-3 vs Jackson TempStar HH-E." locale={locale} canonicalPath="/product/jd-3-vs-jackson-tempstar/" schemaType="Article">
<BreadcrumbNav items={[{label:'Accueil',href:'/fr/'},{label:'Produit',href:'/fr/product/'},{label:'vs Jackson'}]} />
<section class="section"><div class="container-prose"><h1>JD-3 vs Jackson TempStar HH-E</h1><p class="text-lg mt-4 mb-6">Jackson est le mid-tier américain. JD-3 offre 35% de moins, une chambre plus grande, et compatibilité plaques 600×400.</p></div>
<div class="container-page"><ComparisonTable competitorName="Jackson TempStar" rows={rows} /></div></section>
<CTASection locale={locale} />
</BaseLayout>
