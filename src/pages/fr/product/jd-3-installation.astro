---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'fr' as const;
---
<BaseLayout title="Guide d'Installation JD-3 | V-TAI" description="Recevez la machine, suivez le tutoriel vidéo, raccordez eau et électricité — et lavez." locale={locale} canonicalPath="/product/jd-3-installation/" schemaType="HowTo">
<BreadcrumbNav items={[{label:'Accueil',href:'/fr/'},{label:'Produit',href:'/fr/product/'},{label:'Installation'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Installation JD-3 — Recevoir, Raccorder, Laver</h1>
<p class="text-lg mb-6">Le JD-3 a été conçu pour l'auto-installation. À réception, suivez le tutoriel vidéo fourni, raccordez l'eau et l'électricité, et commencez à laver. Pas d'installateur spécialisé requis — un plombier et un électricien standards suffisent.</p>
<h2 class="mt-8 mb-3">3 étapes simples</h2>
<ol class="space-y-3 list-decimal list-inside">
<li><strong>Déballer et positionner</strong> — placez la machine sur surface plane près de l'eau et du drain.</li>
<li><strong>Raccorder eau et électricité</strong> — entrée G 3/4" eau froide, drain G 1½", circuit dédié 380V/3N/50Hz (ou 400V monophasé selon norme locale).</li>
<li><strong>Suivre le tutoriel vidéo</strong> — inclus avec la livraison, également disponible via WhatsApp dès la commande. Durée typique totale : 1–2 heures.</li>
</ol>
<h2 class="mt-8 mb-3">Inclus dans la boîte</h2>
<ul class="space-y-1 list-disc list-inside">
<li>Machine JD-3</li>
<li>2 paniers standard + panier à tasses</li>
<li>Tuyau d'arrivée d'eau et tuyau de drain</li>
<li>Carte de démarrage rapide avec lien vidéo</li>
<li>Manuel d'opération</li>
<li>Certificat CE</li>
<li><strong>Schéma électrique</strong> collé à l'intérieur du panneau de service — gardez-le là pour la maintenance future</li>
</ul>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
