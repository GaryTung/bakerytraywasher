---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'fr' as const;
const posts = [
  { slug: 'bakery-tray-washer-mixed-loads', title: 'Un lave-plaques peut-il laver plaques, cuves et ustensiles ? Guide des charges mixtes', desc: 'Décidez quelles familles peuvent partager un cycle, évitez les zones d’ombre et validez un plan répétable.', date: '2026-09-02' },
  { slug: 'aluminum-baking-trays-commercial-dishwasher', title: 'Peut-on laver des plaques en aluminium au lave-vaisselle professionnel ? La check-list sans risque', desc: 'Identifiez aluminium brut, anodisé, revêtu et acier aluminisé, vérifiez la chimie et validez un procédé traçable sans abîmer les plaques.', date: '2026-08-26' },
  { slug: 'bakery-tray-washer-sample-wash-test', title: "Comment tester un lave-plaques avant l'achat : protocole d'acceptation sur échantillons", desc: "Essai contrôlé avec vos plaques, critères observables, preuves à exiger et signaux d'alerte.", date: '2026-08-19' },
  {
    slug: 'bakery-tray-washer-capacity-calculator',
    title: 'Combien de plaques un lave-plaques de boulangerie peut-il traiter ? Calculateur de capacité réelle',
    desc: 'Convertissez le volume journalier en cycles, minutes machine et fenêtre de lavage avec la capacité vérifiée de 6 plaques standard par cycle de 2 minutes. Pourquoi 180 plaques/heure reste un plafond technique.',
    date: '2026-08-19',
  },
  {
    slug: 'commercial-dishwasher-running-cost',
    title: "Combien coûte vraiment l'exploitation d'un lave-vaisselle professionnel de boulangerie ? Par cycle, par jour, par an",
    desc: "Les acheteurs s'obsèdent du prix d'achat et oublient le coût d'exploitation. Quatre coûts — eau, électricité, détergent, détartrage — et un seul est important. La méthode honnête fondée sur la physique pour estimer chacun à vos tarifs, un exemple pour un café de 150 plaques, et les cinq leviers qui réduisent la facture.",
    date: '2026-06-24',
  },
  {
    slug: '600x400-tray-washer-for-small-bakeries',
    title: "Trop grand pour un lave-vaisselle, trop petit pour un tunnel : le problème de la plaque 600×400",
    desc: "Les plaques 600×400 mm n'entrent pas dans le panier 500×500 d'un lave-vaisselle standard, mais un laveur à tunnel exige 3–6 m de sol que vous n'avez pas. Le JD-3 est conçu pour ce créneau : emprise de 0,65 m² qui tient là où va une table de préparation, panier 650×550 pour six plaques par cycle, plus doubles bras de lavage et rinçage ≥82°C pour vraiment laver le résidu cuit.",
    date: '2026-06-18',
  },
  {
    slug: 'commercial-dishwasher-maintenance-schedule',
    title: "Le calendrier d'entretien du lave-vaisselle professionnel de boulangerie : tâches quotidiennes, hebdomadaires et mensuelles pour une machine de 10 ans",
    desc: "Un lave-vaisselle professionnel de boulangerie devrait durer 8 à 12 ans — mais seulement avec entretien. Le pire ennemi est le tartre sur la résistance, entièrement évitable. Le calendrier quotidien/hebdomadaire/mensuel/trimestriel, la routine de cinq minutes en fin de service qui fait 80 % du travail, et comment la dureté de l'eau fixe votre intervalle de détartrage.",
    date: '2026-06-13',
  },
  {
    slug: 'commercial-dishwasher-faults-electrician-diagnose-circuit-diagram',
    title: "Sept pannes de lave-vaisselle professionnel qu'un électricien local peut diagnostiquer avec le schéma intégré",
    desc: "Les interventions de spécialistes coûtent 250 à 800 US$ avant qu'un composant ne soit touché. Pour les sept pannes qui causent 80 % des appels — pas d'alimentation, pas de chauffe, pas de jet, disjoncteur saute, pompe de vidange en continu, verrouillage capot, alarme rinçage — un électricien industriel agréé, schéma plastifié en main, isole la cause en 30 à 90 minutes. Parcourt chacune avec les désignations de composants, tensions attendues et valeurs de résistance.",
    date: '2026-06-10',
  },
  {
    slug: 'pre-installation-checklist-commercial-dishwasher',
    title: "La checklist de pré-installation que la plupart des boulangeries oublient",
    desc: "8 points de préparation de site — électricité (32 A courbe C + différentiel), eau, évacuation, ventilation, sol, dégagement, décision eau chaude, circuit isolé — avec les chiffres exacts dont votre électricien et plombier ont besoin avant le jour J.",
    date: '2026-06-08',
  },
  {
    slug: 'chemistry-of-washing-bakery-trays',
    title: "La chimie cachée du lavage des plaques de boulangerie",
    desc: "Une plaque de boulangerie n'est pas une assiette. Quatre types de résidus — sucre caramélisé, graisse polymérisée, dorure d'œuf, pâte fermentée — suivent chacun une chimie différente. Le protocole terrain d'un fabricant.",
    date: '2026-06-05',
  },
  {
    slug: 'five-failure-modes-commercial-dishwasher',
    title: "Cinq façons dont meurt un lave-vaisselle pro",
    desc: "Roulements de pompe, tartre, humidité sur la carte, joint, turbine de vidange — et ce qu'il faut demander avant d'acheter.",
    date: '2026-05-15',
  },
  {
    slug: 'ddpp-haccp-lavage-plaques-boulangerie-france',
    title: 'DDPP, HACCP et lavage des plaques',
    desc: 'Méthode HACCP, méthode des 5M, ce que la DDPP exige vraiment lors des inspections de boulangerie.',
    date: '2026-04-15',
  },
  {
    slug: 'norme-en-631-plaque-600x400-expliquee',
    title: 'Norme EN 631 / 600×400 expliquée',
    desc: 'Origine du standard européen et compatibilité avec les fours Rational, Convotherm, Unox, MIWE.',
    date: '2026-01-28',
  },
  {
    slug: 'cout-reel-lave-vaisselle-boulangerie-france',
    title: 'Coût réel d\'importation DDP',
    desc: 'FOB Shenzhen, fret maritime, TVA française 20%, droits — chiffres 2026 pour France, Belgique, Suisse.',
    date: '2026-02-11',
  },
  {
    slug: 'economies-eau-energie-lave-plaques',
    title: 'Économies d\'eau et d\'énergie',
    desc: '2 L/cycle vs lavage manuel — calcul concret sur le retour sur investissement à 4 mois.',
    date: '2026-02-25',
  },
];
---
<BaseLayout title={`${t(locale,'nav.blog')} | JD-3`} description="Articles sur les opérations de boulangerie et déploiements JD-3." locale={locale} canonicalPath="/blog/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/fr/'},{label: t(locale,'nav.blog')}]} />
<section class="section"><div class="container-page">
<h1 class="text-center mb-10">Blog</h1>
<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
{posts.map((p) => (
  <a href={`/fr/blog/${p.slug}/`} class="card hover:scale-[1.02] transition">
    <p class="text-xs text-bakery-navy/50 mb-2">{p.date}</p>
    <h3 class="mb-3">{p.title}</h3>
    <p class="text-sm text-bakery-navy/70">{p.desc}</p>
  </a>
))}
</div>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
