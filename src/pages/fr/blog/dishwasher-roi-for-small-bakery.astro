import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'fr' as const;
---
<BaseLayout title="ROI du lave-vaisselle pour boulangerie (version anglaise) | JD-3" description="ROI du lave-vaisselle pour boulangerie" locale={locale} canonicalPath="/blog/dishwasher-roi-for-small-bakery/" schemaType="Article">
