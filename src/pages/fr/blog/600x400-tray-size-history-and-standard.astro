---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'fr' as const;
---
<BaseLayout title="Histoire et standard de la taille 600×400 (version anglaise) | JD-3" description="Histoire et standard de la taille 600×400" locale={locale} canonicalPath="/blog/600x400-tray-size-history-and-standard/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/fr/'},{label: t(locale,'nav.blog'), href:'/fr/blog/'},{label: 'Histoire et standard de la taille 600×400'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Histoire et standard de la taille 600×400</h1>
<p class="text-lg mb-6 text-bakery-navy/70">Cet article n'est pas encore traduit en français. Lisez la version complète en anglais :</p>
<p><a href="/blog/600x400-tray-size-history-and-standard/" class="btn-primary inline-block">Histoire et standard de la taille 600×400 (EN) →</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
