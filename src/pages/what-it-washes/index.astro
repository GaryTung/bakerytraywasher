---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CTASection from '../../components/CTASection.astro';

const locale = 'en' as const;

const items = [
  { slug: 'baking-trays-600x400', name: '600×400 mm Bakery Norm Trays', desc: 'The flagship use case — European Bakery Norm trays Hobart can\'t fit.', flagship: true },
  { slug: 'sheet-pans', name: 'American Sheet Pans', desc: '18×26" half-sheet and full-sheet pans fit diagonally.' },
  { slug: 'mixing-bowls', name: 'Mixing Bowls', desc: 'KitchenAid 5–20 quart bowls upright with the tall-item insert.' },
  { slug: 'cake-pans', name: 'Cake Pans', desc: 'Round, square, fluted, and springform cake pans.' },
  { slug: 'pizza-pans', name: 'Pizza Pans', desc: 'Up to 16" round and square pans, perforated and solid.' },
  { slug: 'frying-baskets', name: 'Frying Baskets', desc: 'Standard fry baskets and small-batch deep-fryer inserts.' },
  { slug: 'stockpots', name: 'Stockpots & Large Pots', desc: 'Up to 28 cm tall, 30 cm diameter pots.' },
  { slug: 'dishes-plates', name: 'Dishes & Plates', desc: 'Standard restaurant dishware, ceramic, bone china.' },
  { slug: 'utensils-mixers', name: 'Utensils & Mixer Accessories', desc: 'Whisks, paddles, dough hooks, spatulas, ladles.' },
  { slug: 'large-bakeware', name: 'Large Bakeware', desc: 'Bread molds, Pullman loaf pans, charlotte molds.' },
];
---
<BaseLayout
  title="What the JD-3 Washes | Bakery Tray Washer Compatibility"
  description="From 600×400 bakery trays to stockpots and pizza pans — see every type of cookware the JD-3 bakery tray washer cleans, and how."
  locale={locale}
  canonicalPath="/what-it-washes/"
  schemaType="Article"
>
<BreadcrumbNav items={[{label: 'Home', href: '/'}, {label: 'What It Washes'}]} />

<section class="section">
  <div class="container-page">
    <h1 class="mb-4 text-center">What the JD-3 Washes</h1>
    <p class="text-bakery-navy/70 text-lg max-w-2xl mx-auto text-center mb-10">
      The JD-3 is engineered for the broad range of bakeware and dishware that small commercial kitchens deal with. Pick an item to see specifics.
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {items.map((it) => (
        <a href={`/what-it-washes/${it.slug}/`} class={`card hover:scale-[1.02] transition ${it.flagship ? 'border-2 border-bakery-orange' : ''}`}>
          {it.flagship && <span class="eyebrow text-bakery-orange">⭐ Flagship</span>}
          <h3 class="text-lg mb-2 mt-1">{it.name}</h3>
          <p class="text-sm text-bakery-navy/70">{it.desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<CTASection locale={locale} />
</BaseLayout>
