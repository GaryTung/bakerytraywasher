---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CTASection from '../../components/CTASection.astro';
const locale = 'en' as const;

const rows = [
  { country: 'United States', sea: '$450', air: '$1,400', duty: '0–3%' },
  { country: 'United Kingdom', sea: '$500', air: '$1,500', duty: '5–8%' },
  { country: 'Germany', sea: '$480', air: '$1,450', duty: '5–8% + 19% VAT' },
  { country: 'France', sea: '$480', air: '$1,450', duty: '5–8% + 20% VAT' },
  { country: 'Australia', sea: '$420', air: '$1,300', duty: '5% + 10% GST' },
  { country: 'United Arab Emirates', sea: '$380', air: '$1,200', duty: '5% + 5% VAT' },
  { country: 'Saudi Arabia', sea: '$400', air: '$1,250', duty: '5% + 15% VAT' },
  { country: 'Thailand', sea: '$300', air: '$900', duty: '5%' },
  { country: 'Vietnam', sea: '$280', air: '$900', duty: '5–10%' },
  { country: 'Singapore', sea: '$320', air: '$950', duty: '0% + 9% GST' },
  { country: 'Indonesia', sea: '$350', air: '$1,000', duty: '10%' },
  { country: 'Mexico', sea: '$550', air: '$1,500', duty: '5%' },
  { country: 'Brazil', sea: '$650', air: '$1,800', duty: '14% + ~25% ICMS' },
  { country: 'Russia', sea: '$550', air: '$1,500', duty: '5–10%' },
  { country: 'South Africa', sea: '$500', air: '$1,400', duty: '5–15% + 15% VAT' },
];
---
<BaseLayout
  title="Shipping & Import Cost by Country — JD-3 Bakery Tray Washer"
  description="Estimated shipping costs (sea and air freight) plus import duties for the JD-3 to 15+ countries. Plan your total landed cost."
  locale={locale}
  canonicalPath="/pricing/shipping-and-import-cost-by-country/"
  schemaType="Article"
>
<BreadcrumbNav items={[{label: 'Home', href: '/'}, {label: 'Pricing', href: '/pricing/'}, {label: 'Shipping by Country'}]} />

<section class="section">
  <div class="container-page">
    <h1 class="mb-4">Shipping &amp; Import Costs by Country</h1>
    <p class="text-bakery-navy/70 text-lg max-w-3xl mb-8">
      Estimated freight and duty costs for shipping a single JD-3 unit to common destinations. These are rough guides — exact pricing depends on your nearest port, your local customs broker, and current freight rates. Request a quote for an exact landed cost.
    </p>
    <div class="overflow-x-auto card !p-0">
      <table class="w-full text-sm">
        <thead class="bg-bakery-navy text-white">
          <tr>
            <th class="text-left p-3">Country</th>
            <th class="text-left p-3">Sea freight (estimate)</th>
            <th class="text-left p-3">Air freight (estimate)</th>
            <th class="text-left p-3">Import duty + VAT/GST</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-t border-bakery-navy/5">
              <td class="p-3 font-medium">{r.country}</td>
              <td class="p-3">{r.sea}</td>
              <td class="p-3">{r.air}</td>
              <td class="p-3">{r.duty}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-xs text-bakery-navy/60 mt-4">
      Sea freight rates assume LCL (less-than-container-load) shipping. For full-container (FCL) orders of 3+ units, sea freight per unit drops 40–60%. Air freight rates are for the JD-3's ~170 kg shipping weight. Duty rates are indicative — your local customs broker provides the exact figure based on HS code 8422.11.
    </p>
  </div>
</section>

<section class="section bg-bakery-cream">
  <div class="container-page max-w-2xl mx-auto">
    <h2 class="mb-3">Documentation We Provide</h2>
    <ul class="space-y-2 text-bakery-navy/80">
      <li class="flex gap-2"><span class="text-bakery-orange">✓</span> Commercial invoice</li>
      <li class="flex gap-2"><span class="text-bakery-orange">✓</span> Packing list</li>
      <li class="flex gap-2"><span class="text-bakery-orange">✓</span> Bill of lading (sea) or air waybill (air)</li>
      <li class="flex gap-2"><span class="text-bakery-orange">✓</span> Certificate of origin</li>
      <li class="flex gap-2"><span class="text-bakery-orange">✓</span> CE certificate</li>
      <li class="flex gap-2"><span class="text-bakery-orange">✓</span> ISO 9001 production attestation</li>
      <li class="flex gap-2"><span class="text-bakery-orange">✓</span> HS code declaration (8422.11)</li>
    </ul>
    <h3 class="mt-8 mb-3">What Your Customs Broker Needs</h3>
    <p class="text-bakery-navy/80">Your local customs broker handles the import process. They need the documents above plus your business import licence (if your country requires one). Typical clearance time: 2–5 business days after port arrival.</p>
  </div>
</section>

<CTASection locale={locale} title="Need an exact landed-cost quote?" subtitle="Tell us your destination port and we'll provide all-in pricing within 12 hours." />
</BaseLayout>
