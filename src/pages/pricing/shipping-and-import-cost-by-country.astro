---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CTASection from '../../components/CTASection.astro';
import { countries } from '../../data/countries';

const locale = 'en' as const;
---
<BaseLayout
  title="Shipping & Import Cost by Country — JD-3 Bakery Tray Washer"
  description="Authoritative DDP landed pricing for the V-TAI JD-3 across 18 countries. Local currency, all-in (freight + duty + VAT + last-mile)."
  locale={locale}
  canonicalPath="/pricing/shipping-and-import-cost-by-country/"
  schemaType="Article"
>
<BreadcrumbNav items={[{label: 'Home', href: '/'}, {label: 'Pricing', href: '/pricing/'}, {label: 'Shipping by Country'}]} />

<section class="section">
  <div class="container-page">
    <h1 class="mb-4">Shipping &amp; Landed Cost by Country</h1>
    <p class="text-bakery-navy/70 text-lg max-w-3xl mb-6">
      We publish firm <strong>DDP (Delivered Duty Paid) landed prices</strong> in local currency for 18 markets — meaning the price you see is what you actually pay to receive the machine at your address, including ocean freight, customs clearance, import duty, local VAT/GST (where applicable), and last-mile delivery.
    </p>
    <a href="/pricing/by-country/" class="btn-primary mb-8 inline-block">See the Full Country-by-Country Hub →</a>

    <div class="overflow-x-auto card !p-0 mt-6">
      <table class="w-full text-sm">
        <thead class="bg-bakery-navy text-white">
          <tr>
            <th class="text-left p-3">Country</th>
            <th class="text-left p-3">Reference City</th>
            <th class="text-left p-3">DDP Price (local)</th>
            <th class="text-left p-3 hidden md:table-cell">~USD</th>
            <th class="text-left p-3 hidden md:table-cell">Lead time</th>
            <th class="text-left p-3"></th>
          </tr>
        </thead>
        <tbody>
          {countries.map((c) => (
            <tr class="border-t border-bakery-navy/5">
              <td class="p-3 font-medium">{c.name}</td>
              <td class="p-3">{c.city}</td>
              <td class="p-3 text-bakery-orange font-semibold">{c.priceLocal}</td>
              <td class="p-3 hidden md:table-cell">${c.usdApprox.toLocaleString('en-US')}</td>
              <td class="p-3 hidden md:table-cell">{c.leadTimeWeeks} wk</td>
              <td class="p-3"><a href={`/pricing/by-country/${c.slug}/`} class="text-bakery-orange hover:underline">Detail →</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-xs text-bakery-navy/60 mt-4">
      Local-currency price is authoritative; USD equivalent shown for reference (subject to FX fluctuation). DDP includes freight + customs clearance + import duty + local VAT/GST where indicated. Excludes local installation labor.
    </p>
  </div>
</section>

<section class="section bg-bakery-cream">
  <div class="container-page max-w-2xl mx-auto">
    <h2 class="mb-3">Documentation We Provide</h2>
    <ul class="space-y-2 text-bakery-navy/80">
      <li class="flex gap-2"><span class="text-bakery-orange">✓</span> Commercial invoice</li>
      <li class="flex gap-2"><span class="text-bakery-orange">✓</span> Packing list</li>
      <li class="flex gap-2"><span class="text-bakery-orange">✓</span> Bill of lading (sea) or air waybill (air)</li>
      <li class="flex gap-2"><span class="text-bakery-orange">✓</span> Certificate of origin</li>
      <li class="flex gap-2"><span class="text-bakery-orange">✓</span> CE certificate</li>
      <li class="flex gap-2"><span class="text-bakery-orange">✓</span> ISO 9001 production attestation</li>
      <li class="flex gap-2"><span class="text-bakery-orange">✓</span> HS code declaration (8422.11)</li>
    </ul>
    <h3 class="mt-8 mb-3">For Countries Not Listed</h3>
    <p class="text-bakery-navy/80">We ship globally. If your country isn't in the 18-market DDP hub above, request a custom DDP quote — we typically respond within 12 business hours with an all-in figure to your specific city.</p>
  </div>
</section>

<CTASection locale={locale} title="Need a DDP quote for your country?" subtitle="Tell us your destination city and we'll provide all-in pricing within 12 hours." />
</BaseLayout>
