---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { countries, getCountriesByRegion } from '../../../data/countries';
import { t } from '../../../i18n/utils';

const locale = 'en' as const;
const grouped = getCountriesByRegion();
const regionOrder = ['North America', 'Latin America', 'Europe', 'GCC / Middle East', 'Asia-Pacific', 'Africa'];
const regionKeyMap: Record<string, string> = {
  'North America': 'country.region.northAmerica',
  'Latin America': 'country.region.latinAmerica',
  'Europe': 'country.region.europe',
  'GCC / Middle East': 'country.region.gcc',
  'Asia-Pacific': 'country.region.asiaPacific',
  'Africa': 'country.region.africa',
};
---
<BaseLayout
  title="JD-3 Landed Price by Country — DDP to Your Door | bakerytraywasher.com"
  description="Transparent DDP landed pricing for the V-TAI JD-3 bakery tray washer across 18 countries. Local currency, all-in. No freight forwarding, no customs broker. Order to door in 6–14 weeks."
  locale={locale}
  canonicalPath="/pricing/by-country/"
  schemaType="Product"
>
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/' },
  { label: t(locale, 'nav.pricing'), href: '/pricing/' },
  { label: t(locale, 'nav.ddpByCountry') }
]} />

<section class="section">
  <div class="container-page">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <p class="eyebrow mb-2">DDP landed pricing · 18 countries</p>
      <h1 class="mb-4">{t(locale, 'country.title')}</h1>
      <p class="text-bakery-navy/70 text-lg">
        For these 18 markets we quote a single all-in price including ocean freight, customs clearance, import duty, local VAT/GST (where included), and last-mile delivery. No surprise invoices.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      <div class="card text-center"><p class="text-3xl font-bold text-bakery-orange">18</p><p class="text-sm text-bakery-navy/70 mt-1">countries with firm DDP quotes</p></div>
      <div class="card text-center"><p class="text-3xl font-bold text-bakery-orange">$4,400</p><p class="text-sm text-bakery-navy/70 mt-1">FOB Shenzhen base price</p></div>
      <div class="card text-center"><p class="text-3xl font-bold text-bakery-orange">6–14</p><p class="text-sm text-bakery-navy/70 mt-1">weeks order → your door</p></div>
      <div class="card text-center"><p class="text-3xl font-bold text-bakery-orange">0</p><p class="text-sm text-bakery-navy/70 mt-1">surprise charges at the port</p></div>
    </div>

    {regionOrder.map((region) => grouped[region] && (
      <div class="mb-10">
        <h2 class="mb-4 text-bakery-navy">{t(locale, regionKeyMap[region])}</h2>
        <div class="overflow-x-auto card !p-0">
          <table class="w-full text-sm">
            <thead class="bg-bakery-navy text-white">
              <tr>
                <th class="text-left p-3">{t(locale, 'country.tableCountry')}</th>
                <th class="text-left p-3">{t(locale, 'country.tableCity')}</th>
                <th class="text-left p-3">{t(locale, 'country.tablePrice')}</th>
                <th class="text-left p-3 hidden md:table-cell">{t(locale, 'country.tableUsd')}</th>
                <th class="text-left p-3 hidden md:table-cell">{t(locale, 'country.tableLeadTime')}</th>
                <th class="text-left p-3"></th>
              </tr>
            </thead>
            <tbody>
              {grouped[region].map((c) => (
                <tr class="border-t border-bakery-navy/5 hover:bg-bakery-cream/50">
                  <td class="p-3 font-semibold text-bakery-navy">{c.name}</td>
                  <td class="p-3 text-bakery-navy/70">{c.city}</td>
                  <td class="p-3 text-bakery-orange font-semibold">{c.priceLocal}</td>
                  <td class="p-3 text-bakery-navy/70 hidden md:table-cell">${c.usdApprox.toLocaleString('en-US')}</td>
                  <td class="p-3 text-bakery-navy/70 hidden md:table-cell">{c.leadTimeWeeks} {t(locale, 'country.weekShort')}</td>
                  <td class="p-3 text-right"><a href={`/pricing/by-country/${c.slug}/`} class="text-bakery-orange font-semibold hover:underline">{t(locale, 'country.details')} →</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}
  </div>
</section>

<CTASection locale={locale} />
</BaseLayout>
