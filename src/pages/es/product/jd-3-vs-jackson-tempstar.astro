---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'es' as const;
const rows = [
  { label: 'Tamaño rack', jd3: '650×550 mm', competitor: '500×500 mm' },
  { label: 'Bandejas 600×400', jd3: '✓ Sí', competitor: '✗ No', highlight: true },
  { label: 'Precio', jd3: '$4.400 FOB', competitor: 'Significativamente más alto' },
];
---
<BaseLayout title="JD-3 vs Jackson TempStar | Comparación" description="Comparación JD-3 vs Jackson TempStar HH-E." locale={locale} canonicalPath="/product/jd-3-vs-jackson-tempstar/" schemaType="Article">
<BreadcrumbNav items={[{label:'Inicio',href:'/es/'},{label:'Producto',href:'/es/product/'},{label:'vs Jackson'}]} />
<section class="section"><div class="container-prose"><h1>JD-3 vs Jackson TempStar HH-E</h1><p class="text-lg mt-4 mb-6">Jackson es la opción media estadounidense. JD-3 ofrece 35% menos costo, mayor cámara, y compatibilidad con bandejas 600×400 mm.</p></div>
<div class="container-page"><ComparisonTable competitorName="Jackson TempStar" rows={rows} /></div></section>
<CTASection locale={locale} />
</BaseLayout>
