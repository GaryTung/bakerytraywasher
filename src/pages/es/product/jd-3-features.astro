---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'es' as const;
---
<BaseLayout title="Características JD-3 | Lavadora V-TAI Bandejas Panadería" description="Análisis detallado de las 12 características clave de la lavadora V-TAI JD-3." locale={locale} canonicalPath="/product/jd-3-features/" schemaType="Article">
<BreadcrumbNav items={[{label:'Inicio',href:'/es/'},{label:'Producto',href:'/es/product/'},{label:'Características'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Las 12 Características Clave de la JD-3</h1>
<ol class="space-y-6 list-decimal list-inside">
<li><strong>Construcción SUS304</strong> — acero inoxidable grado alimentario en toda la máquina, resistente al óxido y a químicos comerciales.</li>
<li><strong>Cámara Extra Grande</strong> — rack de 650×550 mm acepta bandejas europeas 600×400 mm, ollas, tazones KitchenAid.</li>
<li><strong>Brazos Rotativos Duales</strong> — cobertura 360° con motor de alta presión.</li>
<li><strong>Boquillas Anti-Obstrucción</strong> — flujo consistente incluso con agua con sedimentos.</li>
<li><strong>Control de Temperatura Inteligente</strong> — esterilización automática &gt;82°C, display LED digital.</li>
<li><strong>Bajo Consumo de Agua</strong> — 2,0–2,5 L por ciclo vs típico 5–10 L.</li>
<li><strong>Sistema de Recuperación de Calor</strong> — pre-calienta agua entrante, ahorra energía.</li>
<li><strong>Puerta Sellada Aislada</strong> — reduce escape de vapor en 70%.</li>
<li><strong>Operación Ergonómica</strong> — panel a altura de ojos, rieles push-pull.</li>
<li><strong>Inicio Activado por Puerta</strong> — el ciclo comienza al cerrar la campana.</li>
<li><strong>Múltiples Protecciones de Seguridad</strong> — corte de energía al abrir, protección de sobrecarga.</li>
<li><strong>Expandibilidad Funcional</strong> — interfaces pre-instaladas para módulos de detergente y tratamiento de agua.</li>
</ol>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
