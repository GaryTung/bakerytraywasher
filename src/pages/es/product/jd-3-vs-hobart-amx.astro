---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'es' as const;
const rows = [
  { label: 'Capacidad', jd3: '180 trays/h', competitor: '180 trays/h' },
  { label: 'Tamaño rack', jd3: '650×550 mm', competitor: '500×500 mm' },
  { label: 'Bandejas 600×400', jd3: '✓ Sí', competitor: '✗ No', highlight: true },
  { label: 'Agua/ciclo', jd3: '2,5 L', competitor: '3,8 L' },
  { label: 'Potencia', jd3: '13 kW', competitor: '19 kW' },
  { label: 'Precio', jd3: '$4.400–$4.900 FOB', competitor: 'Significativamente más alto' },
];
---
<BaseLayout title="JD-3 vs Hobart AMX | Comparación de Lavavajillas" description="Comparación honesta lado a lado de la V-TAI JD-3 y Hobart AMX." locale={locale} canonicalPath="/product/jd-3-vs-hobart-amx/" schemaType="Article">
<BreadcrumbNav items={[{label:'Inicio',href:'/es/'},{label:'Producto',href:'/es/product/'},{label:'vs Hobart AMX'}]} />
<section class="section"><div class="container-prose"><h1 class="mb-4">JD-3 vs Hobart AMX</h1><p class="text-lg mb-6">Hobart es el líder estadounidense. JD-3 ofrece costo significativamente menor y acepta bandejas de 600×400 mm que Hobart no acepta.</p></div>
<div class="container-page"><ComparisonTable competitorName="Hobart AMX" rows={rows} /></div></section>
<CTASection locale={locale} />
</BaseLayout>
