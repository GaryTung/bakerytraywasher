---
import BusinessTypeLayout from '../../../layouts/BusinessTypeLayout.astro';
const locale = 'es' as const;
---
<BusinessTypeLayout
  locale={locale}
  canonicalPath="/by-business-type/hotel-pastry-kitchen/"
  slug="hotel-pastry-kitchen"
  businessName="Cocina de Pastelería de Hotel"
  icon="🏨"
  title="Lavadora para Cocina de Hotel — Buffet Desayuno a Banquete"
  description="La JD-3 maneja su día completo: 80–120 bandejas de viennoiserie matinal, asado de banquete por la tarde."
  reality="Pastelería de hotel. Día desde 4:30 AM hasta medianoche con banquete. 80–120 bandejas de buffet + 30–40 sheet pans + banquete."
  needs="Alta capacidad en olas múltiples, versatilidad (oily/delicate/banquete), control térmico confiable, huella pequeña."
  fit="JD-3 clarifica buffet en 60 minutos. Modos configurables. Compatibilidad 600×400 crítica para hornos Convotherm/Rational."
  roi="Hotel 200 habitaciones: ahorro ~$21.600/año. Retorno: 1,5–2 meses."
  faqs={[
    { q: '¿Funcionamiento continuo durante el desayuno?', a: 'Sí, diseñada para servicio continuo.' },
    { q: '¿Estandarización entre propiedades?', a: 'Sí — trabajamos con cadenas hoteleras internacionales.' },
  ]}
/>
