---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';
import { t } from '../../i18n/utils';
const locale = 'es' as const;
const faqs = [
  { q: '¿Qué es V-TAI JD-3?', a: 'Lavavajillas comercial tipo campana para bandejas de panadería. Modelo VT-AE-JD-3.' },
  { q: '¿Precio?', a: 'Desde $4,400 FOB Shenzhen. Hasta $4,900 con mejoras opcionales (dosificador automático de detergente, recuperación de calor).' },
  { q: '¿Diferencia con otras marcas?', a: 'El rack de 650×550 mm acepta bandejas Euro Bakery Norm de 600×400 mm — el estándar usado por Rational, Convotherm, Unox. Costo significativamente menor que marcas premium con el mismo nivel de certificación CE.' },
  { q: '¿Tiempo de entrega?', a: '4 semanas de producción en Shenzhen, más flete marítimo (20–35 días según destino) o aéreo (3–7 días, más caro).' },
  { q: '¿Garantía?', a: 'Garantía del fabricante de 12 meses en partes. Repuestos enviados globalmente en 5 días hábiles.' },
  { q: '¿Qué pasa si se daña?', a: 'Cada máquina viene con el diagrama de circuito dentro del panel de servicio. Un electricista general puede reparar la mayoría de los problemas. Repuestos enviados globalmente en 5 días.' },
  { q: '¿Instalación?', a: 'Recibe la máquina, sigue el videotutorial, conecta agua + electricidad. 1–2 horas típicamente. Sin técnico especializado requerido.' },
  { q: '¿Envío a mi país?', a: 'Sí. Vea la página de precios DDP para 17 mercados con precio en moneda local. Si su país no está en la lista, solicite cotización personalizada — respondemos en 12 horas.' },
];
---
<BaseLayout title={`${t(locale,'nav.faq')} | JD-3`} description="Preguntas frecuentes sobre V-TAI JD-3." locale={locale} canonicalPath="/faq/">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/es/'},{label: t(locale,'nav.faq')}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4 text-center">Preguntas Frecuentes</h1>
</div></section>
<FAQSection items={faqs} title="" locale={locale} />
<CTASection locale={locale} />
</BaseLayout>
