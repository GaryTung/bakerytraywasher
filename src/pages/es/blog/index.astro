---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'es' as const;
const posts = [
  {
    slug: 'bakery-tray-washer-capacity-calculator',
    title: '¿Cuántas bandejas puede lavar una lavadora de panadería? Calculadora de capacidad real',
    desc: 'Convierta el volumen diario en ciclos, minutos de máquina y ventana de limpieza con la capacidad verificada de 6 bandejas estándar por ciclo de 2 minutos. Explica por qué 180 bandejas/hora es un techo técnico, no una promesa de turno.',
    date: '2026-08-19',
  },
  {
    slug: 'commercial-dishwasher-running-cost',
    title: "¿Cuánto cuesta realmente operar un lavavajillas comercial de panadería? Por ciclo, por día y por año",
    desc: "Los compradores se obsesionan con el precio y olvidan el costo de operación. Cuatro costos — agua, electricidad, detergente, descalcificación — y solo uno es grande. El método honesto basado en física para estimar cada uno con sus tarifas, un ejemplo para un café de 150 bandejas, y las cinco palancas que reducen la factura.",
    date: '2026-06-24',
  },
  {
    slug: '600x400-tray-washer-for-small-bakeries',
    title: "Demasiado grande para un lavavajillas, demasiado pequeña para un túnel: el problema de la bandeja 600×400",
    desc: "Las bandejas de 600×400 mm no caben en el rack de 500×500 de un lavavajillas estándar, pero un lavador de túnel necesita 3–6 m de piso que no tiene. La JD-3 está hecha para ese hueco: huella de 0,65 m² que cabe donde va una mesa de preparación, rack de 650×550 para seis bandejas por ciclo, más doble brazo de lavado y enjuague ≥82°C para limpiar de verdad el residuo horneado.",
    date: '2026-06-18',
  },
  {
    slug: 'commercial-dishwasher-maintenance-schedule',
    title: "El calendario de mantenimiento del lavavajillas comercial de panadería: tareas diarias, semanales y mensuales para una máquina de 10 años",
    desc: "Un lavavajillas comercial de panadería debería durar 8–12 años — pero solo con mantenimiento. El mayor asesino es la cal en la resistencia, y es totalmente evitable. El calendario diario/semanal/mensual/trimestral, la rutina de cinco minutos al cierre que hace el 80% del trabajo, y cómo la dureza del agua fija su intervalo de descalcificación.",
    date: '2026-06-13',
  },
  {
    slug: 'commercial-dishwasher-faults-electrician-diagnose-circuit-diagram',
    title: "Siete fallas de lavavajillas comercial que un electricista local puede diagnosticar con el esquema eléctrico incorporado",
    desc: "Las visitas de técnicos especializados cuestan entre US$250 y US$800 antes de tocar un componente. Para las siete fallas que generan el 80% de las averías — sin energía, sin calor, sin chorro, breaker se dispara, drenaje continuo, traba de puerta, alarma de enjuague — un electricista industrial con licencia y el esquema laminado dentro del panel aísla la causa en 30–90 minutos. Recorre cada una con las designaciones de componentes, voltajes esperados y valores de resistencia.",
    date: '2026-06-10',
  },
  {
    slug: 'pre-installation-checklist-commercial-dishwasher',
    title: "La lista de pre-instalación que la mayoría de panaderías omite",
    desc: "8 puntos de preparación de sitio — eléctrico (32 A tipo C + diferencial), agua, drenaje, ventilación, piso, espacio, decisión de agua caliente, circuito aislado — con los números exactos que su electricista y plomero necesitan antes del día de entrega.",
    date: '2026-06-08',
  },
  {
    slug: 'chemistry-of-washing-bakery-trays',
    title: "La química escondida detrás de lavar una bandeja de panadería",
    desc: "Una bandeja de panadería no es un plato. Cuatro tipos distintos de residuo — azúcar caramelizado, grasa polimerizada, glaseado de huevo horneado, masa fermentada — siguen químicas diferentes. Un protocolo de campo del fabricante.",
    date: '2026-06-05',
  },
  {
    slug: 'five-failure-modes-commercial-dishwasher',
    title: "Cinco formas en que muere una lavavajillas comercial",
    desc: "Rodamientos de bomba, sarro en resistencia, humedad en placa, junta, impulsor de drenaje — y qué preguntar antes de comprar.",
    date: '2026-05-15',
  },
  {
    slug: 'cofepris-lavavajillas-panaderia-mexico',
    title: 'Cofepris y lavavajillas: guía para México',
    desc: 'NOM-251-SSA1-2009, Aviso de Funcionamiento Cofepris, e importación DDP a CDMX/GDL/MTY desde Shenzhen.',
    date: '2026-04-15',
  },
  {
    slug: 'norma-europea-600x400-bandejas-explicada',
    title: 'Norma europea 600×400 mm explicada',
    desc: 'Qué es DIN 18876 / EN 631 y por qué importa para panaderías hispanohablantes.',
    date: '2026-01-28',
  },
  {
    slug: 'costo-real-lavavajillas-comercial-panaderia',
    title: 'Costo real de importación DDP',
    desc: 'FOB Shenzhen, flete marítimo, aranceles y IVA — números 2026 para México, España, Colombia, Argentina y Chile.',
    date: '2026-02-11',
  },
  {
    slug: 'roi-lavavajillas-panaderia-4-meses',
    title: 'ROI: payback en 4 meses',
    desc: 'Cálculo concreto del retorno de inversión para panaderías hispanohablantes pequeñas y medianas.',
    date: '2026-02-25',
  },
];
---
<BaseLayout title={`${t(locale,'nav.blog')} | JD-3`} description="Artículos sobre operaciones de panadería y despliegues de JD-3." locale={locale} canonicalPath="/blog/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/es/'},{label: t(locale,'nav.blog')}]} />
<section class="section"><div class="container-page">
<h1 class="text-center mb-10">Blog</h1>
<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
{posts.map((p) => (
  <a href={`/es/blog/${p.slug}/`} class="card hover:scale-[1.02] transition">
    <p class="text-xs text-bakery-navy/50 mb-2">{p.date}</p>
    <h3 class="mb-3">{p.title}</h3>
    <p class="text-sm text-bakery-navy/70">{p.desc}</p>
  </a>
))}
</div>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
