---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'es' as const;
const posts = [
  {
    slug: 'five-failure-modes-commercial-dishwasher',
    title: "Cinco formas en que muere una lavavajillas comercial",
    desc: "Rodamientos de bomba, sarro en resistencia, humedad en placa, junta, impulsor de drenaje — y qué preguntar antes de comprar.",
    date: '2026-05-15',
  },
  {
    slug: 'cofepris-lavavajillas-panaderia-mexico',
    title: 'Cofepris y lavavajillas: guía para México',
    desc: 'NOM-251-SSA1-2009, Aviso de Funcionamiento Cofepris, e importación DDP a CDMX/GDL/MTY desde Shenzhen.',
    date: '2026-04-15',
  },
  {
    slug: 'norma-europea-600x400-bandejas-explicada',
    title: 'Norma europea 600×400 mm explicada',
    desc: 'Qué es DIN 18876 / EN 631 y por qué importa para panaderías hispanohablantes.',
    date: '2026-01-28',
  },
  {
    slug: 'costo-real-lavavajillas-comercial-panaderia',
    title: 'Costo real de importación DDP',
    desc: 'FOB Shenzhen, flete marítimo, aranceles y IVA — números 2026 para México, España, Colombia, Argentina y Chile.',
    date: '2026-02-11',
  },
  {
    slug: 'roi-lavavajillas-panaderia-4-meses',
    title: 'ROI: payback en 4 meses',
    desc: 'Cálculo concreto del retorno de inversión para panaderías hispanohablantes pequeñas y medianas.',
    date: '2026-02-25',
  },
];
---
<BaseLayout title={`${t(locale,'nav.blog')} | JD-3`} description="Artículos sobre operaciones de panadería y despliegues de JD-3." locale={locale} canonicalPath="/blog/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/es/'},{label: t(locale,'nav.blog')}]} />
<section class="section"><div class="container-page">
<h1 class="text-center mb-10">Blog</h1>
<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
{posts.map((p) => (
  <a href={`/es/blog/${p.slug}/`} class="card hover:scale-[1.02] transition">
    <p class="text-xs text-bakery-navy/50 mb-2">{p.date}</p>
    <h3 class="mb-3">{p.title}</h3>
    <p class="text-sm text-bakery-navy/70">{p.desc}</p>
  </a>
))}
</div>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
