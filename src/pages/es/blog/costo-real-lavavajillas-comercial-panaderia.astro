<div class="card !p-0 overflow-hidden my-4">
  <table class="w-full text-sm">
    <tbody>
      <tr><td class="p-3 border-b">JD-3 estándar FOB Shenzhen</td><td class="p-3 border-b text-right">$4,400 USD</td></tr>
      <tr><td class="p-3 border-b">Flete marítimo → Manzanillo</td><td class="p-3 border-b text-right text-bakery-navy/70">incluido</td></tr>
      <tr><td class="p-3 border-b">Arancel mexicano 5%</td><td class="p-3 border-b text-right text-bakery-navy/70">incluido</td></tr>
      <tr><td class="p-3 border-b">IVA 16%</td><td class="p-3 border-b text-right text-bakery-navy/70">incluido</td></tr>
      <tr><td class="p-3 border-b">Trucking final a CDMX</td><td class="p-3 border-b text-right text-bakery-navy/70">incluido</td></tr>
      <tr class="bg-bakery-cream font-bold">
        <td class="p-3">Total DDP CDMX</td>
        <td class="p-3 text-right text-bakery-orange text-lg">MX$87,000 MXN</td>
      </tr>
