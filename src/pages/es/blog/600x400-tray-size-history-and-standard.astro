---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'es' as const;
---
<BaseLayout title="Historia y estándar del tamaño 600×400 (versión en inglés) | JD-3" description="Historia y estándar del tamaño 600×400" locale={locale} canonicalPath="/blog/600x400-tray-size-history-and-standard/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/es/'},{label: t(locale,'nav.blog'), href:'/es/blog/'},{label: 'Historia y estándar del tamaño 600×400'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Historia y estándar del tamaño 600×400</h1>
<p class="text-lg mb-6 text-bakery-navy/70">Este artículo aún no está traducido al español. Lea la versión completa en inglés:</p>
<p><a href="/blog/600x400-tray-size-history-and-standard/" class="btn-primary inline-block">Historia y estándar del tamaño 600×400 (EN) →</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
