---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'es' as const;
---
<BaseLayout title="Estándares de Temperatura de Sanitización | JD-3" description="Estándares de Temperatura de Sanitización" locale={locale} canonicalPath="/guides/sanitization-temperature-standards/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/es/' },
  { label: t(locale, 'nav.guides') },
  { label: "Estándares de Temperatura de Sanitización" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Estándares de Temperatura de Sanitización</h1>
<p class="text-lg mb-6">Guía práctica para operadores de panadería usando el V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/sanitization-temperature-standards/" class="underline">Ver versión inglesa completa</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
