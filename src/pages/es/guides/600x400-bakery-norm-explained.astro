---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'es' as const;
---
<BaseLayout title="La Norma de Panadería 600×400 mm Explicada | JD-3" description="La Norma de Panadería 600×400 mm Explicada" locale={locale} canonicalPath="/guides/600x400-bakery-norm-explained/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/es/' },
  { label: t(locale, 'nav.guides') },
  { label: "La Norma de Panadería 600×400 mm Explicada" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">La Norma de Panadería 600×400 mm Explicada</h1>
<p class="text-lg mb-6">Guía práctica para operadores de panadería usando el V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/600x400-bakery-norm-explained/" class="underline">Ver versión inglesa completa</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
