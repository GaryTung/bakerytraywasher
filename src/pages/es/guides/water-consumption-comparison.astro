---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'es' as const;
---
<BaseLayout title="Comparación de Consumo de Agua | JD-3" description="Comparación de Consumo de Agua" locale={locale} canonicalPath="/guides/water-consumption-comparison/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/es/' },
  { label: t(locale, 'nav.guides') },
  { label: "Comparación de Consumo de Agua" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Comparación de Consumo de Agua</h1>
<p class="text-lg mb-6">Guía práctica para operadores de panadería usando el V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/water-consumption-comparison/" class="underline">Ver versión inglesa completa</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
