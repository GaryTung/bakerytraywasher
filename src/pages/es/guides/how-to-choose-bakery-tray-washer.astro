---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'es' as const;
---
<BaseLayout title="Cómo Elegir una Lavadora de Bandejas | JD-3" description="Cómo Elegir una Lavadora de Bandejas" locale={locale} canonicalPath="/guides/how-to-choose-bakery-tray-washer/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/es/' },
  { label: t(locale, 'nav.guides') },
  { label: "Cómo Elegir una Lavadora de Bandejas" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Cómo Elegir una Lavadora de Bandejas</h1>
<p class="text-lg mb-6">Guía práctica para operadores de panadería usando el V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/how-to-choose-bakery-tray-washer/" class="underline">Ver versión inglesa completa</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
