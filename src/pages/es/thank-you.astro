---
import BaseLayout from '../../layouts/BaseLayout.astro';
const locale = 'es' as const;
---
<BaseLayout title="Gracias — Solicitud recibida" description="Su solicitud de cotización fue recibida. Respondemos en 12 horas." locale={locale} canonicalPath="/thank-you/" noindex={true}>
<section class="section">
  <div class="container-page max-w-2xl text-center">
    <div class="w-20 h-20 rounded-full bg-green-100 text-green-600 flex items-center justify-center mx-auto mb-6">
      <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
    </div>
    <h1 class="mb-4">Gracias. Su solicitud ha sido recibida.</h1>
    <p class="text-lg text-bakery-navy/80 mb-3">Respondemos en <strong>12 horas hábiles</strong> por WhatsApp o correo.</p>
    <p class="text-bakery-navy/70 mb-8">Para respuesta más rápida, escríbanos por WhatsApp:</p>
    <a href="https://wa.me/8613509623269" class="btn-primary mb-8">WhatsApp +86 135 0962 3269</a>
    <h2 class="mt-12 mb-4">Mientras espera</h2>
    <div class="grid sm:grid-cols-2 gap-4 text-left">
      <a href="/es/pricing/" class="card hover:scale-[1.02] transition"><h3 class="text-lg mb-1">Precios JD-3</h3><p class="text-sm text-bakery-navy/70">Todas las configuraciones y niveles.</p></a>
      <a href="/es/product/jd-3-vs-hobart-amx/" class="card hover:scale-[1.02] transition"><h3 class="text-lg mb-1">Comparaciones</h3><p class="text-sm text-bakery-navy/70">vs Hobart, Jackson, CMA.</p></a>
    </div>
  </div>
</section>
</BaseLayout>
