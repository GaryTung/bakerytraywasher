---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'es' as const;
---
<BaseLayout title="Guía del comprador (PDF) | JD-3" description="Guía del comprador (PDF)" locale={locale} canonicalPath="/resources/buyers-guide-pdf/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/es/'},{label: t(locale,'nav.resources'), href:'/es/resources/'},{label: 'Guía del comprador (PDF)'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Guía del comprador (PDF)</h1>
<p class="text-lg mb-6 text-bakery-navy/70">Esta página está disponible en inglés:</p>
<p><a href="/resources/buyers-guide-pdf/" class="btn-primary inline-block">Guía del comprador (PDF) (EN) →</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
