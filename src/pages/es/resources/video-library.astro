---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'es' as const;
---
<BaseLayout title="Biblioteca de videos | JD-3" description="Biblioteca de videos" locale={locale} canonicalPath="/resources/video-library/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/es/'},{label: t(locale,'nav.resources'), href:'/es/resources/'},{label: 'Biblioteca de videos'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Biblioteca de videos</h1>
<p class="text-lg mb-6 text-bakery-navy/70">Esta página está disponible en inglés:</p>
<p><a href="/resources/video-library/" class="btn-primary inline-block">Biblioteca de videos (EN) →</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
