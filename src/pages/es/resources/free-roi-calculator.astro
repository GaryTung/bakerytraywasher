---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'es' as const;
---
<BaseLayout title="Calculadora gratuita de ROI | JD-3" description="Calculadora gratuita de ROI" locale={locale} canonicalPath="/resources/free-roi-calculator/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/es/'},{label: t(locale,'nav.resources'), href:'/es/resources/'},{label: 'Calculadora gratuita de ROI'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Calculadora gratuita de ROI</h1>
<p class="text-lg mb-6 text-bakery-navy/70">Esta página está disponible en inglés:</p>
<p><a href="/resources/free-roi-calculator/" class="btn-primary inline-block">Calculadora gratuita de ROI (EN) →</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
