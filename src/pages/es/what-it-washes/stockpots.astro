---
import WhatItWashesLayout from '../../../layouts/WhatItWashesLayout.astro';
const locale = 'es' as const;
---
<WhatItWashesLayout
  locale={locale}
  canonicalPath="/what-it-washes/stockpots/"
  itemName={"Ollas Grandes"}
  title={"La JD-3 lava Ollas Grandes | Lavadora V-TAI para Panadería"}
  description={"La V-TAI JD-3 lava Ollas Grandes de forma eficaz. 180 bandejas/hora, certificación CE, desde $4.400 FOB Shenzhen."}
  challenge={"Limpiar Ollas Grandes en una panadería comercial presenta desafíos concretos: tipo de residuo (azúcar caramelizado, masa pegajosa, grasa), geometría del objeto, y densidad de carga. El lavado manual consume tiempo y rara vez logra la sanitización térmica que exige la normativa alimentaria."}
  howItHandles={"La JD-3 utiliza dos brazos de aspersión rotatorios con geometría de boquilla optimizada, tanque de lavado a 60–65 °C y enjuague final superior a 82 °C — todo dentro de una cámara de 650×550 mm que acepta utensilios sobredimensionados. El ciclo estándar de 2 minutos procesa cargas completas sin atascos."}
  recommendedSettings={"Ciclo estándar de 2 minutos, tanque de lavado a 65 °C, enjuague final a 82 °C, detergente alcalino bajo en espuma para uso comercial. Se recomienda pre-enjuague rápido para preservar la calidad del agua recirculada."}
  faqs={[
    { q: "¿Es necesario el pre-enjuague?", a: "Sí — el tanque de lavado recircula agua para eficiencia energética. Un pre-enjuague rápido evita la acumulación de residuos en el tanque y prolonga la vida útil del detergente." },
    { q: "¿Qué detergente recomiendan?", a: "Detergente alcalino comercial bajo en espuma (pH 12–13). Para residuos azucarados (pastelería) usar un detergente con tensoactivos específicos para confitería." },
    { q: "¿Cuánto duran los ciclos?", a: "2 minutos por ciclo estándar. En horas pico con residuo ligero, puede usarse el ciclo rápido de 90 segundos." },
  ]}
/>
