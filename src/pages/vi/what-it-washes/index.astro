---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'vi' as const;
const items = [
  { slug: 'baking-trays-600x400', name: '600×400 mm Bakery Trays', flagship: true },
  { slug: 'sheet-pans', name: 'American Sheet Pans' },
  { slug: 'mixing-bowls', name: 'Mixing Bowls' },
  { slug: 'cake-pans', name: 'Cake Pans' },
  { slug: 'pizza-pans', name: 'Pizza Pans' },
  { slug: 'frying-baskets', name: 'Frying Baskets' },
  { slug: 'stockpots', name: 'Stockpots' },
  { slug: 'dishes-plates', name: 'Dishes & Plates' },
  { slug: 'utensils-mixers', name: 'Utensils & Mixer Attachments' },
  { slug: 'large-bakeware', name: 'Large Bakeware' },
];
---
<BaseLayout title="What the JD-3 Washes" description="Items the V-TAI JD-3 cleans" locale={locale} canonicalPath="/what-it-washes/" schemaType="Article">
<BreadcrumbNav items={[{label:'Home',href:'/vi/'},{label:'What It Washes'}]} />
<section class="section"><div class="container-page">
<h1 class="text-center mb-4">What the JD-3 Washes</h1>
<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-8">
{items.map((it) => (
  <a href={`/vi/what-it-washes/${it.slug}/`} class={`card hover:scale-[1.02] transition ${it.flagship ? 'border-2 border-bakery-orange' : ''}`}>
    {it.flagship && <p class="eyebrow text-bakery-orange">⭐ Flagship</p>}
    <h3 class="text-lg mt-1">{it.name}</h3>
  </a>
))}
</div>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
