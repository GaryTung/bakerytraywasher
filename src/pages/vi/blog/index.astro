---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'vi' as const;
const posts = [
  {
    slug: '600x400-tray-washer-for-small-bakeries',
    title: "Quá lớn cho máy rửa bát, quá nhỏ cho máy đường hầm: bài toán khay 600×400",
    desc: "Khay 600×400 mm không vừa giá 500×500 của máy rửa bát tiêu chuẩn, nhưng máy rửa đường hầm cần 3–6 m sàn bạn không có. JD-3 sinh ra cho khoảng trống đó: diện tích 0,65 m² như một bàn sơ chế, giá 650×550 nhận sáu khay mỗi chu kỳ, cùng hai tay phun xoay và tráng ≥82°C để thực sự rửa sạch cặn nướng.",
    date: '2026-06-18',
  },
  {
    slug: 'commercial-dishwasher-maintenance-schedule',
    title: "Lịch bảo trì máy rửa bát công nghiệp cho tiệm bánh: việc cần làm hằng ngày, hằng tuần và hằng tháng cho một cỗ máy 10 năm",
    desc: "Máy rửa bát công nghiệp cho tiệm bánh nên dùng được 8–12 năm — nhưng chỉ khi được bảo trì. Thủ phạm lớn nhất là cặn vôi trên thanh đốt, hoàn toàn phòng ngừa được. Lịch hằng ngày/hằng tuần/hằng tháng/hằng quý, thói quen năm phút cuối ca làm 80% công việc, và cách độ cứng nước định chu kỳ tẩy cặn.",
    date: '2026-06-13',
  },
  {
    slug: 'commercial-dishwasher-faults-electrician-diagnose-circuit-diagram',
    title: "Bảy sự cố thường gặp của máy rửa bát công nghiệp mà thợ điện địa phương có thể chẩn đoán bằng sơ đồ mạch tích hợp",
    desc: "Phí gọi kỹ thuật viên chuyên môn 250–800 USD trước khi chạm vào linh kiện nào. Nhưng với bảy sự cố thường gặp nhất chiếm 80% các cuộc gọi bảo trì — không có điện, không nóng, không tia nước, CB nhảy, bơm xả chạy mãi, khóa nắp kẹt, báo nhiệt độ tráng — một thợ điện công nghiệp có giấy phép cầm sơ đồ ép plastic trong tủ khoanh vùng nguyên nhân trong 30–90 phút. Đi qua từng sự cố với mã linh kiện, điện áp mong đợi và giá trị điện trở.",
    date: '2026-06-10',
  },
  {
    slug: 'pre-installation-checklist-commercial-dishwasher',
    title: "Checklist chuẩn bị mặt bằng trước khi máy rửa khay công nghiệp đến",
    desc: "8 mục sẵn sàng mặt bằng — điện (32A loại C + RCD), nước, thoát nước, thông gió, sàn, không gian, quyết định nước nóng, mạch điện riêng — với con số cụ thể thợ điện và thợ nước cần trước ngày giao máy.",
    date: '2026-06-08',
  },
  {
    slug: 'chemistry-of-washing-bakery-trays',
    title: "Hóa học ẩn sau việc rửa khay bánh",
    desc: "Khay bánh không phải đĩa ăn. Bốn loại cặn khác nhau — đường caramen, mỡ polymer hóa, lòng đỏ trứng nướng cháy, vụn bột lên men — mỗi loại theo hóa học riêng. Giao thức hiện trường từ nhà sản xuất.",
    date: '2026-06-05',
  },
  {
    slug: 'five-failure-modes-commercial-dishwasher',
    title: "Năm cách máy rửa bát công nghiệp hỏng thật",
    desc: "Ổ bi bơm, cặn vôi, ẩm bo mạch, gioăng, cánh bơm thoát — và cần hỏi gì trước khi mua.",
    date: '2026-05-15',
  },
  {
    slug: 'vfa-may-rua-khay-tiem-banh-viet',
    title: 'VFA và máy rửa khay trong tiệm bánh Việt',
    desc: 'Thông tư 30/2012/TT-BYT, Giấy chứng nhận ATTP, quy trình thanh tra Cục An toàn thực phẩm.',
    date: '2026-04-15',
  },
  {
    slug: 'tieu-chuan-khay-600x400-giai-thich',
    title: 'Tiêu chuẩn khay 600×400 mm là gì',
    desc: 'Giải thích DIN 18876 / EN 631 và tương thích với lò Rational, Convotherm, Unox',
    date: '2026-01-28',
  },
  {
    slug: 'chi-phi-ddp-ha-noi-hcm',
    title: 'Chi phí DDP Hà Nội / HCM',
    desc: 'FOB Thâm Quyến, cước biển, thuế nhập khẩu 20%, VAT 8% — số liệu thực tế',
    date: '2026-02-11',
  },
  {
    slug: 'hoan-von-4-thang-tiem-banh',
    title: 'Hoàn vốn trong 4 tháng',
    desc: 'Tính toán ROI thực tế cho tiệm bánh tại Hà Nội, HCM, Đà Nẵng',
    date: '2026-02-25',
  },
];
---
<BaseLayout title={`${t(locale,'nav.blog')} | JD-3`} description="Bài viết về vận hành tiệm bánh và triển khai JD-3" locale={locale} canonicalPath="/blog/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/vi/'},{label: t(locale,'nav.blog')}]} />
<section class="section"><div class="container-page">
<h1 class="text-center mb-10">Blog</h1>
<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
{posts.map((p) => (
  <a href={`/vi/blog/${p.slug}/`} class="card hover:scale-[1.02] transition">
    <p class="text-xs text-bakery-navy/50 mb-2">{p.date}</p>
    <h3 class="mb-3">{p.title}</h3>
    <p class="text-sm text-bakery-navy/70">{p.desc}</p>
  </a>
))}
</div>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
