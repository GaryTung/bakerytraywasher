---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'vi' as const;
---
<BaseLayout title="Tại sao tiệm bánh cần máy rửa khay (bản tiếng Anh) | JD-3" description="Tại sao tiệm bánh cần máy rửa khay" locale={locale} canonicalPath="/blog/why-your-bakery-needs-a-tray-washer/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/vi/'},{label: t(locale,'nav.blog'), href:'/vi/blog/'},{label: 'Tại sao tiệm bánh cần máy rửa khay'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Tại sao tiệm bánh cần máy rửa khay</h1>
<p class="text-lg mb-6 text-bakery-navy/70">Bài viết này chưa được dịch sang tiếng Việt. Xem bản đầy đủ tiếng Anh:</p>
<p><a href="/blog/why-your-bakery-needs-a-tray-washer/" class="btn-primary inline-block">Tại sao tiệm bánh cần máy rửa khay (EN) →</a></p>
