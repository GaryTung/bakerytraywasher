---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'vi' as const;
---
<BaseLayout title="Hướng dẫn lắp đặt JD-3" description="Nhận máy, xem video hướng dẫn, kết nối nước và điện — và bắt đầu rửa." locale={locale} canonicalPath="/product/jd-3-installation/" schemaType="HowTo">
<BreadcrumbNav items={[{label:'Trang chủ',href:'/vi/'},{label:'Lắp đặt'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Lắp đặt JD-3 — Nhận, Kết Nối, Rửa</h1>
<p class="text-lg mb-6">JD-3 được thiết kế để tự lắp đặt. Khi nhận máy, làm theo video hướng dẫn đi kèm, kết nối nước và điện, rồi bắt đầu rửa. Không cần thợ chuyên dụng — thợ ống nước và thợ điện thông thường là đủ.</p>
<h2 class="mt-8 mb-3">3 bước đơn giản</h2>
<ol class="space-y-3 list-decimal list-inside">
<li><strong>Khui thùng và đặt vị trí</strong> — đặt máy trên bề mặt phẳng gần đường nước và thoát nước.</li>
<li><strong>Kết nối nước và điện</strong> — đầu vào G 3/4" nước lạnh, thoát G 1½", mạch điện riêng 380V/3N/50Hz (hoặc 400V một pha theo quy chuẩn địa phương).</li>
<li><strong>Làm theo video hướng dẫn</strong> — đi kèm khi giao hàng, cũng có sẵn qua WhatsApp khi đặt hàng. Tổng thời gian thông thường: 1–2 giờ.</li>
</ol>
<h2 class="mt-8 mb-3">Trong hộp</h2>
<ul class="space-y-1 list-disc list-inside">
<li>Máy JD-3</li>
<li>2 khay tiêu chuẩn + khay cốc</li>
<li>Ống cấp nước và ống thoát nước</li>
<li>Thẻ khởi động nhanh có liên kết video hướng dẫn</li>
<li>Sách hướng dẫn vận hành</li>
<li>Chứng nhận CE</li>
<li><strong>Sơ đồ mạch điện</strong> dán bên trong panel dịch vụ — giữ ở đó cho bảo trì sau này</li>
</ul>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
