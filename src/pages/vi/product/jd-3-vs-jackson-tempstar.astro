---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'vi' as const;
const rows = [{ label: 'Khay 600×400', jd3: '✓', competitor: '✗', highlight: true }];
---
<BaseLayout title="JD-3 vs Jackson TempStar" description="So sánh" locale={locale} canonicalPath="/product/jd-3-vs-jackson-tempstar/" schemaType="Article">
<BreadcrumbNav items={[{label:'Trang chủ',href:'/vi/'},{label:'vs Jackson'}]} />
<section class="section"><div class="container-prose"><h1>JD-3 vs Jackson TempStar HH-E</h1><p class="text-lg mt-4 mb-6">JD-3 thấp hơn 35%, buồng lớn hơn, khả năng tương thích 600×400.</p></div>
<div class="container-page"><ComparisonTable competitorName="Jackson" rows={rows} /></div></section>
<CTASection locale={locale} />
</BaseLayout>
