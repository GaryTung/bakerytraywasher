---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductSpecsTable from '../../../components/ProductSpecsTable.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'vi' as const;
const sections = [
  { title: 'Kích thước', rows: [
    { k: 'Kích thước (đóng)', v: '804 × 816 × 1.550 mm' },
    { k: 'Chiều cao (mở)', v: '2.115 mm' },
    { k: 'Kích thước rack', v: '650 × 550 mm' },
    { k: 'Trọng lượng', v: '145 kg' },
  ]},
  { title: 'Hiệu năng', rows: [
    { k: 'Năng suất', v: '180 khay/giờ' },
    { k: 'Khay mỗi chu kỳ', v: '6 khay' },
    { k: 'Thời gian chu kỳ', v: '2 phút (120 giây)' },
    { k: 'Chu kỳ mỗi giờ', v: '30 chu kỳ/giờ' },
    { k: 'Nước/chu kỳ', v: '2,0-2,5 L' },
    { k: 'Nhiệt độ tráng cuối', v: '>82°C' },
  ]},
  { title: 'Điện', rows: [
    { k: 'Tổng công suất', v: '13 kW' },
    { k: 'Điện áp', v: '380V / 3N / 50Hz' },
    { k: 'Dòng', v: '21,5 A' },
  ]},
];
---
<BaseLayout title="Thông số JD-3" description="Thông số kỹ thuật đầy đủ V-TAI JD-3" locale={locale} canonicalPath="/product/jd-3-specifications/" schemaType="Article">
<BreadcrumbNav items={[{label:'Trang chủ',href:'/vi/'},{label:'Thông số'}]} />
<section class="section"><div class="container-page"><h1 class="mb-6">Thông số đầy đủ JD-3</h1><ProductSpecsTable sections={sections} /></div></section>
<CTASection locale={locale} />
</BaseLayout>
