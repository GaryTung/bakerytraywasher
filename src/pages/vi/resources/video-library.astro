---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'vi' as const;
---
<BaseLayout title="Thư viện video | JD-3" description="Thư viện video" locale={locale} canonicalPath="/resources/video-library/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/vi/'},{label: t(locale,'nav.resources'), href:'/vi/resources/'},{label: 'Thư viện video'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Thư viện video</h1>
<p class="text-lg mb-6 text-bakery-navy/70">Trang này có sẵn bằng tiếng Anh:</p>
<p><a href="/resources/video-library/" class="btn-primary inline-block">Thư viện video (EN) →</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
