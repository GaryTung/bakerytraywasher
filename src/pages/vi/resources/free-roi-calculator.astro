---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'vi' as const;
---
<BaseLayout title="Máy tính ROI miễn phí | JD-3" description="Máy tính ROI miễn phí" locale={locale} canonicalPath="/resources/free-roi-calculator/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/vi/'},{label: t(locale,'nav.resources'), href:'/vi/resources/'},{label: 'Máy tính ROI miễn phí'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Máy tính ROI miễn phí</h1>
<p class="text-lg mb-6 text-bakery-navy/70">Trang này có sẵn bằng tiếng Anh:</p>
<p><a href="/resources/free-roi-calculator/" class="btn-primary inline-block">Máy tính ROI miễn phí (EN) →</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
