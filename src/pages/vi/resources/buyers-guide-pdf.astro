---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'vi' as const;
---
<BaseLayout title="Hướng dẫn người mua (PDF) | JD-3" description="Hướng dẫn người mua (PDF)" locale={locale} canonicalPath="/resources/buyers-guide-pdf/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/vi/'},{label: t(locale,'nav.resources'), href:'/vi/resources/'},{label: 'Hướng dẫn người mua (PDF)'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Hướng dẫn người mua (PDF)</h1>
<p class="text-lg mb-6 text-bakery-navy/70">Trang này có sẵn bằng tiếng Anh:</p>
<p><a href="/resources/buyers-guide-pdf/" class="btn-primary inline-block">Hướng dẫn người mua (PDF) (EN) →</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
