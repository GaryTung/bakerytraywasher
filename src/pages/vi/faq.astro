---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';
import { t } from '../../i18n/utils';
const locale = 'vi' as const;
const faqs = [
  { q: 'V-TAI JD-3 là gì?', a: 'Máy rửa bát thương mại kiểu nắp vòm cho khay bánh. Model VT-AE-JD-3.' },
  { q: 'Giá bao nhiêu?', a: 'Từ $4,400 FOB Thâm Quyến. Đến $4,900 với các tùy chọn nâng cấp (bộ phân phối hóa chất tự động, thu hồi nhiệt).' },
  { q: 'Khác biệt so với các thương hiệu khác?', a: 'Rack 650×550 mm vừa khay 600×400 mm (chuẩn DIN 18876 / EN 631) — chuẩn được Rational, Convotherm, Unox, MIWE sử dụng. Giá rẻ hơn đáng kể so với thương hiệu cao cấp ở cùng cấp chứng nhận CE.' },
  { q: 'Thời gian giao hàng?', a: '4 tuần sản xuất tại Thâm Quyến, cộng cước biển (20–35 ngày tùy điểm đến) hoặc đường hàng không (3–7 ngày, đắt hơn).' },
  { q: 'Bảo hành?', a: 'Bảo hành nhà sản xuất 12 tháng cho phụ tùng. Phụ tùng vận chuyển toàn cầu trong 5 ngày làm việc.' },
  { q: 'Nếu hỏng thì sao?', a: 'Mỗi máy đi kèm sơ đồ mạch điện bên trong bảng điều khiển dịch vụ. Thợ điện thông thường có thể sửa hầu hết các vấn đề. Phụ tùng vận chuyển toàn cầu trong 5 ngày.' },
  { q: 'Lắp đặt?', a: 'Nhận máy, làm theo video hướng dẫn, kết nối nước + điện. Thường mất 1–2 giờ. Không cần kỹ thuật viên chuyên dụng.' },
  { q: 'Có giao đến nước tôi không?', a: 'Có. Xem trang giá DDP cho 17 thị trường bằng tiền tệ địa phương. Nếu nước bạn không có trong danh sách, yêu cầu báo giá riêng — chúng tôi trả lời trong 12 giờ.' },
];
---
<BaseLayout title={`${t(locale,'nav.faq')} | JD-3`} description="Câu hỏi thường gặp về V-TAI JD-3." locale={locale} canonicalPath="/faq/">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/vi/'},{label: t(locale,'nav.faq')}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4 text-center">Câu hỏi thường gặp</h1>
</div></section>
<FAQSection items={faqs} title="" locale={locale} />
<CTASection locale={locale} />
</BaseLayout>
