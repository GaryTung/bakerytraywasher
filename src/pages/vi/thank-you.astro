---
import BaseLayout from '../../layouts/BaseLayout.astro';
const locale = 'vi' as const;
---
<BaseLayout title="Cảm ơn — Yêu cầu đã được nhận" description="Yêu cầu báo giá của bạn đã được tiếp nhận. Chúng tôi sẽ phản hồi trong 12 giờ." locale={locale} canonicalPath="/thank-you/" noindex={true}>
<section class="section">
  <div class="container-page max-w-2xl text-center">
    <div class="w-20 h-20 rounded-full bg-green-100 text-green-600 flex items-center justify-center mx-auto mb-6">
      <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
    </div>
    <h1 class="mb-4">Cảm ơn bạn. Yêu cầu của bạn đã được tiếp nhận.</h1>
    <p class="text-lg text-bakery-navy/80 mb-3">Chúng tôi sẽ phản hồi trong vòng <strong>12 giờ làm việc</strong> qua WhatsApp hoặc email.</p>
    <p class="text-bakery-navy/70 mb-8">Để phản hồi nhanh hơn, hãy nhắn tin cho chúng tôi qua WhatsApp:</p>
    <a href="https://wa.me/8613509623269" class="btn-primary mb-8">WhatsApp +86 135 0962 3269</a>
    <h2 class="mt-12 mb-4">Trong khi chờ</h2>
    <div class="grid sm:grid-cols-2 gap-4 text-left">
      <a href="/vi/pricing/" class="card hover:scale-[1.02] transition"><h3 class="text-lg mb-1">Giá JD-3</h3><p class="text-sm text-bakery-navy/70">Tất cả các cấu hình.</p></a>
      <a href="/vi/product/jd-3-vs-hobart-amx/" class="card hover:scale-[1.02] transition"><h3 class="text-lg mb-1">So sánh</h3><p class="text-sm text-bakery-navy/70">vs Hobart, Jackson, CMA.</p></a>
    </div>
  </div>
</section>
</BaseLayout>
