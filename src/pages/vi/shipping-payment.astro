---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CTASection from '../../components/CTASection.astro';
import { t } from '../../i18n/utils';
const locale = 'vi' as const;
---
<BaseLayout title="Vận chuyển và thanh toán | JD-3" description="Vận chuyển và thanh toán V-TAI JD-3." locale={locale} canonicalPath="/shipping-payment/">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/vi/'},{label: 'Vận chuyển và thanh toán'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Vận chuyển và thanh toán</h1>
<h2 class="mt-6 mb-3">Thanh toán</h2>
<ul class="list-disc list-inside space-y-1">
<li>Đặt cọc 30% khi đặt hàng, 70% trước khi giao</li>
<li>TT (chuyển khoản), L/C cho đơn hàng > $20,000</li>
<li>USD chính; chấp nhận EUR/GBP/AED</li>
</ul>
<h2 class="mt-6 mb-3">Thời gian</h2>
<ul class="list-disc list-inside space-y-1">
<li>Sản xuất: 4 tuần</li>
<li>Vận chuyển biển: 20–35 ngày</li>
<li>Vận chuyển hàng không: 3–7 ngày</li>
</ul>
<h2 class="mt-6 mb-3">DDP cho 17 thị trường</h2>
<p>Cho 17 thị trường lớn chúng tôi cung cấp giá DDP bằng tiền tệ địa phương. Xem <a href="/vi/pricing/by-country/" class="underline">giá theo quốc gia</a>.</p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
