---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'vi' as const;
---
<BaseLayout title="Cách chọn máy rửa khay bánh | JD-3" description="Cách chọn máy rửa khay bánh" locale={locale} canonicalPath="/guides/how-to-choose-bakery-tray-washer/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/vi/' },
  { label: t(locale, 'nav.guides') },
  { label: "Cách chọn máy rửa khay bánh" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Cách chọn máy rửa khay bánh</h1>
<p class="text-lg mb-6">Hướng dẫn thực tế cho người vận hành tiệm bánh sử dụng V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/how-to-choose-bakery-tray-washer/" class="underline">Xem phiên bản tiếng Anh đầy đủ</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
