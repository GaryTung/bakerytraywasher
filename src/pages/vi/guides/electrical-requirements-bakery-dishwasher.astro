---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'vi' as const;
---
<BaseLayout title="Yêu cầu điện | JD-3" description="Yêu cầu điện" locale={locale} canonicalPath="/guides/electrical-requirements-bakery-dishwasher/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/vi/' },
  { label: t(locale, 'nav.guides') },
  { label: "Yêu cầu điện" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Yêu cầu điện</h1>
<p class="text-lg mb-6">Hướng dẫn thực tế cho người vận hành tiệm bánh sử dụng V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/electrical-requirements-bakery-dishwasher/" class="underline">Xem phiên bản tiếng Anh đầy đủ</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
