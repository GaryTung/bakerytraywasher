---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'vi' as const;
---
<BaseLayout title="Thực hành tốt nhất khi rửa khay bánh | JD-3" description="Thực hành tốt nhất khi rửa khay bánh" locale={locale} canonicalPath="/guides/bakery-tray-cleaning-best-practices/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/vi/' },
  { label: t(locale, 'nav.guides') },
  { label: "Thực hành tốt nhất khi rửa khay bánh" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Thực hành tốt nhất khi rửa khay bánh</h1>
<p class="text-lg mb-6">Hướng dẫn thực tế cho người vận hành tiệm bánh sử dụng V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/bakery-tray-cleaning-best-practices/" class="underline">Xem phiên bản tiếng Anh đầy đủ</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
