---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'de' as const;
const posts = [
  {
    slug: 'bakery-tray-washer-capacity-calculator',
    title: 'Wie viele Bleche schafft eine Bäckerei-Spülmaschine? Kapazitätsrechner für die echte Produktion',
    desc: 'Tagesmenge in Zyklen, Maschinenminuten und Spülfenster umrechnen – mit geprüften 6 Standardblechen je 2-Minuten-Zyklus. Warum 180 Bleche/Stunde nur die technische Obergrenze sind.',
    date: '2026-08-19',
  },
  {
    slug: 'commercial-dishwasher-running-cost',
    title: "Was kostet der Betrieb einer gewerblichen Bäckerei-Spülmaschine wirklich? Pro Zyklus, pro Tag, pro Jahr",
    desc: "Käufer fixieren sich auf den Kaufpreis und vergessen die Betriebskosten. Vier Kosten — Wasser, Strom, Reiniger, Entkalken — und nur eine ist groß. Die ehrliche, physikbasierte Methode, jede zu Ihren Tarifen zu schätzen, ein Beispiel für ein Café mit 150 Blechen, und die fünf Hebel, die die Rechnung senken.",
    date: '2026-06-24',
  },
  {
    slug: '600x400-tray-washer-for-small-bakeries',
    title: "Zu groß für einen Geschirrspüler, zu klein für einen Tunnel: das 600×400-Backblech-Problem",
    desc: "600×400-mm-Bleche passen nicht in den 500×500-Korb eines Standardspülers, aber ein Tunnelspüler braucht 3–6 m Boden, den Sie nicht haben. Die JD-3 ist für die Lücke gebaut: 0,65 m² Stellfläche wie ein Arbeitstisch, 650×550-Korb für sechs Bleche pro Zyklus, plus doppelte Waschspülarme und ≥82°C-Klarspülung, um eingebrannten Rückstand wirklich zu reinigen.",
    date: '2026-06-18',
  },
  {
    slug: 'commercial-dishwasher-maintenance-schedule',
    title: "Der Wartungsplan für die gewerbliche Bäckerei-Spülmaschine: tägliche, wöchentliche und monatliche Aufgaben für eine 10-Jahres-Maschine",
    desc: "Eine gewerbliche Bäckerei-Spülmaschine sollte 8–12 Jahre halten — aber nur mit Wartung. Der größte Killer ist Kalk am Heizelement, vollständig vermeidbar. Der tägliche/wöchentliche/monatliche/vierteljährliche Plan, die Fünf-Minuten-Routine zum Schichtende, die 80 % erledigt, und wie die Wasserhärte Ihr Entkalkungsintervall bestimmt.",
    date: '2026-06-13',
  },
  {
    slug: 'commercial-dishwasher-faults-electrician-diagnose-circuit-diagram',
    title: "Sieben gewerbliche Geschirrspülerfehler, die ein örtlicher Elektriker mit dem eingebauten Schaltplan diagnostizieren kann",
    desc: "Spezialisten-Einsätze kosten 250–800 US$, bevor ein Bauteil angefasst wird. Für die sieben Fehler, die 80 % aller Ausfälle ausmachen — keine Spannung, keine Heizung, kein Sprühstrahl, Sicherung fliegt, Ablaufpumpe läuft dauernd, Haubenverriegelung, Klarspülalarm — grenzt ein konzessionierter Industrieelektriker mit dem laminierten Plan im Panel das Problem in 30–90 Minuten ein. Führt durch jeden Fehler mit Bauteilkennzeichnungen, Sollspannungen und Widerstandswerten.",
    date: '2026-06-10',
  },
  {
    slug: 'pre-installation-checklist-commercial-dishwasher',
    title: "Die Vor-Installations-Checkliste, die die meisten Bäckereien überspringen",
    desc: "8 Standortbereitschaftspunkte — Elektrik (32 A Typ-C + FI), Wasser, Ablauf, Lüftung, Boden, Freiraum, Warmwasser-Entscheidung, isolierter Stromkreis — mit den exakten Zahlen, die Elektriker und Installateur vor dem Liefertag brauchen.",
    date: '2026-06-08',
  },
  {
    slug: 'chemistry-of-washing-bakery-trays',
    title: "Die verborgene Chemie hinter dem Reinigen eines Backblechs",
    desc: "Ein Backblech ist kein Speiseteller. Vier verschiedene Rückstandstypen — karamellisierter Zucker, polymerisiertes Fett, eingebrannte Eierstreiche, fermentierter Teigrest — folgen jeweils einer eigenen Chemie. Ein Feldprotokoll des Herstellers.",
    date: '2026-06-05',
  },
  {
    slug: 'five-failure-modes-commercial-dishwasher',
    title: "Fünf Wege, wie eine gewerbliche Spülmaschine stirbt",
    desc: "Pumpenlager, Heizkalk, PCB-Feuchte, Türdichtung, Ablaufpumpenrad — und was Sie vor dem Kauf fragen sollten.",
    date: '2026-05-15',
  },
  {
    slug: 'din-10516-reinigung-baeckerei-spuelmaschine',
    title: 'DIN 10516 und Reinigung in Bäckereien',
    desc: 'Rechtskonformes Spülen nach LMHV und DIN 10516:2018 — IFS-Food-Audit, BRC, ≥82°C-Endspülung als Compliance-Schlüssel.',
    date: '2026-04-15',
  },
  {
    slug: 'din-18876-backblech-norm-erklaert',
    title: 'DIN 18876 Backblech-Norm erklärt',
    desc: 'Geschichte und Kompatibilität von 600×400 mm — Rational, Convotherm, Unox, MIWE.',
    date: '2026-01-28',
  },
  {
    slug: 'mwst-zoll-ddp-baeckerei-spuelmaschine-import',
    title: 'MwSt., Zoll & DDP: Import 2026',
    desc: 'FOB Shenzhen, Seefracht, deutscher Einfuhrumsatzsteuer 19% — alle Kosten transparent.',
    date: '2026-02-11',
  },
  {
    slug: 'amortisation-spuelmaschine-baeckerei-4-monate',
    title: 'Amortisation in 4 Monaten',
    desc: 'Konkrete ROI-Berechnung für deutsche, österreichische und schweizer Bäckereien.',
    date: '2026-02-25',
  },
];
---
<BaseLayout title={`${t(locale,'nav.blog')} | JD-3`} description="Artikel über Bäckereibetrieb und JD-3-Einsatz." locale={locale} canonicalPath="/blog/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/de/'},{label: t(locale,'nav.blog')}]} />
<section class="section"><div class="container-page">
<h1 class="text-center mb-10">Blog</h1>
<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
{posts.map((p) => (
  <a href={`/de/blog/${p.slug}/`} class="card hover:scale-[1.02] transition">
    <p class="text-xs text-bakery-navy/50 mb-2">{p.date}</p>
    <h3 class="mb-3">{p.title}</h3>
    <p class="text-sm text-bakery-navy/70">{p.desc}</p>
  </a>
))}
</div>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
