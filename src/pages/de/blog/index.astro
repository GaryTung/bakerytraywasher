---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'de' as const;
const posts = [
  {
    slug: 'pre-installation-checklist-commercial-dishwasher',
    title: "Die Vor-Installations-Checkliste, die die meisten Bäckereien überspringen",
    desc: "8 Standortbereitschaftspunkte — Elektrik (32 A Typ-C + FI), Wasser, Ablauf, Lüftung, Boden, Freiraum, Warmwasser-Entscheidung, isolierter Stromkreis — mit den exakten Zahlen, die Elektriker und Installateur vor dem Liefertag brauchen.",
    date: '2026-06-08',
  },
  {
    slug: 'chemistry-of-washing-bakery-trays',
    title: "Die verborgene Chemie hinter dem Reinigen eines Backblechs",
    desc: "Ein Backblech ist kein Speiseteller. Vier verschiedene Rückstandstypen — karamellisierter Zucker, polymerisiertes Fett, eingebrannte Eierstreiche, fermentierter Teigrest — folgen jeweils einer eigenen Chemie. Ein Feldprotokoll des Herstellers.",
    date: '2026-06-05',
  },
  {
    slug: 'five-failure-modes-commercial-dishwasher',
    title: "Fünf Wege, wie eine gewerbliche Spülmaschine stirbt",
    desc: "Pumpenlager, Heizkalk, PCB-Feuchte, Türdichtung, Ablaufpumpenrad — und was Sie vor dem Kauf fragen sollten.",
    date: '2026-05-15',
  },
  {
    slug: 'din-10516-reinigung-baeckerei-spuelmaschine',
    title: 'DIN 10516 und Reinigung in Bäckereien',
    desc: 'Rechtskonformes Spülen nach LMHV und DIN 10516:2018 — IFS-Food-Audit, BRC, ≥82°C-Endspülung als Compliance-Schlüssel.',
    date: '2026-04-15',
  },
  {
    slug: 'din-18876-backblech-norm-erklaert',
    title: 'DIN 18876 Backblech-Norm erklärt',
    desc: 'Geschichte und Kompatibilität von 600×400 mm — Rational, Convotherm, Unox, MIWE.',
    date: '2026-01-28',
  },
  {
    slug: 'mwst-zoll-ddp-baeckerei-spuelmaschine-import',
    title: 'MwSt., Zoll & DDP: Import 2026',
    desc: 'FOB Shenzhen, Seefracht, deutscher Einfuhrumsatzsteuer 19% — alle Kosten transparent.',
    date: '2026-02-11',
  },
  {
    slug: 'amortisation-spuelmaschine-baeckerei-4-monate',
    title: 'Amortisation in 4 Monaten',
    desc: 'Konkrete ROI-Berechnung für deutsche, österreichische und schweizer Bäckereien.',
    date: '2026-02-25',
  },
];
---
<BaseLayout title={`${t(locale,'nav.blog')} | JD-3`} description="Artikel über Bäckereibetrieb und JD-3-Einsatz." locale={locale} canonicalPath="/blog/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/de/'},{label: t(locale,'nav.blog')}]} />
<section class="section"><div class="container-page">
<h1 class="text-center mb-10">Blog</h1>
<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
{posts.map((p) => (
  <a href={`/de/blog/${p.slug}/`} class="card hover:scale-[1.02] transition">
    <p class="text-xs text-bakery-navy/50 mb-2">{p.date}</p>
    <h3 class="mb-3">{p.title}</h3>
    <p class="text-sm text-bakery-navy/70">{p.desc}</p>
  </a>
))}
</div>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
