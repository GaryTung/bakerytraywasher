---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'de' as const;
const rows = [
  { label: 'Durchsatz', jd3: '180 Bleche/h', competitor: '60 Körbe/h' },
  { label: 'Korbgröße', jd3: '650×550 mm', competitor: '500×500 mm' },
  { label: 'Bleche 600×400', jd3: '✓ Ja', competitor: '✗ Nein', highlight: true },
  { label: 'Preis', jd3: '$4.400 FOB', competitor: '$7.000-$9.000' },
];
---
<BaseLayout title="JD-3 vs Hobart AMX" description="Vergleich V-TAI JD-3 und Hobart AMX" locale={locale} canonicalPath="/product/jd-3-vs-hobart-amx/" schemaType="Article">
<BreadcrumbNav items={[{label:'Startseite',href:'/de/'},{label:'vs Hobart'}]} />
<section class="section"><div class="container-prose"><h1>JD-3 vs Hobart AMX</h1><p class="text-lg mt-4 mb-6">Hobart ist Marktführer in den USA. JD-3 ist 60% günstiger und nimmt 600×400 Bleche auf, die Hobart nicht aufnehmen kann.</p></div>
<div class="container-page"><ComparisonTable competitorName="Hobart AMX" rows={rows} /></div></section>
<CTASection locale={locale} />
</BaseLayout>
