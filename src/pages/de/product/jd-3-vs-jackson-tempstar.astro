---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'de' as const;
const rows = [{ label: 'Bleche 600×400', jd3: '✓', competitor: '✗', highlight: true }];
---
<BaseLayout title="JD-3 vs Jackson TempStar" description="Vergleich" locale={locale} canonicalPath="/product/jd-3-vs-jackson-tempstar/" schemaType="Article">
<BreadcrumbNav items={[{label:'Startseite',href:'/de/'},{label:'vs Jackson'}]} />
<section class="section"><div class="container-prose"><h1>JD-3 vs Jackson TempStar</h1><p class="text-lg mt-4 mb-6">JD-3 35% günstiger, größere Kammer, 600×400 Kompatibilität.</p></div>
<div class="container-page"><ComparisonTable competitorName="Jackson TempStar" rows={rows} /></div></section>
<CTASection locale={locale} />
</BaseLayout>
