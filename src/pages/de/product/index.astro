---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import ImagePlaceholder from '../../../components/ImagePlaceholder.astro';
import PriceCalloutBox from '../../../components/PriceCalloutBox.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'de' as const;
---
<BaseLayout title="V-TAI JD-3 — Haubenspüler für Bäckereien" description="V-TAI JD-3: 180 Bleche/Stunde, Bleche 600×400, SUS304, CE." locale={locale} canonicalPath="/product/" schemaType="Product">
<BreadcrumbNav items={[{label:'Startseite',href:'/de/'},{label:'Produkt'}]} />
<section class="section"><div class="container-page grid lg:grid-cols-2 gap-10">
<ImagePlaceholder src="/images/jd-3-front.webp" alt="V-TAI JD-3" ratio="4/3" label="JD-3" />
<div>
<p class="eyebrow mb-2">Modell VT-AE-JD-3</p>
<h1 class="mb-4">V-TAI JD-3 — Haubenspüler für Bäckereien</h1>
<p class="text-lg mb-5">Der einzige Haubenspüler in seiner Preisklasse, der für den europäischen Standard <strong>600×400 mm</strong> ausgelegt ist.</p>
<PriceCalloutBox locale={locale} />
</div>
</div></section>
<section class="section"><div class="container-prose">
<h2 class="mb-3">Hauptmerkmale</h2>
<ul class="space-y-2 list-disc list-inside">
<li>SUS304-Konstruktion — lebensmittelechter Edelstahl</li>
<li>Extra-große Kammer (650×550 mm)</li>
<li>Doppelt rotierende Waschdüsen 360°</li>
<li>Intelligente Temperaturregelung >82°C</li>
<li>Ultraniedriger Wasserverbrauch 2,0-2,5 L/Zyklus</li>
<li>Optional Wärmerückgewinnung</li>
<li>Versiegelte isolierte Tür — 70% weniger Dampf</li>
<li>CE Safety zertifiziert</li>
</ul>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
