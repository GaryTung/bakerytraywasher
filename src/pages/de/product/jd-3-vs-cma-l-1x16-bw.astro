---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'de' as const;
const rows = [{ label: 'Bleche 600×400', jd3: '✓', competitor: '✗', highlight: true }];
---
<BaseLayout title="JD-3 vs CMA L-1X16-BW" description="Vergleich" locale={locale} canonicalPath="/product/jd-3-vs-cma-l-1x16-bw/" schemaType="Article">
<BreadcrumbNav items={[{label:'Startseite',href:'/de/'},{label:'vs CMA'}]} />
<section class="section"><div class="container-prose"><h1>JD-3 vs CMA L-1X16-BW</h1><p class="text-lg mt-4 mb-6">CMA verwendet 500×500 Korb, der keine 600×400 aufnimmt. JD-3 schon.</p></div>
<div class="container-page"><ComparisonTable competitorName="CMA L-1X16-BW" rows={rows} /></div></section>
<CTASection locale={locale} />
</BaseLayout>
