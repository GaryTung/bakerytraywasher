---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBadgeStrip from '../../components/TrustBadgeStrip.astro';
import HeroShowcase from '../../components/HeroShowcase.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import DeliveryBand from '../../components/DeliveryBand.astro';
import PriceCalloutBox from '../../components/PriceCalloutBox.astro';
import CTASection from '../../components/CTASection.astro';
import FAQSection from '../../components/FAQSection.astro';
const locale = 'de' as const;

const types = [
  { name: 'Bäckerei', href: '/de/by-business-type/bakery-shop/', icon: '🥐' },
  { name: 'Patisserie', href: '/de/by-business-type/patisserie/', icon: '🧁' },
  { name: 'Konditorei', href: '/de/by-business-type/cake-shop/', icon: '🎂' },
  { name: 'Kantine', href: '/de/by-business-type/cafeteria/', icon: '🥪' },
  { name: 'Hotel-Patisserie', href: '/de/by-business-type/hotel-pastry-kitchen/', icon: '🏨' },
];

const faqs = [
  { q: 'Nimmt der JD-3 wirklich Backbleche der EN-Norm 600×400 mm auf?', a: 'Ja — der 650×550 mm Korb ist der einzige in dieser Preisklasse, der den europäischen Standard akzeptiert.' },
  { q: 'Wie lang ist die Lieferzeit?', a: '4-6 Wochen Produktion in Shenzhen plus 20-35 Tage Seefracht.' },
];
---
<BaseLayout
  title="Bäckereiblechspülmaschine | V-TAI JD-3 Gewerblich"
  description="Die Bäckereiblechspülmaschine, die sich in 4 Monaten amortisiert. Reinigt 600×400 mm Backbleche — die Größe, die die meisten US-Geschirrspüler nicht aufnehmen können. CE-zertifiziert. Ab $4.400 FOB."
  locale={locale}
  canonicalPath="/"
>
<section class="bg-gradient-to-br from-bakery-cream via-white to-bakery-cream/50 section">
  <div class="container-page grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <p class="eyebrow mb-3">V-TAI JD-3 · Haubenspüler für Bäckereien</p>
      <h1 class="mb-5">Die Bäckereiblechspülmaschine, die sich in <span class="text-bakery-orange">4 Monaten</span> amortisiert</h1>
      <p class="text-lg mb-6">Reinigt 600×400 mm Backbleche — die EN-Norm, die die meisten US-Spülmaschinen nicht aufnehmen können. CE-zertifiziert, Edelstahl SUS304. <strong>Ab $4.400 FOB Shenzhen.</strong></p>
      <div class="flex flex-wrap gap-3">
        <a href="/de/get-quote/" class="btn-primary">Angebot Anfordern</a>
        <a href="/de/product/" class="btn-secondary">Spezifikationen</a>
      </div>
    </div>
    <HeroShowcase
      mainAlt="V-TAI JD-3 Haubenspülmaschine, vollständige Frontansicht der Maschine"
      thumbAlt="Sechs 600×400 mm Backbleche hochkant im JD-3 Spülkorb"
      specValue="600×400"
      specLabel="mm Bleche ✓"
    />
  </div>
</section>
<TrustBadgeStrip locale={locale} />

<ProductGallery
  title="Die JD-3 aus der Nähe"
  subtitle="Echte Fotos aus der Fertigung — keine Renderings. Das ist die Maschine, die Sie erhalten."
  items={[
    { img: '/images/jd-3-wash-arms.webp', alt: 'Rotierender Wascharm des JD-3 über sechs eingesetzten Backblechen', caption: 'Zwei rotierende Wascharme erreichen jedes Blech' },
    { img: '/images/jd-3-circuit-diagram.webp', alt: 'Schaltplan im Service-Panel der JD-3', caption: 'Schaltplan reist in jeder Maschine mit' },
    { img: '/images/jd-3-led-control.webp', alt: 'LED-Panel mit Wasch- und Klarspültemperatur', caption: 'Live-Anzeige der Wasch- und Klarspültemperatur' },
    { img: '/images/factory-production-line.webp', alt: 'JD-3 Produktionslinie im V-TAI Werk', caption: 'Gefertigt in unserem eigenen 8.000 m² Werk' },
  ]}
/>
<section class="section bg-bakery-cream"><div class="container-page">
<h2 class="text-center mb-10">Welcher Betrieb sind Sie?</h2>
<div class="grid grid-cols-2 md:grid-cols-5 gap-4">
{types.map((bt) => (<a href={bt.href} class="card text-center"><div class="text-4xl mb-2">{bt.icon}</div><p class="font-semibold">{bt.name}</p></a>))}
</div></div></section>
<section class="section"><div class="container-page grid lg:grid-cols-2 gap-10 items-center">
<div>
<h2 class="mb-4">Ehrliche, transparente Preise</h2>
<p class="text-bakery-navy/80 mb-4">JD-3 ab <strong>$4.400 FOB Shenzhen</strong> — gleichwertige CE-zertifizierte Leistung im Vergleich zu Premium-Marken.</p>
</div>
<PriceCalloutBox locale={locale} />
</div></section>
<FAQSection items={faqs} title="Häufige Fragen" />
<DeliveryBand
  eyebrow="Weltweite Lieferung"
  title="Wir verpacken, verschiffen und verzollen — Sie schließen nur an"
  lead="Jede JD-3 verlässt das Werk exportfertig verpackt und reist per Seefracht zu Ihrem Hafen. Für 18 große Märkte übernehmen wir den gesamten Weg zu einem DDP-Preis: Fracht, Zollabwicklung, Einfuhrzoll und Lieferung bis vor Ihre Tür."
  points={["Exportverpackung", "Verzollt (DDP)", "Bis vor Ihre Tür geliefert"]}
  ctaLabel="DDP-Preise nach Land ansehen"
  ctaHref="/de/pricing/by-country/"
/>

<CTASection locale={locale} title="Bereit, das manuelle Spülen zu beenden?" subtitle="Individuelles Angebot in 12 Stunden" />
</BaseLayout>
