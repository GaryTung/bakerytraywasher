---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'de' as const;
---
<BaseLayout title="Kostenloser ROI-Rechner | JD-3" description="Kostenloser ROI-Rechner" locale={locale} canonicalPath="/resources/free-roi-calculator/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/de/'},{label: t(locale,'nav.resources'), href:'/de/resources/'},{label: 'Kostenloser ROI-Rechner'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Kostenloser ROI-Rechner</h1>
<p class="text-lg mb-6 text-bakery-navy/70">Diese Seite ist auf Englisch verfügbar:</p>
<p><a href="/resources/free-roi-calculator/" class="btn-primary inline-block">Kostenloser ROI-Rechner (EN) →</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
