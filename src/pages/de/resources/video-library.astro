---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'de' as const;
---
<BaseLayout title="Video-Bibliothek | JD-3" description="Video-Bibliothek" locale={locale} canonicalPath="/resources/video-library/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/de/'},{label: t(locale,'nav.resources'), href:'/de/resources/'},{label: 'Video-Bibliothek'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Video-Bibliothek</h1>
<p class="text-lg mb-6 text-bakery-navy/70">Diese Seite ist auf Englisch verfügbar:</p>
<p><a href="/resources/video-library/" class="btn-primary inline-block">Video-Bibliothek (EN) →</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
