---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import ImagePlaceholder from '../../../components/ImagePlaceholder.astro';
import InlineInquiryForm from '../../../components/InlineInquiryForm.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'de' as const;
const rows = [
  { label: 'V-TAI JD-3', jd3: '650 × 550 mm', competitor: '✓ Ja', highlight: true },
  { label: 'Hobart AMX', jd3: '500 × 500 mm', competitor: '✗ Nein' },
];
---
<BaseLayout title="Spülmaschine für 600×400 mm EN-Backbleche" description="Die einzige Haubenspülmaschine in dieser Preisklasse, die die europäische 600×400 mm EN-Norm aufnimmt." locale={locale} canonicalPath="/what-it-washes/baking-trays-600x400/" schemaType="Article">
<BreadcrumbNav items={[{label:'Startseite',href:'/de/'},{label:'600×400 EN-Bleche'}]} />
<section class="section"><div class="container-page grid lg:grid-cols-3 gap-10">
<article class="lg:col-span-2">
<p class="eyebrow mb-3">⭐ Hauptanwendung</p>
<h1 class="mb-4">Spülmaschine für 600×400 mm EN-Backbleche</h1>
<p class="text-lg mb-6">JD-3 ist die einzige Haubenspülmaschine in dieser Preisklasse, die den europäischen Standard 600×400 mm aufnimmt.</p>
<ImagePlaceholder src="/images/600x400-tray-comparison.webp" alt="600×400 Blech im JD-3" ratio="16/9" label="600×400 Vergleich" />
<h2 class="mt-10 mb-3">Die EN-Norm 600×400</h2>
<p>Entstand in den 1960er Jahren in Deutschland (DIN 18876). Heute der Standard aller professionellen Kombiöfen: Rational, Convotherm, Unox, Wachtel, MIWE.</p>
<ComparisonTable competitorName="Akzeptiert 600×400?" rows={rows} />
</article>
<aside class="lg:sticky lg:top-24 self-start"><InlineInquiryForm locale={locale} title="Angebot" /></aside>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
