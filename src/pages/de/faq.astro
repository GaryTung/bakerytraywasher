---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';
import { t } from '../../i18n/utils';
const locale = 'de' as const;
const faqs = [
  { q: 'Was ist die V-TAI JD-3?', a: 'Gewerbliche Haubenspülmaschine für Bäckerei-Backbleche. Modell VT-AE-JD-3.' },
  { q: 'Preis?', a: 'Ab 4.400 $ FOB Shenzhen. Bis 4.900 $ mit optionalen Erweiterungen (automatischer Reinigerdosierer, Wärmerückgewinnung).' },
  { q: 'Unterschied zu anderen Marken?', a: 'Der 650×550-mm-Korb nimmt 600×400-mm-Bleche (DIN 18876 / EN 631) auf — der Standard von Rational, Convotherm, Unox und MIWE. Deutlich günstiger als Premiummarken bei gleicher CE-Zertifizierung.' },
  { q: 'Lieferzeit?', a: '4 Wochen Produktion in Shenzhen, plus Seefracht (20–35 Tage je nach Zielhafen) oder Luftfracht (3–7 Tage, teurer).' },
  { q: 'Garantie?', a: '12 Monate Herstellergarantie auf Teile. Ersatzteile weltweit innerhalb von 5 Werktagen versendet.' },
  { q: 'Was passiert bei Defekten?', a: 'Jede Maschine wird mit Schaltplan im Service-Panel ausgeliefert. Ein normaler Elektriker kann die meisten Probleme beheben. Ersatzteilversand weltweit in 5 Tagen.' },
  { q: 'Installation?', a: 'Maschine empfangen, Video-Anleitung folgen, Wasser + Strom anschließen. Üblicherweise 1–2 Stunden. Kein Spezialtechniker erforderlich.' },
  { q: 'Versand in mein Land?', a: 'Ja. Siehe DDP-Preisseite für 18 Märkte in lokaler Währung. Wenn Ihr Land nicht gelistet ist, fordern Sie ein individuelles Angebot an — Antwort innerhalb von 12 Stunden.' },
];
---
<BaseLayout title={`${t(locale,'nav.faq')} | JD-3`} description="Häufige Fragen zur V-TAI JD-3." locale={locale} canonicalPath="/faq/" schemaType="FAQPage">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/de/'},{label: t(locale,'nav.faq')}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4 text-center">Häufig gestellte Fragen</h1>
</div></section>
<FAQSection items={faqs} title="" locale={locale} />
<CTASection locale={locale} />
</BaseLayout>
