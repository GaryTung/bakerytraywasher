---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import InlineInquiryForm from '../../components/InlineInquiryForm.astro';
const locale = 'de' as const;
---
<BaseLayout title="Kontakt V-TAI" description="Kontaktieren Sie uns" locale={locale} canonicalPath="/contact/">
<BreadcrumbNav items={[{label:'Startseite',href:'/de/'},{label:'Kontakt'}]} />
<section class="section"><div class="container-page grid lg:grid-cols-2 gap-10">
<div>
<h1 class="mb-4">Kontaktieren Sie uns</h1>
<div class="space-y-4">
<div class="card"><h3 class="text-lg mb-2">WhatsApp</h3><a href="https://wa.me/8613509623269" class="text-bakery-orange underline">+86 135 0962 3269</a></div>
<div class="card"><h3 class="text-lg mb-2">E-Mail</h3><a href="mailto:info@v-tai.com" class="text-bakery-orange underline">info@v-tai.com</a></div>
</div>
</div>
<InlineInquiryForm locale={locale} title="Senden Sie uns eine Nachricht" />
</div></section>
</BaseLayout>
