---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CTASection from '../../components/CTASection.astro';
import { t } from '../../i18n/utils';
const locale = 'de' as const;
---
<BaseLayout title="Versand und Zahlung | JD-3" description="Versand und Zahlung V-TAI JD-3." locale={locale} canonicalPath="/shipping-payment/">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/de/'},{label: 'Versand und Zahlung'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Versand und Zahlung</h1>
<h2 class="mt-6 mb-3">Zahlung</h2>
<ul class="list-disc list-inside space-y-1">
<li>30% Anzahlung bei Bestellung, 70% Restbetrag vor Versand</li>
<li>TT (Überweisung), L/C für Bestellungen > 20.000 $</li>
<li>USD primär; EUR/GBP/AED akzeptiert</li>
</ul>
<h2 class="mt-6 mb-3">Lieferzeiten</h2>
<ul class="list-disc list-inside space-y-1">
<li>Produktion: 4 Wochen</li>
<li>Seefracht: 20–35 Tage</li>
<li>Luftfracht: 3–7 Tage</li>
</ul>
<h2 class="mt-6 mb-3">DDP für 18 Märkte</h2>
<p>Für 18 wichtige Märkte bieten wir DDP-Preise in lokaler Währung. Siehe <a href="/de/pricing/by-country/" class="underline">Preise nach Land</a>.</p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
