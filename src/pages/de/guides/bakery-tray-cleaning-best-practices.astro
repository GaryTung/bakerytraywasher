---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'de' as const;
---
<BaseLayout title="Best Practices zur Bäckereibleche-Reinigung | JD-3" description="Best Practices zur Bäckereibleche-Reinigung" locale={locale} canonicalPath="/guides/bakery-tray-cleaning-best-practices/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/de/' },
  { label: t(locale, 'nav.guides') },
  { label: "Best Practices zur Bäckereibleche-Reinigung" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Best Practices zur Bäckereibleche-Reinigung</h1>
<p class="text-lg mb-6">Praktischer Leitfaden für Bäckereibetreiber mit dem V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/bakery-tray-cleaning-best-practices/" class="underline">Vollständige englische Version ansehen</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
