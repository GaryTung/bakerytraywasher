---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'de' as const;
---
<BaseLayout title="Hygiene-Temperaturstandards | JD-3" description="Hygiene-Temperaturstandards" locale={locale} canonicalPath="/guides/sanitization-temperature-standards/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/de/' },
  { label: t(locale, 'nav.guides') },
  { label: "Hygiene-Temperaturstandards" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Hygiene-Temperaturstandards</h1>
<p class="text-lg mb-6">Praktischer Leitfaden für Bäckereibetreiber mit dem V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/sanitization-temperature-standards/" class="underline">Vollständige englische Version ansehen</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
