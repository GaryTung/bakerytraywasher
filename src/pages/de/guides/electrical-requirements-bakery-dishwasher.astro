---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'de' as const;
---
<BaseLayout title="Elektrische Anforderungen | JD-3" description="Elektrische Anforderungen" locale={locale} canonicalPath="/guides/electrical-requirements-bakery-dishwasher/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/de/' },
  { label: t(locale, 'nav.guides') },
  { label: "Elektrische Anforderungen" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Elektrische Anforderungen</h1>
<p class="text-lg mb-6">Praktischer Leitfaden für Bäckereibetreiber mit dem V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/electrical-requirements-bakery-dishwasher/" class="underline">Vollständige englische Version ansehen</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
