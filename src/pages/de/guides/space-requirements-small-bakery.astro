---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'de' as const;
---
<BaseLayout title="Platzanforderungen für kleine Bäckereien | JD-3" description="Platzanforderungen für kleine Bäckereien" locale={locale} canonicalPath="/guides/space-requirements-small-bakery/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/de/' },
  { label: t(locale, 'nav.guides') },
  { label: "Platzanforderungen für kleine Bäckereien" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Platzanforderungen für kleine Bäckereien</h1>
<p class="text-lg mb-6">Praktischer Leitfaden für Bäckereibetreiber mit dem V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/space-requirements-small-bakery/" class="underline">Vollständige englische Version ansehen</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
