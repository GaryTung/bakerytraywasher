---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'ar' as const;
---
<BaseLayout title="متطلبات المساحة للمخبز الصغير | JD-3" description="متطلبات المساحة للمخبز الصغير" locale={locale} canonicalPath="/guides/space-requirements-small-bakery/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/ar/' },
  { label: t(locale, 'nav.guides') },
  { label: "متطلبات المساحة للمخبز الصغير" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">متطلبات المساحة للمخبز الصغير</h1>
<p class="text-lg mb-6">دليل عملي لمشغلي المخابز الذين يستخدمون V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/space-requirements-small-bakery/" class="underline">اطلع على النسخة الإنجليزية الكاملة</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
