---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'ar' as const;
---
<BaseLayout title="معايير درجة حرارة التعقيم | JD-3" description="معايير درجة حرارة التعقيم" locale={locale} canonicalPath="/guides/sanitization-temperature-standards/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/ar/' },
  { label: t(locale, 'nav.guides') },
  { label: "معايير درجة حرارة التعقيم" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">معايير درجة حرارة التعقيم</h1>
<p class="text-lg mb-6">دليل عملي لمشغلي المخابز الذين يستخدمون V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/sanitization-temperature-standards/" class="underline">اطلع على النسخة الإنجليزية الكاملة</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
