---
import BaseLayout from '../../layouts/BaseLayout.astro';
const locale = 'ar' as const;
---
<BaseLayout title="شكراً — تم استلام طلبك" description="تم استلام طلب عرض السعر الخاص بك. سنرد خلال 12 ساعة." locale={locale} canonicalPath="/thank-you/" noindex={true}>
<section class="section">
  <div class="container-page max-w-2xl text-center">
    <div class="w-20 h-20 rounded-full bg-green-100 text-green-600 flex items-center justify-center mx-auto mb-6">
      <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
    </div>
    <h1 class="mb-4">شكراً لك. لقد تم استلام طلبك.</h1>
    <p class="text-lg text-bakery-navy/80 mb-3">سنرد خلال <strong>12 ساعة عمل</strong> عبر واتساب أو البريد الإلكتروني.</p>
    <p class="text-bakery-navy/70 mb-8">للحصول على رد أسرع، راسلنا عبر واتساب:</p>
    <a href="https://wa.me/8613509623269" class="btn-primary mb-8">واتساب +86 135 0962 3269</a>
    <h2 class="mt-12 mb-4">في انتظار ذلك</h2>
    <div class="grid sm:grid-cols-2 gap-4 text-left">
      <a href="/ar/product/" class="card hover:scale-[1.02] transition"><h3 class="text-lg mb-1">منتج JD-3</h3><p class="text-sm text-bakery-navy/70">المواصفات الكاملة.</p></a>
      <a href="/ar/product/jd-3-vs-hobart-amx/" class="card hover:scale-[1.02] transition"><h3 class="text-lg mb-1">المقارنات</h3><p class="text-sm text-bakery-navy/70">vs Hobart, Jackson, CMA.</p></a>
    </div>
  </div>
</section>
</BaseLayout>
