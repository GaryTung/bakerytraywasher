---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';
const locale = 'ar' as const;
const faqs = [
  { q: 'What is V-TAI JD-3?', a: 'Hood-type commercial bakery tray washer. Model VT-AE-JD-3.' },
  { q: 'Price?', a: 'From $4,400 FOB Shenzhen. Up to $4,900 with optional upgrades.' },
  { q: 'Difference vs other brands?', a: '650×550 mm rack fits 600×400 mm European Bakery Norm trays. Significantly lower cost than premium brands.' },
  { q: 'Lead time?', a: '4 weeks production + sea/air freight.' },
  { q: 'Warranty?', a: '12-month manufacturer warranty on parts. Spare parts ship globally within 5 days.' },
  { q: 'What if it breaks?', a: 'Each machine ships with circuit diagram inside service panel. Regular electrician can repair most issues. Parts shipped globally in 5 days.' },
  { q: 'Installation?', a: 'Receive machine, follow video tutorial, connect water + electricity. 1-2 hours typical.' },
  { q: 'Ships to my country?', a: 'Yes. See DDP pricing page for 18 markets in local currency.' },
];
---
<BaseLayout title="FAQ | JD-3" description="Common questions about V-TAI JD-3." locale={locale} canonicalPath="/faq/" schemaType="FAQPage">
<BreadcrumbNav items={[{label:'Home',href:'/ar/'},{label:'FAQ'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4 text-center">Frequently Asked Questions</h1>
</div></section>
<FAQSection items={faqs} title="" />
<CTASection locale={locale} />
</BaseLayout>
