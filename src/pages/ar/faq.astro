---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';
import { t } from '../../i18n/utils';
const locale = 'ar' as const;
const faqs = [
  { q: 'ما هو V-TAI JD-3؟', a: 'غسالة صحون تجارية بغطاء قبة لصواني المخابز. الموديل VT-AE-JD-3.' },
  { q: 'ما هو السعر؟', a: 'يبدأ من 4,400 دولار FOB شنتشن. حتى 4,900 دولار مع الترقيات الاختيارية (موزع منظفات أوتوماتيكي، استرداد الحرارة).' },
  { q: 'الفرق عن العلامات التجارية الأخرى؟', a: 'رف بحجم 650×550 مم يستوعب صواني 600×400 مم (DIN 18876 / EN 631) — المعيار الذي تستخدمه Rational وConvotherm وUnox وMIWE. سعر أقل بكثير من العلامات التجارية الفاخرة بنفس مستوى شهادة CE.' },
  { q: 'مدة التسليم؟', a: '4 أسابيع إنتاج في شنتشن، بالإضافة إلى شحن بحري (20-35 يوماً حسب الوجهة) أو جوي (3-7 أيام، أغلى).' },
  { q: 'الضمان؟', a: 'ضمان من الشركة المصنعة 12 شهراً على القطع. قطع الغيار تُشحن عالمياً خلال 5 أيام عمل.' },
  { q: 'ماذا يحدث عند العطل؟', a: 'كل آلة تأتي مع مخطط الدائرة الكهربائية داخل لوحة الخدمة. كهربائي عام يمكنه إصلاح معظم المشاكل. القطع تُشحن عالمياً في 5 أيام.' },
  { q: 'التركيب؟', a: 'استلم الآلة، اتبع الفيديو التعليمي، وصّل الماء + الكهرباء. عادةً 1-2 ساعة. لا يلزم فني متخصص.' },
  { q: 'الشحن إلى بلدي؟', a: 'نعم. انظر صفحة أسعار DDP لـ 18 سوقاً بالعملة المحلية. إذا لم يكن بلدك مدرجاً، اطلب عرض سعر مخصصاً — نرد خلال 12 ساعة.' },
];
---
<BaseLayout title={`${t(locale,'nav.faq')} | JD-3`} description="الأسئلة الشائعة حول V-TAI JD-3." locale={locale} canonicalPath="/faq/">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/ar/'},{label: t(locale,'nav.faq')}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4 text-center">الأسئلة الشائعة</h1>
</div></section>
<FAQSection items={faqs} title="" locale={locale} />
<CTASection locale={locale} />
</BaseLayout>
