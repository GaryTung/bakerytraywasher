---
import BusinessTypeLayout from '../../../layouts/BusinessTypeLayout.astro';
const locale = 'ar' as const;
---
<BusinessTypeLayout
  locale={locale}
  canonicalPath="/by-business-type/cafeteria/"
  slug="cafeteria"
  businessName="Cafeteria"
  icon="🥪"
  title="JD-3 for Cafeteria"
  description="The V-TAI JD-3 hood-type bakery tray washer for Cafeteria operations. 180 trays/hour, 600×400 mm rack, CE-certified, from $4,400 FOB."
  reality="Cafeteria operations have specific dishwashing needs. The V-TAI JD-3 was designed for small commercial operators in this category."
  needs="Tray fit, fast payback, unattended operation, footprint fit."
  fit="JD-3 default config + auto detergent dispenser is the right combination for most Cafeteria operations. 4-week production lead time, DDP shipping to your address."
  roi="Typical ROI: ~4 months payback when compared to 2 dishwashing workers. Simple labor-only payback 3.5 months; including shipping + install ~4-5 months."
  faqs={[
    { q: 'For full details', a: 'See the English version at /by-business-type/cafeteria/ for complete deployment details.' },
  ]}
/>
