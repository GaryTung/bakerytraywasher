---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import PriceCalloutBox from '../../../components/PriceCalloutBox.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'ar' as const;
---
<BaseLayout title="أسعار JD-3 — تبدأ من 4,400 دولار FOB" description="تسعير صادق وشفاف لـ V-TAI JD-3." locale={locale} canonicalPath="/pricing/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/ar/'},{label: t(locale,'nav.pricing')}]} />
<section class="section"><div class="container-page">
<h1 class="text-center mb-4">تسعير صادق وشفاف</h1>
<p class="text-center text-bakery-navy/70 mb-10 max-w-2xl mx-auto">لا رسوم خفية. هذا بالضبط ما تكلفه JD-3.</p>
<div class="grid md:grid-cols-3 gap-5 max-w-5xl mx-auto">
<div class="card"><h3>JD-3 القياسي</h3><p class="text-3xl font-bold text-bakery-orange">4,400 $</p><p class="text-xs text-bakery-navy/60 mb-3">FOB شنتشن</p><p class="text-sm">التكوين الأساسي. 380V/3N/50Hz. يشمل رفين، أدوات، دليل، شهادة CE.</p></div>
<div class="card border-2 border-bakery-orange"><p class="eyebrow text-bakery-orange mb-1">★ الأكثر طلباً</p><h3>+ موزع تلقائي</h3><p class="text-3xl font-bold text-bakery-orange">4,600 $</p><p class="text-sm">مضخة تلقائية للمنظف ومادة الشطف. تلغي الجرعات اليدوية.</p></div>
<div class="card"><h3>+ استرداد الحرارة</h3><p class="text-3xl font-bold text-bakery-orange">4,900 $</p><p class="text-sm">وحدة محسّنة: الماء الساخن من الشطف النهائي يتدفق إلى خزان الغسيل الرئيسي. توفير الطاقة 15–25%.</p></div>
</div>
<p class="text-center mt-6 text-sm text-bakery-navy/60">جميع الأسعار بالدولار، FOB شنتشن. الشحن والرسوم تختلف حسب البلد.</p>
<div class="mt-10 max-w-md mx-auto"><PriceCalloutBox locale={locale} /></div>
<div class="mt-10 text-center"><a href="/ar/pricing/by-country/" class="btn-primary">أسعار DDP حسب الدولة (17 سوقاً)</a></div>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
