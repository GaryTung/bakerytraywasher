---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'ar' as const;
const posts = [
  {
    slug: '600x400-tray-washer-for-small-bakeries',
    title: "أكبر من غسالة أطباق، أصغر من غسالة نفقية: مشكلة صينية 600×400",
    desc: "صواني 600×400 مم لا تدخل رف 500×500 لغسالة أطباق قياسية، لكن الغسالة النفقية تحتاج 3–6 م أرضية لا تملكها. JD-3 مصنوعة لهذه الفجوة: مساحة 0.65 م² كطاولة تحضير، رف 650×550 لست صواني في الدورة، مع ذراعَيْ غسل دوّارَيْن وشطف ≥82°C لتنظيف البقايا المخبوزة فعلاً.",
    date: '2026-06-18',
  },
  {
    slug: 'commercial-dishwasher-maintenance-schedule',
    title: "جدول صيانة غسالة أطباق المخابز التجارية: مهام يومية وأسبوعية وشهرية لآلة تدوم 10 سنوات",
    desc: "ينبغي أن تدوم غسالة أطباق المخابز التجارية 8–12 سنة — لكن فقط مع الصيانة. القاتل الأكبر هو الترسبات على عنصر التسخين، وهو قابل للوقاية تماماً. الجدول اليومي/الأسبوعي/الشهري/الربع سنوي، روتين الخمس دقائق في نهاية الوردية الذي ينجز 80%، وكيف تحدد عسرة الماء فترة إزالة الترسبات.",
    date: '2026-06-13',
  },
  {
    slug: 'commercial-dishwasher-faults-electrician-diagnose-circuit-diagram',
    title: "سبعة أعطال شائعة في غسالة الأطباق التجارية يمكن لكهربائي محلي تشخيصها باستخدام المخطط الكهربائي المدمج",
    desc: "زيارات الفنيين المتخصصين تكلف 250–800 دولار قبل لمس أي مكون. لكن للأعطال السبعة الأكثر شيوعاً التي تشكل 80% من نداءات الخدمة — لا كهرباء، لا تسخين، لا رش، القاطع يفصل، مضخة التصريف تعمل باستمرار، قفل الغطاء، إنذار حرارة الشطف — يستطيع كهربائي صناعي مرخص يحمل المخطط المغلف داخل اللوحة عزل السبب في 30–90 دقيقة. يستعرض كل عطل برموز المكونات، الفولتيات المتوقعة وقيم المقاومة.",
    date: '2026-06-10',
  },
  {
    slug: 'pre-installation-checklist-commercial-dishwasher',
    title: "قائمة التحضير قبل التركيب التي تتجاهلها معظم المخابز",
    desc: "8 بنود جاهزية الموقع — كهرباء (32 أمبير نوع C + قاطع تسرب)، ماء، صرف، تهوية، أرضية، خلوص، قرار الماء الساخن، دائرة معزولة — مع الأرقام الفعلية التي يحتاجها الكهربائي والسبّاك قبل يوم التسليم.",
    date: '2026-06-08',
  },
  {
    slug: 'chemistry-of-washing-bakery-trays',
    title: "الكيمياء الخفية لغسل صواني المخابز",
    desc: "صينية المخبز ليست طبق طعام. أربعة أنواع متمايزة من البقايا — السكر المتكرمل، الدهون البوليمرية، طلاء البيض المخبوز، فتات العجين المخمر — تخضع لكيمياء مختلفة. بروتوكول ميداني من شركة مصنعة.",
    date: '2026-06-05',
  },
  {
    slug: 'five-failure-modes-commercial-dishwasher',
    title: "خمس طرق تموت بها غسالة الصحون التجارية",
    desc: "محامل المضخة، ترسبات الكلس، رطوبة اللوحة، حشية الباب، دفّاع التصريف — وماذا تسأل قبل الشراء.",
    date: '2026-05-15',
  },
  {
    slug: 'sfda-esma-istirad-ghassalat-mukhabiz',
    title: 'SFDA و ESMA: دليل الاستيراد إلى الخليج',
    desc: 'شهادة GCC للمطابقة، CE، رمز HS 8422.11، VAT السعودية 15% والإمارات 5%، DDP إلى الرياض ودبي.',
    date: '2026-04-15',
  },
  {
    slug: 'maayar-sawani-600x400-tafseer',
    title: 'معيار صواني 600×400 مم — شرح',
    desc: 'شرح DIN 18876 / EN 631 والتوافق مع أفران Rational وConvotherm وUnox',
    date: '2026-01-28',
  },
  {
    slug: 'sear-ddp-alkhalij-tahleel',
    title: 'سعر DDP الخليج — تحليل التكلفة',
    desc: 'FOB شنتشن، الشحن البحري، الجمارك، VAT — أرقام 2026 الفعلية للسعودية والإمارات وقطر',
    date: '2026-02-11',
  },
  {
    slug: 'istirdad-alistithmar-4-ashhur',
    title: 'استرداد الاستثمار في 4 أشهر',
    desc: 'حساب ROI واقعي للمخابز في الرياض ودبي والدوحة',
    date: '2026-02-25',
  },
];
---
<BaseLayout title={`${t(locale,'nav.blog')} | JD-3`} description="مقالات عن عمليات المخابز ونشر JD-3" locale={locale} canonicalPath="/blog/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/ar/'},{label: t(locale,'nav.blog')}]} />
<section class="section"><div class="container-page">
<h1 class="text-center mb-10">المدونة</h1>
<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
{posts.map((p) => (
  <a href={`/ar/blog/${p.slug}/`} class="card hover:scale-[1.02] transition">
    <p class="text-xs text-bakery-navy/50 mb-2">{p.date}</p>
    <h3 class="mb-3">{p.title}</h3>
    <p class="text-sm text-bakery-navy/70">{p.desc}</p>
  </a>
))}
</div>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
