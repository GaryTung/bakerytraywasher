---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'ar' as const;
const posts = [
  {
    slug: 'sfda-esma-istirad-ghassalat-mukhabiz',
    title: 'SFDA و ESMA: دليل الاستيراد إلى الخليج',
    desc: 'شهادة GCC للمطابقة، CE، رمز HS 8422.11، VAT السعودية 15% والإمارات 5%، DDP إلى الرياض ودبي.',
    date: '2026-04-15',
  },
  {
    slug: 'maayar-sawani-600x400-tafseer',
    title: 'معيار صواني 600×400 مم — شرح',
    desc: 'شرح DIN 18876 / EN 631 والتوافق مع أفران Rational وConvotherm وUnox',
    date: '2026-01-28',
  },
  {
    slug: 'sear-ddp-alkhalij-tahleel',
    title: 'سعر DDP الخليج — تحليل التكلفة',
    desc: 'FOB شنتشن، الشحن البحري، الجمارك، VAT — أرقام 2026 الفعلية للسعودية والإمارات وقطر',
    date: '2026-02-11',
  },
  {
    slug: 'istirdad-alistithmar-4-ashhur',
    title: 'استرداد الاستثمار في 4 أشهر',
    desc: 'حساب ROI واقعي للمخابز في الرياض ودبي والدوحة',
    date: '2026-02-25',
  },
];
---
<BaseLayout title={`${t(locale,'nav.blog')} | JD-3`} description="مقالات عن عمليات المخابز ونشر JD-3" locale={locale} canonicalPath="/blog/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/ar/'},{label: t(locale,'nav.blog')}]} />
<section class="section"><div class="container-page">
<h1 class="text-center mb-10">المدونة</h1>
<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
{posts.map((p) => (
  <a href={`/ar/blog/${p.slug}/`} class="card hover:scale-[1.02] transition">
    <p class="text-xs text-bakery-navy/50 mb-2">{p.date}</p>
    <h3 class="mb-3">{p.title}</h3>
    <p class="text-sm text-bakery-navy/70">{p.desc}</p>
  </a>
))}
</div>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
