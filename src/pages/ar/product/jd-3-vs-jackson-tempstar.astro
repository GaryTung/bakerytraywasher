---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'ar' as const;
const rows = [
  { label: 'حجم الرف', jd3: '650×550 مم', competitor: '500×500 مم' },
  { label: 'صواني 600×400', jd3: '✓ نعم', competitor: '✗ لا', highlight: true },
  { label: 'السعر', jd3: '$2,800 FOB', competitor: '$5,500-$7,500' },
];
---
<BaseLayout title="JD-3 مقابل Jackson TempStar" description="JD-3 vs Jackson TempStar HH-E." locale={locale} canonicalPath="/product/jd-3-vs-jackson-tempstar/" schemaType="Article">
<BreadcrumbNav items={[{label:'الرئيسية',href:'/ar/'},{label:'مقابل Jackson'}]} />
<section class="section"><div class="container-prose"><h1>JD-3 مقابل Jackson TempStar</h1><p class="text-lg mt-4 mb-6">Jackson من المستوى المتوسط الأمريكي. JD-3 أقل بـ 35%، غرفة أكبر، توافق 600×400.</p></div>
<div class="container-page"><ComparisonTable competitorName="Jackson TempStar" rows={rows} /></div></section>
<CTASection locale={locale} />
</BaseLayout>
