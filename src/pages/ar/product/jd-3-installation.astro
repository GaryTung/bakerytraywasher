---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'ar' as const;
---
<BaseLayout title="دليل تركيب JD-3" description="استلم الآلة، تابع الفيديو التعليمي، وصل الماء والكهرباء — وابدأ الغسيل." locale={locale} canonicalPath="/product/jd-3-installation/" schemaType="HowTo">
<BreadcrumbNav items={[{label:'الرئيسية',href:'/ar/'},{label:'التركيب'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">تركيب JD-3 — استلام، توصيل، غسيل</h1>
<p class="text-lg mb-6">صُمم JD-3 للتركيب الذاتي. عند استلام الآلة، اتبع الفيديو التعليمي المرفق، وصل الماء والكهرباء، وابدأ الغسيل. لا حاجة لمركّب متخصص — السباك والكهربائي العاديان يكفيان.</p>
<h2 class="mt-8 mb-3">3 خطوات بسيطة</h2>
<ol class="space-y-3 list-decimal list-inside">
<li><strong>إخراج الآلة وتحديد الموقع</strong> — على سطح مستوٍ بالقرب من مصدر الماء والصرف.</li>
<li><strong>توصيل الماء والكهرباء</strong> — مدخل ماء بارد G 3/4"، صرف G 1½"، دائرة كهربائية مخصصة 380 فولت/3N/50Hz (أو 400 فولت أحادي الطور وفق المعيار المحلي).</li>
<li><strong>اتباع الفيديو التعليمي</strong> — مرفق بالشحنة، ومتاح أيضاً عبر واتساب عند الطلب. الوقت الإجمالي عادة: 1–2 ساعة.</li>
</ol>
<h2 class="mt-8 mb-3">محتويات العبوة</h2>
<ul class="space-y-1 list-disc list-inside">
<li>آلة JD-3</li>
<li>رفان قياسيان + رف فناجين</li>
<li>خرطوم مدخل الماء وخرطوم الصرف</li>
<li>بطاقة بداية سريعة مع رابط الفيديو التعليمي</li>
<li>دليل التشغيل</li>
<li>شهادة CE</li>
<li><strong>مخطط الدائرة الكهربائية</strong> مثبّت داخل لوحة الصيانة — اتركه هناك للصيانة المستقبلية</li>
</ul>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
