---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBadgeStrip from '../../components/TrustBadgeStrip.astro';
import HeroShowcase from '../../components/HeroShowcase.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import DeliveryBand from '../../components/DeliveryBand.astro';
import PriceCalloutBox from '../../components/PriceCalloutBox.astro';
import CTASection from '../../components/CTASection.astro';
import FAQSection from '../../components/FAQSection.astro';
const locale = 'ar' as const;

const types = [
  { name: 'مخبز', href: '/ar/by-business-type/bakery-shop/', icon: '🥐' },
  { name: 'سلسلة قهوة', href: '/ar/by-business-type/coffee-chain/', icon: '☕' },
  { name: 'باتيسري', href: '/ar/by-business-type/patisserie/', icon: '🧁' },
  { name: 'فندق', href: '/ar/by-business-type/hotel-pastry-kitchen/', icon: '🏨' },
];

const faqs = [
  { q: 'هل تستوعب JD-3 صواني المخابز 600×400 مم فعلاً؟', a: 'نعم — رف 650×550 مم هو الوحيد في فئة السعر هذه يستوعب المعيار الأوروبي. Hobart وJackson وCMA يستخدمون أرفف 500×500 ولا يستوعبون.' },
  { q: 'ما هو الجدول الزمني للتسليم؟', a: '4-6 أسابيع إنتاج في شنتشن، بالإضافة إلى شحن بحري 20-35 يوماً.' },
  { q: 'ما الشهادات؟', a: 'CE للسوق الأوروبي، ISO 9001، تعقيم نهائي بأكثر من 82°C.' },
];
---
<BaseLayout
  title="غسالة صواني المخابز | V-TAI JD-3 تجارية"
  description="غسالة صواني المخابز التي تسدد نفسها في 4 أشهر. تغسل صواني 600×400 مم — الحجم الذي لا تستوعبه معظم الغسالات الأمريكية. معتمدة CE."
  locale={locale}
  canonicalPath="/"
>
<section class="bg-gradient-to-br from-bakery-cream via-white to-bakery-cream/50 section">
  <div class="container-page grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <p class="eyebrow mb-3">V-TAI JD-3 · غسالة بغطاء قبة</p>
      <h1 class="mb-5">غسالة صواني المخابز التي تسدد ثمنها خلال <span class="text-bakery-orange">4 أشهر</span></h1>
      <p class="text-lg text-bakery-navy/80 mb-6 leading-relaxed">
        تغسل صواني المخابز 600×400 مم — المعيار الأوروبي الذي لا تستوعبه معظم الغسالات الأمريكية.
        معتمدة CE، فولاذ مقاوم للصدأ SUS304. <strong>تبدأ من 4,400$ FOB.</strong>
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/ar/get-quote/" class="btn-primary">احصل على عرض سعر</a>
        <a href="/ar/product/" class="btn-secondary">المواصفات</a>
      </div>
    </div>
    <HeroShowcase
      mainAlt="غسالة أطباق بغطاء قبة V-TAI JD-3، منظر أمامي كامل للآلة"
      thumbAlt="ست صواني خبز 600×400 مم محمَّلة عمودياً في رف الغسل لـ JD-3"
      specValue="600×400"
      specLabel="مم صواني ✓"
    />
  </div>
</section>
<TrustBadgeStrip locale={locale} />

<ProductGallery
  title="نظرة عن قرب على JD-3"
  subtitle="صور حقيقية من أرضية المصنع — وليست صوراً مُولّدة. هذه هي الآلة التي ستستلمها."
  items={[
    { img: '/images/jd-3-wash-arms.webp', alt: 'ذراع الغسل الدوّار في JD-3 فوق ست صواني محمَّلة', caption: 'ذراعا غسل دوّاران يصلان كل صينية' },
    { img: '/images/jd-3-circuit-diagram.webp', alt: 'مخطط الأسلاك داخل لوحة خدمة JD-3', caption: 'المخطط الكهربائي يسافر داخل كل آلة' },
    { img: '/images/jd-3-led-control.webp', alt: 'لوحة LED تعرض حرارة الغسل والشطف', caption: 'عرض مباشر لحرارة الغسل والشطف' },
    { img: '/images/factory-production-line.webp', alt: 'خط إنتاج JD-3 في مصنع V-TAI', caption: 'مصنوعة في منشأتنا الخاصة بمساحة 8,000 م²' },
  ]}
/>
<section class="section bg-bakery-cream">
  <div class="container-page">
    <h2 class="text-center mb-10">ما هو نشاطك التجاري؟</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {types.map((bt) => (
        <a href={bt.href} class="card text-center hover:scale-[1.02] transition">
          <div class="text-4xl mb-2">{bt.icon}</div>
          <p class="font-semibold">{bt.name}</p>
        </a>
      ))}
    </div>
  </div>
</section>
<section class="section">
  <div class="container-page grid lg:grid-cols-2 gap-10 items-center">
    <div>
      <h2 class="mb-4">تسعير صادق وشفاف</h2>
      <p class="text-bakery-navy/80 mb-4">تبدأ JD-3 من <strong>4,400$ FOB شنتشن</strong> — بأداء وأمان معادل معتمد CE مقارنة بالعلامات التجارية الفاخرة.</p>
      <ul class="space-y-2 text-bakery-navy/80">
        <li class="flex gap-2 font-bold text-bakery-orange"><span>✓</span> V-TAI JD-3 قياسي: <strong>4,400$ FOB</strong></li>
        <li class="flex gap-2"><span class="text-bakery-orange">✓</span> + موزع تنظيف تلقائي: من 4,600$</li>
        <li class="flex gap-2"><span class="text-bakery-orange">✓</span> + استرداد الحرارة: من 4,900$</li>
      </ul>
    </div>
    <PriceCalloutBox locale={locale} />
  </div>
</section>
<FAQSection items={faqs} title="أسئلة شائعة" />
<DeliveryBand
  eyebrow="توصيل عالمي"
  title="نحن نُعبّئ ونشحن ونخلّص الجمارك — وأنت فقط توصّل الكهرباء"
  lead="كل جهاز JD-3 يغادر المصنع مُعبّأً في قفص خشبي بمعايير التصدير ويسافر بالشحن البحري إلى مينائك. لـ 18 سوقاً رئيسياً نتولّى الرحلة كاملة بسعر DDP واحد: الشحن، التخليص الجمركي، رسوم الاستيراد، والتوصيل حتى بابك."
  points={["تغليف تصدير", "مُخلّص جمركياً (DDP)", "توصيل حتى الباب"]}
  ctaLabel="أسعار DDP حسب الدولة"
  ctaHref="/ar/pricing/by-country/"
/>

<CTASection locale={locale} title="جاهز لإنهاء الغسيل اليدوي؟" subtitle="عرض سعر مخصص خلال 12 ساعة." />
</BaseLayout>
