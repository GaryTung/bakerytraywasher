---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CTASection from '../../components/CTASection.astro';
import { t } from '../../i18n/utils';
const locale = 'ar' as const;
---
<BaseLayout title="الشحن والدفع | JD-3" description="الشحن والدفع V-TAI JD-3." locale={locale} canonicalPath="/shipping-payment/">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/ar/'},{label: 'الشحن والدفع'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">الشحن والدفع</h1>
<h2 class="mt-6 mb-3">الدفع</h2>
<ul class="list-disc list-inside space-y-1">
<li>عربون 30% عند الطلب، 70% رصيد قبل الشحن</li>
<li>TT (تحويل بنكي)، L/C للطلبات > 20,000 دولار</li>
<li>الدولار أساسي؛ يقبل اليورو/الجنيه/الدرهم</li>
</ul>
<h2 class="mt-6 mb-3">الجدول الزمني</h2>
<ul class="list-disc list-inside space-y-1">
<li>الإنتاج: 4 أسابيع</li>
<li>الشحن البحري: 20-35 يوماً</li>
<li>الشحن الجوي: 3-7 أيام</li>
</ul>
<h2 class="mt-6 mb-3">DDP لـ 17 سوقاً</h2>
<p>لـ 17 سوقاً رئيسياً نقدم أسعار DDP بالعملة المحلية. انظر <a href="/ar/pricing/by-country/" class="underline">الأسعار حسب الدولة</a>.</p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
