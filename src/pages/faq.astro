---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
const locale = 'en' as const;

const faqs = [
  { q: 'What is the V-TAI JD-3?', a: 'The JD-3 is a hood-type commercial dishwasher designed specifically for small commercial bakeries, cafés, and pastry kitchens. Model number VT-AE-JD-3.' },
  { q: 'What\'s the price?', a: 'Standard JD-3 starts at $4,400 FOB Shenzhen. With optional accessories (auto detergent dispenser, water treatment, heat recovery), pricing goes up to ~$5,500. See <a href="/pricing/" class="underline">pricing page</a> for details.' },
  { q: 'What makes it different from Hobart, Jackson, or CMA?', a: 'The JD-3\'s 650×550 mm rack fits 600×400 mm European Bakery Norm trays. Hobart AMX, Jackson TempStar, CMA L-1X16-BW all use 500×500 racks that cannot fit these trays. Plus the JD-3 is 30–60% lower cost.' },
  { q: 'Can it ship to my country?', a: 'Yes, we ship globally. See <a href="/pricing/shipping-and-import-cost-by-country/" class="underline">shipping costs by country</a> for estimates.' },
  { q: 'What\'s the lead time?', a: '4–6 weeks production + 20–35 days sea freight (or 3–7 days air freight). Total typical: 8–11 weeks via sea, 5–6 weeks via air.' },
  { q: 'What\'s the warranty?', a: '12-month manufacturer warranty on parts. Spare parts ship globally within 5 business days via DHL/FedEx.' },
  { q: 'What about installation?', a: 'Most small bakeries install the JD-3 in 2–4 hours without major renovation. See <a href="/product/jd-3-installation/" class="underline">installation guide</a>.' },
  { q: 'Will it fit American 18×26" sheet pans?', a: 'Yes — they fit diagonally in the 650×550 chamber.' },
  { q: 'Can I see the spec sheet?', a: 'Yes — see <a href="/product/jd-3-specifications/" class="underline">full specifications</a>. PDF download available on request.' },
  { q: 'What certifications does it have?', a: 'CE Safety certified (EU compliance), ISO 9001 production facility, FDA-compliant materials.' },
  { q: 'Is the JD-3 NSF-listed?', a: 'No — JD-3 is CE-certified but not NSF-listed. CE certification is widely accepted globally including in most US states. Some US franchise chains require NSF specifically; verify with your franchisor.' },
  { q: 'What electrical does it need?', a: '380V three-phase / 50Hz, dedicated 32A breaker, 13 kW total. We offer 220V conversion for single-phase markets — specify in your quote.' },
  { q: 'Can I see it before I buy?', a: 'We can arrange factory tours for buyers visiting Shenzhen, or video walkthroughs via WhatsApp. We do not currently maintain showrooms outside China.' },
  { q: 'Spare parts after the warranty?', a: 'All key components — pumps, heaters, control boards, gaskets — remain stocked at the factory. Same-day shipment of common parts. We commit to parts availability for 7+ years from purchase date.' },
  { q: 'How do I pay?', a: '30% deposit, 70% balance before shipping. TT (wire transfer) or L/C accepted. PayPal/Western Union possible for small orders.' },
  { q: 'Volume discounts?', a: 'Yes — 8% off for 5+ units, 12% off for 10+ units, 15% off for 20+ units.' },
  { q: 'Do you do installation in my country?', a: 'For most major markets we partner with local installers. Outside major markets, we provide remote installation support via WhatsApp video.' },
  { q: 'How long does the machine last?', a: 'Properly maintained, 8–12 years of commercial use. Our oldest deployed JD-3 unit has logged 47,000+ cycles in a school cafeteria with no major service event.' },
  { q: 'Can I get a refund?', a: 'Before production starts: full refund. After production starts: 30% retained. After shipping: not possible (transport is irreversible). We work hard to ensure orders proceed correctly the first time.' },
  { q: 'What if I have a problem after delivery?', a: 'Contact us via WhatsApp or email immediately. We respond within 12 business hours. For warranty issues, we ship replacement parts within 5 business days globally.' },
];
---
<BaseLayout
  title="FAQ — JD-3 Bakery Tray Washer | bakerytraywasher.com"
  description="Common questions about the V-TAI JD-3 bakery tray washer: price, specifications, shipping, warranty, installation, and more."
  locale={locale}
  canonicalPath="/faq/"
  schemaType="FAQPage"
  schemaData={{
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
    })),
  }}
>
<BreadcrumbNav items={[{label: 'Home', href: '/'}, {label: 'FAQ'}]} />

<section class="section">
  <div class="container-prose">
    <h1 class="mb-4 text-center">Frequently Asked Questions</h1>
    <p class="text-center text-bakery-navy/70 mb-6">Twenty common questions from bakery owners, café operators, and hotel pastry chefs.</p>
  </div>
</section>

<FAQSection items={faqs} title="" />

<CTASection locale={locale} />
</BaseLayout>
