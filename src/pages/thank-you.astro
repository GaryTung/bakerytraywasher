---
import BaseLayout from '../layouts/BaseLayout.astro';
const locale = 'en' as const;
---
<BaseLayout
  title="Thank You — Quote Request Received | bakerytraywasher.com"
  description="Thank you for your quote request. We respond within 12 business hours via WhatsApp or email."
  locale={locale}
  canonicalPath="/thank-you/"
  noindex={true}
  schemaType="Organization"
>
<section class="section">
  <div class="container-page max-w-2xl text-center">
    <div class="w-20 h-20 rounded-full bg-green-100 text-green-600 flex items-center justify-center mx-auto mb-6">
      <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
    </div>
    <h1 class="mb-4">Thank You. Your Quote Request Is In.</h1>
    <p class="text-lg text-bakery-navy/80 mb-3">We respond within <strong>12 business hours</strong> via WhatsApp or email.</p>
    <p class="text-bakery-navy/70 mb-8">For faster response, message us directly on WhatsApp:</p>
    <a href="https://wa.me/8613509623269" class="btn-primary mb-8">WhatsApp +86 135 0962 3269</a>

    <h2 class="mt-12 mb-4">While You Wait</h2>
    <p class="text-bakery-navy/70 mb-6">Here are resources that might help your evaluation:</p>
    <div class="grid sm:grid-cols-2 gap-4 text-left">
      <a href="/pricing/" class="card hover:scale-[1.02] transition">
        <h3 class="text-lg mb-1">JD-3 Pricing</h3>
        <p class="text-sm text-bakery-navy/70">All configurations and price tiers.</p>
      </a>
      <a href="/vs/" class="card hover:scale-[1.02] transition">
        <h3 class="text-lg mb-1">Comparisons</h3>
        <p class="text-sm text-bakery-navy/70">vs Hobart, Jackson, CMA, Winterhalter.</p>
      </a>
      <a href="/case-studies/" class="card hover:scale-[1.02] transition">
        <h3 class="text-lg mb-1">Case Studies</h3>
        <p class="text-sm text-bakery-navy/70">Real bakeries, real ROI numbers.</p>
      </a>
      <a href="/guides/600x400-bakery-norm-explained/" class="card hover:scale-[1.02] transition">
        <h3 class="text-lg mb-1">Guides</h3>
        <p class="text-sm text-bakery-navy/70">Bakery tray washing best practices.</p>
      </a>
    </div>
  </div>
</section>
</BaseLayout>
