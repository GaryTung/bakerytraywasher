---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'zh' as const;
const rows = [{ label: 'ถาด 600×400', jd3: '✓', competitor: '✗', highlight: true }];
---
<BaseLayout title="JD-3 vs CMA L-1X16-BW" description="เปรียบเทียบ JD-3 vs CMA" locale={locale} canonicalPath="/product/jd-3-vs-cma-l-1x16-bw/" schemaType="Article">
<BreadcrumbNav items={[{label:'หน้าแรก',href:'/zh/'},{label:'vs CMA'}]} />
<section class="section"><div class="container-prose"><h1>JD-3 vs CMA L-1X16-BW</h1><p class="text-lg mt-4 mb-6">CMA ใช้แร็ค 500×500 ที่ไม่รองรับ 600×400 JD-3 รองรับ</p></div>
<div class="container-page"><ComparisonTable competitorName="CMA L-1X16-BW" rows={rows} /></div></section>
<CTASection locale={locale} />
</BaseLayout>
