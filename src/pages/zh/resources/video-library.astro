---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'zh' as const;
---
<BaseLayout title="视频资源库 | JD-3" description="视频资源库" locale={locale} canonicalPath="/resources/video-library/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/zh/'},{label: t(locale,'nav.resources'), href:'/zh/resources/'},{label: "视频资源库"}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">视频资源库</h1>
<p class="text-lg mb-6 text-bakery-navy/70">此页面有英文完整版本可供下载：</p>
<p><a href="/resources/video-library/" class="btn-primary inline-block">视频资源库（英文）→</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
