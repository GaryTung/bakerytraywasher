---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'zh' as const;
---
<BaseLayout title="600×400 mm 欧标烤盘解读 | V-TAI 博客" description="DIN 18876 / EN 631 标准的由来，以及为什么 Rational / Convotherm / Unox 蒸烤箱都按这个尺寸设计。" locale={locale} canonicalPath="/blog/600x400-tray-norm-explained/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/zh/' },
  { label: t(locale, 'nav.blog'), href: '/zh/blog/' },
  { label: "600×400 mm 欧标烤盘解读" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">600×400 mm 欧标烤盘解读</h1>
<p class="text-lg mb-6 text-bakery-navy/80">DIN 18876 / EN 631 标准的由来，以及为什么 Rational / Convotherm / Unox 蒸烤箱都按这个尺寸设计。</p>
<p class="mt-4"><a href="/zh/guides/600x400-bakery-norm-explained/" class="btn-primary inline-block">阅读完整指南：600×400 mm 烘焙欧标 →</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
