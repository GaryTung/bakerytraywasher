---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'zh' as const;
---
<BaseLayout title="曼谷 DDP 成本拆解（泰语市场文章） | V-TAI 博客" description="本文针对泰国曼谷 DDP 进口成本撰写。新加坡、马来西亚、香港的 DDP 报价请参见各国到岸价页面。" locale={locale} canonicalPath="/blog/ddp-bangkok-cost-breakdown/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/zh/' },
  { label: t(locale, 'nav.blog'), href: '/zh/blog/' },
  { label: "曼谷 DDP 成本拆解（泰语市场文章）" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">曼谷 DDP 成本拆解（泰语市场文章）</h1>
<p class="text-lg mb-6 text-bakery-navy/80">本文针对泰国曼谷 DDP 进口成本撰写。新加坡、马来西亚、香港的 DDP 报价请参见各国到岸价页面。</p>
<p class="mt-4"><a href="/zh/pricing/by-country/" class="btn-primary inline-block">查看 18 国 DDP 到岸价 →</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
