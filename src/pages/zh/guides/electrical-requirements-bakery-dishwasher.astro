---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'zh' as const;
---
<BaseLayout title="烘焙洗碗机的电气要求 | V-TAI JD-3 选购指南" description="380V 三相 vs 400V 单相、断路器规格、专用回路要求，以及新加坡、马来西亚、香港、台湾、美国、欧盟的电源差异。" locale={locale} canonicalPath="/guides/electrical-requirements-bakery-dishwasher/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/zh/' },
  { label: t(locale, 'nav.guides'), href: '/zh/guides/' },
  { label: "烘焙洗碗机的电气要求" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">烘焙洗碗机的电气要求</h1>
<p class="text-lg mb-6 text-bakery-navy/80">380V 三相 vs 400V 单相、断路器规格、专用回路要求，以及新加坡、马来西亚、香港、台湾、美国、欧盟的电源差异。</p>
<p class="text-bakery-navy/70">完整长文版本正在翻译中。同时您可阅读英文完整版（含图表、计算示例与可下载表格）：</p>
<p class="mt-4"><a href="/guides/electrical-requirements-bakery-dishwasher/" class="btn-primary inline-block">烘焙洗碗机的电气要求（英文完整版）→</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
