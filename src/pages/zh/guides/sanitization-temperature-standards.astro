---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'zh' as const;
---
<BaseLayout title="มาตรฐานอุณหภูมิการฆ่าเชื้อ | JD-3" description="มาตรฐานอุณหภูมิการฆ่าเชื้อ" locale={locale} canonicalPath="/guides/sanitization-temperature-standards/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/zh/' },
  { label: t(locale, 'nav.guides') },
  { label: "มาตรฐานอุณหภูมิการฆ่าเชื้อ" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">มาตรฐานอุณหภูมิการฆ่าเชื้อ</h1>
<p class="text-lg mb-6">คู่มือปฏิบัติสำหรับผู้ประกอบการเบเกอรี่ที่ใช้ V-TAI JD-3</p>
<p class="text-bakery-navy/70"><a href="/guides/sanitization-temperature-standards/" class="underline">ดูฉบับเต็มภาษาอังกฤษ</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
