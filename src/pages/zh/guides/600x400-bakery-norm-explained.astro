---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'zh' as const;
---
<BaseLayout title="อธิบายมาตรฐานถาดเบเกอรี่ 600×400 มม. | JD-3" description="อธิบายมาตรฐานถาดเบเกอรี่ 600×400 มม." locale={locale} canonicalPath="/guides/600x400-bakery-norm-explained/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/zh/' },
  { label: t(locale, 'nav.guides') },
  { label: "อธิบายมาตรฐานถาดเบเกอรี่ 600×400 มม." }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">อธิบายมาตรฐานถาดเบเกอรี่ 600×400 มม.</h1>
<p class="text-lg mb-6">คู่มือปฏิบัติสำหรับผู้ประกอบการเบเกอรี่ที่ใช้ V-TAI JD-3</p>
<p class="text-bakery-navy/70"><a href="/guides/600x400-bakery-norm-explained/" class="underline">ดูฉบับเต็มภาษาอังกฤษ</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
