---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'zh' as const;
---
<BaseLayout title="600×400 mm 烘焙欧标：DIN 18876 与 EN 631 详解 | V-TAI JD-3 选购指南" description="从 1960 年代的德国 DIN 标准，到今天 Rational、Convotherm、Unox 蒸烤箱的统一规格 — 为什么这个数字主宰了现代商用烘焙。" locale={locale} canonicalPath="/guides/600x400-bakery-norm-explained/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/zh/' },
  { label: t(locale, 'nav.guides'), href: '/zh/guides/' },
  { label: "600×400 mm 烘焙欧标：DIN 18876 与 EN 631 详解" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">600×400 mm 烘焙欧标：DIN 18876 与 EN 631 详解</h1>
<p class="text-lg mb-6 text-bakery-navy/80">从 1960 年代的德国 DIN 标准，到今天 Rational、Convotherm、Unox 蒸烤箱的统一规格 — 为什么这个数字主宰了现代商用烘焙。</p>
<p class="text-bakery-navy/70">完整长文版本正在翻译中。同时您可阅读英文完整版（含图表、计算示例与可下载表格）：</p>
<p class="mt-4"><a href="/guides/600x400-bakery-norm-explained/" class="btn-primary inline-block">600×400 mm 烘焙欧标：DIN 18876 与 EN 631 详解（英文完整版）→</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
