---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'zh' as const;
---
<BaseLayout title="ต้นทุนจริงของการล้างมือ | JD-3" description="ต้นทุนจริงของการล้างมือ" locale={locale} canonicalPath="/guides/cost-of-manual-tray-cleaning/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/zh/' },
  { label: t(locale, 'nav.guides') },
  { label: "ต้นทุนจริงของการล้างมือ" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">ต้นทุนจริงของการล้างมือ</h1>
<p class="text-lg mb-6">คู่มือปฏิบัติสำหรับผู้ประกอบการเบเกอรี่ที่ใช้ V-TAI JD-3</p>
<p class="text-bakery-navy/70"><a href="/guides/cost-of-manual-tray-cleaning/" class="underline">ดูฉบับเต็มภาษาอังกฤษ</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
