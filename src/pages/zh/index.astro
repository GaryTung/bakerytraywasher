---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBadgeStrip from '../../components/TrustBadgeStrip.astro';
import HeroShowcase from '../../components/HeroShowcase.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import DeliveryBand from '../../components/DeliveryBand.astro';
import YouTubeShort from '../../components/YouTubeShort.astro';
import PriceCalloutBox from '../../components/PriceCalloutBox.astro';
import CTASection from '../../components/CTASection.astro';
import FAQSection from '../../components/FAQSection.astro';

const locale = 'zh' as const;

const businessTypes = [
  { name: '面包店',         href: '/zh/by-business-type/bakery-shop/',         icon: '🥐' },
  { name: '咖啡连锁',       href: '/zh/by-business-type/coffee-chain/',        icon: '☕' },
  { name: '法式甜品店',     href: '/zh/by-business-type/patisserie/',          icon: '🧁' },
  { name: '蛋糕店',         href: '/zh/by-business-type/cake-shop/',           icon: '🎂' },
  { name: '小型餐厅',       href: '/zh/by-business-type/small-restaurant/',    icon: '🍽️' },
  { name: '员工食堂',       href: '/zh/by-business-type/cafeteria/',           icon: '🥪' },
  { name: '酒店西点房',     href: '/zh/by-business-type/hotel-pastry-kitchen/', icon: '🏨' },
  { name: '中央厨房',         href: '/zh/by-business-type/cloud-kitchen/',       icon: '👨‍🍳' },
];

const faqs = [
  { q: 'JD-3 真的能洗 600×400 mm 烤盘吗？', a: '可以。这是这个价位段唯一一台 650×550 mm 内筐的揭盖式机器。Hobart、Jackson、CMA 同价位机型都是 500×500 洗碗筐，装不下 600×400 mm 烤盘。' },
  { q: '生产到交货要多久？', a: '广东肇庆生产 4 周 + 海运 20–35 天，全程 8 周送达新加坡 / 马来西亚 / 香港 / 台湾。东南亚海运较快，欧美时间长一些。' },
  { q: '可以洗中式器具吗？', a: '可以洗大型不锈钢炒锅（直径 28 cm 内）、汤桶、蒸笼托盘。中式深炒锅需斜放，建议下单前发图片给我们确认尺寸。' },
  { q: '在新加坡和马来西亚有保修吗？', a: '12 个月零件保修，通过国际快递全球发货。设备内置电路图，本地电工即可诊断与更换零件。' },
  { q: '我能买二手设备吗？', a: '我们不卖二手，但我们的新机广东交货价 4,400 美元起，比同等 CE 认证的二手高端品牌还便宜。性价比远胜二手设备。' },
];
---
<BaseLayout
  title="烘焙烤盘清洗机 | V-TAI JD-3 商用烤盘清洗机"
  description="4 个月回本的烘焙烤盘清洗机。可洗 600×400 mm 烤盘 — 大多数美式洗碗机装不下的尺寸。CE 认证，深圳 FOB 价 4,400 美元起。专为新加坡、马来西亚、海外华人市场。"
  locale={locale}
  canonicalPath="/"
>
<section class="bg-gradient-to-br from-bakery-cream via-white to-bakery-cream/50 section">
  <div class="container-page grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <p class="eyebrow mb-3">V-TAI JD-3 · 揭盖式商用烤盘清洗机</p>
      <h1 class="mb-5">4 个月回本的<span class="text-bakery-orange">烘焙烤盘清洗机</span></h1>
      <p class="text-lg text-bakery-navy/80 mb-6 leading-relaxed">
        可洗 600×400 mm 欧标烤盘 — 多数同价位洗碗机装不下的标准尺寸。CE 认证，
        SUS304 食品级不锈钢，<strong>深圳 FOB 起价 4,400 美元</strong>。专为新加坡、马来西亚以及海外华人市场量身打造。
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/zh/get-quote/" class="btn-primary">获取报价</a>
        <a href="/zh/product/" class="btn-secondary">查看规格</a>
      </div>
    </div>
    <HeroShowcase
      mainAlt="V-TAI JD-3 揭盖式商用烤盘清洗机整机正面图"
      thumbAlt="JD-3 内筐竖向装载六个 600×400 mm 烤盘"
      specValue="600×400"
      specLabel="mm 烤盘 ✓"
    />
  </div>
</section>

<TrustBadgeStrip locale={locale} />

<ProductGallery
  title="近距离看看 JD-3"
  subtitle="全部为工厂车间实拍，非效果图。您收到的就是这台机器。"
  items={[
    { img: '/images/jd-3-wash-arms.webp', alt: 'JD-3 旋转喷淋臂在六个已装载烤盘上方喷淋', caption: '上下双旋转喷淋臂，覆盖每个烤盘' },
    { img: '/images/jd-3-circuit-diagram.webp', alt: 'JD-3 维修面板内的接线电路图', caption: '电路图随每台机器内附' },
    { img: '/images/jd-3-led-control.webp', alt: 'LED 控制面板显示主洗与终洗水温', caption: '实时显示主洗与终洗水温' },
    { img: '/images/factory-production-line.webp', alt: 'V-TAI 工厂 JD-3 生产线', caption: '在我们自有的 8,000 ㎡ 工厂生产' },
  ]}
/>

<section class="section bg-bakery-cream">
  <div class="container-page">
    <h2 class="text-center mb-3">您的业务类型是？</h2>
    <p class="text-center text-bakery-navy/70 max-w-2xl mx-auto mb-10">选择您的实际经营场景，看看 JD-3 如何匹配您的运营节奏。</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {businessTypes.map((bt) => (
        <a href={bt.href} class="card text-center hover:scale-[1.02] transition">
          <div class="text-4xl mb-2">{bt.icon}</div>
          <p class="font-semibold">{bt.name}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container-page grid lg:grid-cols-2 gap-10 items-center">
    <div>
      <h2 class="mb-4">透明定价，明明白白</h2>
      <p class="text-bakery-navy/80 mb-4">JD-3 价格为 <strong>USD4,400 深圳交货价</strong> — 同等 CE 认证下，价格仅为欧美高端品牌的零头。</p>
      <ul class="space-y-2 text-bakery-navy/80">
        <li class="flex gap-2 font-bold text-bakery-orange"><span>✓</span> V-TAI JD-3 标准型：<strong>USD4,400</strong></li>
        <li class="flex gap-2"><span class="text-bakery-orange">✓</span> + V-TAI JD-3 内置自动洗涤剂分配器：USD4,600</li>
        <li class="flex gap-2"><span class="text-bakery-orange">✓</span> + V-TAI JD-3 带热回收升级版：USD4,900</li>
      </ul>
      <p class="mt-4 text-sm text-bakery-navy/60">为方便比较，我们公开了 <a href="/zh/pricing/by-country/" class="underline">17 个国家的送货上门价</a>（含运费、关税、当地税、当地派送费）。</p>
    </div>
    <PriceCalloutBox locale={locale} />
  </div>
</section>

<section class="section bg-bakery-cream">
  <div class="container-page text-center">
    <h2 class="mb-3">30 秒看 JD-3 实机运行</h2>
    <p class="text-bakery-navy/70 max-w-2xl mx-auto mb-2">收货、接水接电、第一次清洗 — JD-3 设计为可在商用厨房自行安装。</p>
    <YouTubeShort videoId="bjxEYRiRTnI" title="JD-3 商用洗碗机安装指南" />
  </div>
</section>

<FAQSection items={faqs} title="常见问题" />

<DeliveryBand
  eyebrow="全球交付"
  title="我们打包、海运、清关 —— 您只需接上水电"
  lead="每台 JD-3 出厂即按出口标准打木箱，海运直达您所在港口。针对 17 个主要市场，我们用一个 DDP 到岸价承包全程：海运、清关、进口关税，以及最后一公里送货上门。"
  points={["出口级木箱包装", "全程清关（DDP）", "送货上门到家门口"]}
  ctaLabel="查看各国 DDP 到岸价"
  ctaHref="/zh/pricing/by-country/"
/>

<CTASection locale={locale} title="准备好告别手洗烤盘了吗？" subtitle="12 小时内为您定制报价。" />
</BaseLayout>
