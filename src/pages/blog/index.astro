---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CTASection from '../../components/CTASection.astro';

const locale = 'en' as const;
const posts = [
  { slug: 'bakery-tray-washer-sample-wash-test', title: 'How to Test a Bakery Tray Washer Before You Buy: A Sample-Wash Acceptance Checklist', desc: 'Use your own dirtiest trays to define a controlled sample-wash test, observable pass criteria, evidence to request, and demonstration red flags.', date: '2026-08-19' },
  {
    slug: 'bakery-tray-washer-capacity-calculator',
    title: 'How Many Trays Can a Bakery Tray Washer Handle? A Capacity Calculator for Real Production',
    desc: 'Turn daily tray volume into required cycles, machine minutes, and a realistic cleaning window using the verified JD-3 capacity of 6 standard trays per 2-minute cycle. Explains why 180 trays/hour is a technical ceiling, not a shift promise.',
    date: '2026-08-19',
  },
  {
    slug: 'commercial-dishwasher-running-cost',
    title: "What Does a Commercial Bakery Dishwasher Actually Cost to Run? Per-Cycle, Per-Day, and Per-Year",
    desc: "Buyers obsess over the purchase price and forget the running cost. A commercial bakery dishwasher has four operating costs — water, electricity, detergent, descaling — and only one is large. The honest, physics-based method to estimate each at your own rates, a worked example for a 150-tray café, and the five levers that cut the bill.",
    date: '2026-06-24',
  },
  {
    slug: '600x400-tray-washer-for-small-bakeries',
    title: "Too Big for a Dishwasher, Too Small for a Tunnel Washer: The 600×400 Baking-Tray Problem",
    desc: "600×400 mm trays don't fit a standard dishwasher's 500×500 rack, but a tunnel tray washer needs 3–6 m of floor you don't have. The JD-3 is built for the gap: a 0.65 m² footprint that fits where a prep table goes, a 650×550 rack for six trays a cycle, plus dual wash arms and an ≥82°C rinse to actually clean baked-on residue.",
    date: '2026-06-18',
  },
  {
    slug: 'commercial-dishwasher-maintenance-schedule',
    title: "The Commercial Bakery Dishwasher Maintenance Schedule: Daily, Weekly, and Monthly Tasks for a 10-Year Machine",
    desc: "A commercial bakery dishwasher should last 8–12 years — but only if it's maintained. The biggest killer is limescale on the heating element, and it's entirely preventable. The full daily/weekly/monthly/quarterly schedule, the five-minute end-of-shift routine that does 80% of the work, and how water hardness sets your descaling interval.",
    date: '2026-06-13',
  },
  {
    slug: 'commercial-dishwasher-faults-electrician-diagnose-circuit-diagram',
    title: "Seven Commercial Dishwasher Faults a Local Electrician Can Diagnose Using the Built-in Circuit Diagram",
    desc: "Most specialist service calls cost US$250–$800 before a single component is touched. For the seven faults that drive 80% of breakdowns, a regular licensed electrician with the laminated diagram inside the panel can isolate the cause in 30–90 minutes. Walks through each with the component reference designators, expected voltages, and resistance values.",
    date: '2026-06-10',
  },
  {
    slug: 'pre-installation-checklist-commercial-dishwasher',
    title: "The Pre-Installation Checklist Most Bakeries Skip — What You Should Have Ready Before Your Commercial Dishwasher Arrives",
    desc: "Eight site-readiness items most operators forget — electrical (32 A type-C, RCD), water, drain, ventilation, floor, clearance, hot-water decision, isolated circuit — with the exact numbers your local electrician and plumber need before delivery day.",
    date: '2026-06-08',
  },
  {
    slug: 'chemistry-of-washing-bakery-trays',
    title: "The Hidden Chemistry of Washing a Bakery Tray — Why Some Methods Leave Residue and Others Don't",
    desc: "A bakery tray is not a dinner plate. Four distinct residue types — caramelized sugar, polymerized fat, baked egg wash, fermented dough crumb — each follow different chemistry. A manufacturer's field protocol.",
    date: '2026-06-05',
  },
  {
    slug: 'five-failure-modes-commercial-dishwasher',
    title: "Five Ways a Commercial Dishwasher Actually Dies",
    desc: "Pump bearings, heating-element scale, control-board moisture, gasket degradation, drain impeller wear — and what to ask before you buy.",
    date: '2026-05-15',
  },
  { slug: 'residential-dishwasher-for-commercial-bakery', title: 'Can You Use a Residential Dishwasher in a Commercial Bakery?', desc: 'FDA Food Code 4-501.112, NSF/ANSI 3 temperatures, real lifespan numbers, and the 24-month math.', date: '2026-04-15' },
  { slug: 'why-your-bakery-needs-a-tray-washer', title: 'Why Your Bakery Needs a Tray Washer (Even If You\'ve Survived Without One)', desc: 'The argument for buying a commercial dishwasher even when hand-washing has "worked fine" so far.', date: '2026-01-15' },
  { slug: '600x400-tray-size-history-and-standard', title: 'The 600×400 Tray Size — A Brief History of the Bakery Norm', desc: 'How a German industrial standard became the global default for professional bakeries.', date: '2026-01-22' },
  { slug: 'dishwasher-roi-for-small-bakery', title: 'Dishwasher ROI for a Small Bakery — Concrete Numbers', desc: 'The actual math: capex, opex, labor savings, payback. With a downloadable spreadsheet.', date: '2026-01-29' },
];
---
<BaseLayout
  title="Blog — Bakery Tray Washer Insights | bakerytraywasher.com"
  description="Articles on bakery operations, commercial dishwashing economics, the 600×400 tray standard, and ROI math for small bakery owners."
  locale={locale}
  canonicalPath="/blog/"
  schemaType="Article"
>
<BreadcrumbNav items={[{label: 'Home', href: '/'}, {label: 'Blog'}]} />

<section class="section">
  <div class="container-page">
    <h1 class="mb-4 text-center">Bakery Tray Washer Blog</h1>
    <p class="text-bakery-navy/70 text-lg max-w-2xl mx-auto text-center mb-10">
      Practical writing for bakery owners and small commercial kitchen operators.
    </p>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {posts.map((p) => (
        <a href={`/blog/${p.slug}/`} class="card hover:scale-[1.02] transition">
          <p class="text-xs text-bakery-navy/50 mb-2">{p.date}</p>
          <h3 class="mb-3">{p.title}</h3>
          <p class="text-bakery-navy/70 text-sm">{p.desc}</p>
          <p class="text-bakery-orange text-sm mt-3 font-semibold">Read article →</p>
        </a>
      ))}
    </div>
  </div>
</section>

<CTASection locale={locale} />
</BaseLayout>
