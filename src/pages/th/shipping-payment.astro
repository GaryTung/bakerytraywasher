---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CTASection from '../../components/CTASection.astro';
import { t } from '../../i18n/utils';
const locale = 'th' as const;
---
<BaseLayout title="การจัดส่งและการชำระเงิน | JD-3" description="การจัดส่งและการชำระเงิน V-TAI JD-3." locale={locale} canonicalPath="/shipping-payment/">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/th/'},{label: 'การจัดส่งและการชำระเงิน'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">การจัดส่งและการชำระเงิน</h1>
<h2 class="mt-6 mb-3">การชำระเงิน</h2>
<ul class="list-disc list-inside space-y-1">
<li>มัดจำ 30% เมื่อสั่ง, ยอดคงเหลือ 70% ก่อนส่ง</li>
<li>TT (โอนเงินผ่านธนาคาร), L/C สำหรับคำสั่งซื้อ > $20,000</li>
<li>USD เป็นหลัก; รับ EUR/GBP/AED</li>
</ul>
<h2 class="mt-6 mb-3">ระยะเวลา</h2>
<ul class="list-disc list-inside space-y-1">
<li>การผลิต: 4 สัปดาห์</li>
<li>การขนส่งทางทะเล: 20–35 วัน</li>
<li>การขนส่งทางอากาศ: 3–7 วัน</li>
</ul>
<h2 class="mt-6 mb-3">DDP สำหรับ 17 ตลาด</h2>
<p>สำหรับ 17 ตลาดหลัก เรามีราคา DDP ในสกุลเงินท้องถิ่น ดูที่ <a href="/th/pricing/by-country/" class="underline">ราคาตามประเทศ</a>.</p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
