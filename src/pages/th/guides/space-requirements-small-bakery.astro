---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'th' as const;
---
<BaseLayout title="ข้อกำหนดพื้นที่สำหรับเบเกอรี่ขนาดเล็ก | JD-3" description="ข้อกำหนดพื้นที่สำหรับเบเกอรี่ขนาดเล็ก" locale={locale} canonicalPath="/guides/space-requirements-small-bakery/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/th/' },
  { label: t(locale, 'nav.guides') },
  { label: "ข้อกำหนดพื้นที่สำหรับเบเกอรี่ขนาดเล็ก" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">ข้อกำหนดพื้นที่สำหรับเบเกอรี่ขนาดเล็ก</h1>
<p class="text-lg mb-6">คู่มือปฏิบัติสำหรับผู้ประกอบการเบเกอรี่ที่ใช้ V-TAI JD-3</p>
<p class="text-bakery-navy/70"><a href="/guides/space-requirements-small-bakery/" class="underline">ดูฉบับเต็มภาษาอังกฤษ</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
