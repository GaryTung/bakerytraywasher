---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'th' as const;
---
<BaseLayout title="วิธีเลือกเครื่องล้างถาดเบเกอรี่ | JD-3" description="วิธีเลือกเครื่องล้างถาดเบเกอรี่" locale={locale} canonicalPath="/guides/how-to-choose-bakery-tray-washer/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/th/' },
  { label: t(locale, 'nav.guides') },
  { label: "วิธีเลือกเครื่องล้างถาดเบเกอรี่" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">วิธีเลือกเครื่องล้างถาดเบเกอรี่</h1>
<p class="text-lg mb-6">คู่มือปฏิบัติสำหรับผู้ประกอบการเบเกอรี่ที่ใช้ V-TAI JD-3</p>
<p class="text-bakery-navy/70"><a href="/guides/how-to-choose-bakery-tray-washer/" class="underline">ดูฉบับเต็มภาษาอังกฤษ</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
