import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'th' as const;
---
<BaseLayout title="เครื่องคำนวณ ROI ฟรี | JD-3" description="เครื่องคำนวณ ROI ฟรี" locale={locale} canonicalPath="/resources/free-roi-calculator/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/th/'},{label: t(locale,'nav.resources'), href:'/th/resources/'},{label: 'เครื่องคำนวณ ROI ฟรี'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">เครื่องคำนวณ ROI ฟรี</h1>
<p class="text-lg mb-6 text-bakery-navy/70">หน้านี้มีให้บริการเป็นภาษาอังกฤษ:</p>
<p><a href="/resources/free-roi-calculator/" class="btn-primary inline-block">เครื่องคำนวณ ROI ฟรี (EN) →</a></p>
</div></section>
<CTASection locale={locale} />
