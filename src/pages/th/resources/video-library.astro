---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'th' as const;
---
<BaseLayout title="คลังวิดีโอ | JD-3" description="คลังวิดีโอ" locale={locale} canonicalPath="/resources/video-library/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/th/'},{label: t(locale,'nav.resources'), href:'/th/resources/'},{label: 'คลังวิดีโอ'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">คลังวิดีโอ</h1>
<p class="text-lg mb-6 text-bakery-navy/70">หน้านี้มีให้บริการเป็นภาษาอังกฤษ:</p>
<p><a href="/resources/video-library/" class="btn-primary inline-block">คลังวิดีโอ (EN) →</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
