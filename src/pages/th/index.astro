---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBadgeStrip from '../../components/TrustBadgeStrip.astro';
import HeroShowcase from '../../components/HeroShowcase.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import DeliveryBand from '../../components/DeliveryBand.astro';
import PriceCalloutBox from '../../components/PriceCalloutBox.astro';
import CTASection from '../../components/CTASection.astro';
import FAQSection from '../../components/FAQSection.astro';
const locale = 'th' as const;

const types = [
  { name: 'ร้านเบเกอรี่', href: '/th/by-business-type/bakery-shop/', icon: '🥐' },
  { name: 'เครือคาเฟ่', href: '/th/by-business-type/coffee-chain/', icon: '☕' },
  { name: 'ร้านขนมหวาน', href: '/th/by-business-type/patisserie/', icon: '🧁' },
  { name: 'ร้านเค้ก', href: '/th/by-business-type/cake-shop/', icon: '🎂' },
  { name: 'ร้านอาหาร', href: '/th/by-business-type/small-restaurant/', icon: '🍽️' },
  { name: 'โรงแรม', href: '/th/by-business-type/hotel-pastry-kitchen/', icon: '🏨' },
];

const faqs = [
  { q: 'JD-3 รองรับถาด 600×400 มม. ได้จริงหรือ?', a: 'ใช่ — แร็ค 650×550 มม. เป็นเครื่องล้างแบบกระโจมเดียวในระดับราคานี้ที่รองรับมาตรฐานยุโรป' },
  { q: 'ระยะเวลาส่งมอบ?', a: '4-6 สัปดาห์การผลิต + การขนส่งทางทะเล 20-35 วัน' },
];
---
<BaseLayout
  title="เครื่องล้างถาดเบเกอรี่ | V-TAI JD-3 เชิงพาณิชย์"
  description="เครื่องล้างถาดเบเกอรี่ที่คืนทุนภายใน 4 เดือน ล้างถาด 600×400 มม. — ขนาดที่เครื่องล้างจานอเมริกันส่วนใหญ่ไม่รองรับ มาตรฐาน CE เริ่มต้นที่ $4,400 FOB"
  locale={locale}
  canonicalPath="/"
>
<section class="bg-gradient-to-br from-bakery-cream via-white to-bakery-cream/50 section">
  <div class="container-page grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <p class="eyebrow mb-3">V-TAI JD-3 · เครื่องล้างแบบกระโจมสำหรับเบเกอรี่</p>
      <h1 class="mb-5">เครื่องล้างถาดเบเกอรี่ที่คืนทุนใน <span class="text-bakery-orange">4 เดือน</span></h1>
      <p class="text-lg mb-6">ล้างถาด 600×400 มม. — มาตรฐานยุโรปที่เครื่องล้างจานอเมริกันส่วนใหญ่ไม่รองรับ มาตรฐาน CE สแตนเลส SUS304 <strong>เริ่มต้นที่ $4,400 FOB เซินเจิ้น</strong></p>
      <div class="flex flex-wrap gap-3">
        <a href="/th/get-quote/" class="btn-primary">ขอใบเสนอราคา</a>
        <a href="/th/product/" class="btn-secondary">ดูสเปค</a>
      </div>
    </div>
    <HeroShowcase
      mainAlt="เครื่องล้างจานแบบกระโจม V-TAI JD-3 มุมมองด้านหน้าเต็มเครื่อง"
      thumbAlt="ถาดอบขนาด 600×400 มม. หกถาดวางตั้งในแร็คของ JD-3"
      specValue="600×400"
      specLabel="มม. ถาด ✓"
    />
  </div>
</section>
<TrustBadgeStrip locale={locale} />

<ProductGallery
  title="ดู JD-3 ใกล้ ๆ"
  subtitle="ภาพถ่ายจริงจากโรงงาน ไม่ใช่ภาพเรนเดอร์ นี่คือเครื่องที่คุณจะได้รับ"
  items={[
    { img: '/images/jd-3-wash-arms.webp', alt: 'แขนฉีดน้ำหมุนของ JD-3 เหนือถาดหกใบที่วางในแร็ค', caption: 'แขนฉีดน้ำหมุนคู่ ครอบคลุมทุกถาด' },
    { img: '/images/jd-3-circuit-diagram.webp', alt: 'แผนผังวงจรภายในแผงบริการของ JD-3', caption: 'แผนผังวงจรอยู่ในเครื่องทุกเครื่อง' },
    { img: '/images/jd-3-led-control.webp', alt: 'แผง LED แสดงอุณหภูมิน้ำล้างและน้ำสุดท้าย', caption: 'แสดงอุณหภูมิน้ำล้างและน้ำสุดท้ายแบบเรียลไทม์' },
    { img: '/images/factory-production-line.webp', alt: 'สายการผลิต JD-3 ที่โรงงาน V-TAI', caption: 'ผลิตในโรงงานของเราเองขนาด 8,000 ตร.ม.' },
  ]}
/>
<section class="section bg-bakery-cream"><div class="container-page">
<h2 class="text-center mb-10">ธุรกิจของคุณคืออะไร?</h2>
<div class="grid grid-cols-2 md:grid-cols-3 gap-4">
{types.map((bt) => (<a href={bt.href} class="card text-center"><div class="text-4xl mb-2">{bt.icon}</div><p class="font-semibold">{bt.name}</p></a>))}
</div></div></section>
<section class="section"><div class="container-page grid lg:grid-cols-2 gap-10 items-center">
<div>
<h2 class="mb-4">ราคาตรงไปตรงมา โปร่งใส</h2>
<p class="text-bakery-navy/80 mb-4">JD-3 เริ่มต้นที่ <strong>$4,400 FOB เซินเจิ้น</strong> — ประสิทธิภาพและความปลอดภัยที่ได้รับการรับรอง CE เทียบเท่าแบรนด์พรีเมียม</p>
</div>
<PriceCalloutBox locale={locale} />
</div></section>
<FAQSection items={faqs} title="คำถามที่พบบ่อย" />
<DeliveryBand
  eyebrow="จัดส่งทั่วโลก"
  title="เราตีลัง ขนส่ง และเคลียร์ศุลกากรให้ — คุณแค่เสียบใช้งาน"
  lead="JD-3 ทุกเครื่องออกจากโรงงานพร้อมลังไม้มาตรฐานส่งออก และขนส่งทางทะเลถึงท่าเรือของคุณ สำหรับ 17 ตลาดหลัก เราดูแลตลอดเส้นทางในราคา DDP เดียว: ค่าระวาง พิธีการศุลกากร ภาษีนำเข้า และส่งถึงหน้าประตูคุณ"
  points={["ลังไม้มาตรฐานส่งออก", "ผ่านศุลกากรแล้ว (DDP)", "ส่งถึงหน้าประตู"]}
  ctaLabel="ดูราคา DDP รายประเทศ"
  ctaHref="/th/pricing/by-country/"
/>

<CTASection locale={locale} title="พร้อมเลิกล้างมือแล้วใช่ไหม?" subtitle="ใบเสนอราคาภายใน 12 ชั่วโมง" />
</BaseLayout>
