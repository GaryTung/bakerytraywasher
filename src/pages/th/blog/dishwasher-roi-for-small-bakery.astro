const locale = 'th' as const;
---
<BaseLayout title="ROI ของเครื่องล้างจานสำหรับเบเกอรี่ (ฉบับภาษาอังกฤษ) | JD-3" description="ROI ของเครื่องล้างจานสำหรับเบเกอรี่" locale={locale} canonicalPath="/blog/dishwasher-roi-for-small-bakery/" schemaType="Article">
