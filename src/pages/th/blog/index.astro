---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'th' as const;
const posts = [
  {
    slug: 'bakery-tray-washer-capacity-calculator',
    title: 'เครื่องล้างถาดเบเกอรี่ล้างได้กี่ถาด? เครื่องคำนวณกำลังการผลิตจริง',
    desc: 'แปลงจำนวนถาดต่อวันเป็นรอบ นาทีเครื่อง และช่วงเวลาล้าง ด้วยข้อมูลที่ยืนยันแล้ว 6 ถาดมาตรฐานต่อรอบ 2 นาที พร้อมอธิบายว่าทำไม 180 ถาด/ชั่วโมงเป็นเพดานทางเทคนิค',
    date: '2026-08-19',
  },
  {
    slug: 'commercial-dishwasher-running-cost',
    title: "ค่าใช้จ่ายในการเดินเครื่องล้างจานเชิงพาณิชย์สำหรับเบเกอรี่จริง ๆ เท่าไหร่? ต่อรอบ ต่อวัน ต่อปี",
    desc: "ผู้ซื้อหมกมุ่นกับราคาซื้อและลืมค่าใช้จ่ายในการเดินเครื่อง สี่ค่าใช้จ่าย — น้ำ ไฟฟ้า น้ำยา การขจัดตะกรัน — และใหญ่เพียงอย่างเดียว วิธีซื่อตรงบนพื้นฐานฟิสิกส์เพื่อประเมินแต่ละอย่างตามอัตราของคุณ ตัวอย่างสำหรับคาเฟ่ 150 ถาด และห้าคันโยกที่ลดค่าใช้จ่าย",
    date: '2026-06-24',
  },
  {
    slug: '600x400-tray-washer-for-small-bakeries',
    title: "ใหญ่เกินไปสำหรับเครื่องล้างจาน เล็กเกินไปสำหรับอุโมงค์: ปัญหาถาด 600×400",
    desc: "ถาด 600×400 มม. ไม่เข้าแร็ค 500×500 ของเครื่องล้างจานมาตรฐาน แต่เครื่องล้างอุโมงค์ต้องใช้พื้น 3–6 ม. ที่คุณไม่มี JD-3 สร้างมาเพื่อช่องว่างนี้: พื้นที่วาง 0.65 ตร.ม. เท่าโต๊ะเตรียม แร็ค 650×550 รับหกถาดต่อรอบ พร้อมแขนฉีดน้ำหมุนคู่และน้ำล้าง ≥82°C เพื่อล้างคราบอบได้จริง",
    date: '2026-06-18',
  },
  {
    slug: 'commercial-dishwasher-maintenance-schedule',
    title: "ตารางบำรุงรักษาเครื่องล้างจานเชิงพาณิชย์สำหรับเบเกอรี่: งานรายวัน รายสัปดาห์ และรายเดือน เพื่อเครื่องที่ใช้ได้ 10 ปี",
    desc: "เครื่องล้างจานเชิงพาณิชย์สำหรับเบเกอรี่ควรใช้งานได้ 8–12 ปี — แต่ต่อเมื่อมีการบำรุงรักษา ตัวการสำคัญที่สุดคือตะกรันที่ฮีตเตอร์ ซึ่งป้องกันได้ทั้งหมด ตารางรายวัน/รายสัปดาห์/รายเดือน/รายไตรมาส กิจวัตรห้านาทีตอนปิดร้านที่ทำงาน 80% และความกระด้างของน้ำกำหนดรอบการขจัดตะกรันอย่างไร",
    date: '2026-06-13',
  },
  {
    slug: 'commercial-dishwasher-faults-electrician-diagnose-circuit-diagram',
    title: "เจ็ดอาการเสียของเครื่องล้างจานเชิงพาณิชย์ที่ช่างไฟฟ้าในพื้นที่วินิจฉัยได้ด้วยแผนผังในตัวเครื่อง",
    desc: "ค่าเรียกช่างเฉพาะทาง 250–800 USD ก่อนจะแตะอะไหล่ใดเลย แต่อาการเสียที่พบบ่อยที่สุดเจ็ดข้อซึ่งคิดเป็น 80% ของการเรียกบริการ — ไม่มีไฟ ไม่ร้อน ไม่มีน้ำพ่น เบรกเกอร์ทริป ปั๊มน้ำเสียวิ่งตลอด ฝาครอบล็อก เตือนอุณหภูมิน้ำล้าง — ช่างไฟฟ้าอุตสาหกรรมที่มีใบประกอบวิชาชีพและถือแผนผังที่เคลือบไว้ในตู้ระบุปัญหาได้ใน 30–90 นาที บทความพาผ่านแต่ละข้อด้วยรหัสอุปกรณ์ แรงดันและความต้านทานที่คาดหวัง",
    date: '2026-06-10',
  },
  {
    slug: 'pre-installation-checklist-commercial-dishwasher',
    title: "เช็คลิสต์เตรียมพื้นที่ก่อนติดตั้ง — สิ่งที่ร้านเบเกอรี่ส่วนใหญ่ลืม",
    desc: "8 หัวข้อความพร้อมพื้นที่ — ระบบไฟ (32A Type-C + RCD), น้ำ, ระบายน้ำ, ระบายอากาศ, พื้น, พื้นที่ว่าง, การตัดสินใจน้ำร้อน, วงจรไฟแยก — พร้อมตัวเลขที่ช่างไฟและช่างประปาต้องใช้ก่อนวันรับเครื่อง",
    date: '2026-06-08',
  },
  {
    slug: 'chemistry-of-washing-bakery-trays',
    title: "เคมีที่ซ่อนอยู่เบื้องหลังการล้างถาดเบเกอรี่",
    desc: "ถาดเบเกอรี่ไม่ใช่จานข้าว มีคราบ 4 ชนิดต่างกัน — น้ำตาลคาราเมล ไขมันโพลีเมอไรซ์ ไข่ทาหน้าที่อบติด เศษโดหมัก — แต่ละชนิดเชื่อฟังเคมีคนละแบบ โปรโตคอลภาคสนามจากผู้ผลิต",
    date: '2026-06-05',
  },
  {
    slug: 'five-failure-modes-commercial-dishwasher',
    title: "5 รูปแบบที่เครื่องล้างจานเชิงพาณิชย์พังจริง",
    desc: "แบริ่งปั๊ม คราบหินปูน ความชื้นแผงคุม ยางประตู ใบพัดระบาย — และต้องถามอะไรก่อนซื้อ",
    date: '2026-05-15',
  },
  {
    slug: 'aor-yor-gmp-tray-washer-thai-bakery',
    title: 'อย. GMP และเครื่องล้างถาด',
    desc: 'ประกาศ ฉบับที่ 193, ใบอนุญาต อ.18, วิธีผ่านการตรวจ อย. สำหรับเบเกอรี่ไทย',
    date: '2026-04-15',
  },
  {
    slug: '600x400-tray-norm-explained',
    title: 'มาตรฐานถาด 600×400 มม. คืออะไร',
    desc: 'อธิบาย DIN 18876 / EN 631 และความเข้ากันได้กับเตา Rational, Convotherm, Unox',
    date: '2026-01-28',
  },
  {
    slug: 'ddp-bangkok-cost-breakdown',
    title: 'ราคา DDP กรุงเทพฯ: ค่าใช้จ่ายจริง',
    desc: 'FOB เซินเจิ้น ค่าระวางเรือ ภาษีนำเข้าไทย 5% VAT 7% — รวมทุกอย่าง',
    date: '2026-02-11',
  },
  {
    slug: 'roi-4-months-thai-bakery',
    title: 'คืนทุนใน 4 เดือน',
    desc: 'คำนวณ ROI แบบจริงสำหรับร้านเบเกอรี่ในกรุงเทพฯ เชียงใหม่ ภูเก็ต',
    date: '2026-02-25',
  },
];
---
<BaseLayout title={`${t(locale,'nav.blog')} | JD-3`} description="บทความเกี่ยวกับการดำเนินงานเบเกอรี่และการใช้งาน JD-3" locale={locale} canonicalPath="/blog/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/th/'},{label: t(locale,'nav.blog')}]} />
<section class="section"><div class="container-page">
<h1 class="text-center mb-10">บล็อก</h1>
<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
{posts.map((p) => (
  <a href={`/th/blog/${p.slug}/`} class="card hover:scale-[1.02] transition">
    <p class="text-xs text-bakery-navy/50 mb-2">{p.date}</p>
    <h3 class="mb-3">{p.title}</h3>
    <p class="text-sm text-bakery-navy/70">{p.desc}</p>
  </a>
))}
</div>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
