---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'th' as const;
const posts = [
  {
    slug: 'pre-installation-checklist-commercial-dishwasher',
    title: "เช็คลิสต์เตรียมพื้นที่ก่อนติดตั้ง — สิ่งที่ร้านเบเกอรี่ส่วนใหญ่ลืม",
    desc: "8 หัวข้อความพร้อมพื้นที่ — ระบบไฟ (32A Type-C + RCD), น้ำ, ระบายน้ำ, ระบายอากาศ, พื้น, พื้นที่ว่าง, การตัดสินใจน้ำร้อน, วงจรไฟแยก — พร้อมตัวเลขที่ช่างไฟและช่างประปาต้องใช้ก่อนวันรับเครื่อง",
    date: '2026-06-08',
  },
  {
    slug: 'chemistry-of-washing-bakery-trays',
    title: "เคมีที่ซ่อนอยู่เบื้องหลังการล้างถาดเบเกอรี่",
    desc: "ถาดเบเกอรี่ไม่ใช่จานข้าว มีคราบ 4 ชนิดต่างกัน — น้ำตาลคาราเมล ไขมันโพลีเมอไรซ์ ไข่ทาหน้าที่อบติด เศษโดหมัก — แต่ละชนิดเชื่อฟังเคมีคนละแบบ โปรโตคอลภาคสนามจากผู้ผลิต",
    date: '2026-06-05',
  },
  {
    slug: 'five-failure-modes-commercial-dishwasher',
    title: "5 รูปแบบที่เครื่องล้างจานเชิงพาณิชย์พังจริง",
    desc: "แบริ่งปั๊ม คราบหินปูน ความชื้นแผงคุม ยางประตู ใบพัดระบาย — และต้องถามอะไรก่อนซื้อ",
    date: '2026-05-15',
  },
  {
    slug: 'aor-yor-gmp-tray-washer-thai-bakery',
    title: 'อย. GMP และเครื่องล้างถาด',
    desc: 'ประกาศ ฉบับที่ 193, ใบอนุญาต อ.18, วิธีผ่านการตรวจ อย. สำหรับเบเกอรี่ไทย',
    date: '2026-04-15',
  },
  {
    slug: '600x400-tray-norm-explained',
    title: 'มาตรฐานถาด 600×400 มม. คืออะไร',
    desc: 'อธิบาย DIN 18876 / EN 631 และความเข้ากันได้กับเตา Rational, Convotherm, Unox',
    date: '2026-01-28',
  },
  {
    slug: 'ddp-bangkok-cost-breakdown',
    title: 'ราคา DDP กรุงเทพฯ: ค่าใช้จ่ายจริง',
    desc: 'FOB เซินเจิ้น ค่าระวางเรือ ภาษีนำเข้าไทย 5% VAT 7% — รวมทุกอย่าง',
    date: '2026-02-11',
  },
  {
    slug: 'roi-4-months-thai-bakery',
    title: 'คืนทุนใน 4 เดือน',
    desc: 'คำนวณ ROI แบบจริงสำหรับร้านเบเกอรี่ในกรุงเทพฯ เชียงใหม่ ภูเก็ต',
    date: '2026-02-25',
  },
];
---
<BaseLayout title={`${t(locale,'nav.blog')} | JD-3`} description="บทความเกี่ยวกับการดำเนินงานเบเกอรี่และการใช้งาน JD-3" locale={locale} canonicalPath="/blog/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/th/'},{label: t(locale,'nav.blog')}]} />
<section class="section"><div class="container-page">
<h1 class="text-center mb-10">บล็อก</h1>
<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
{posts.map((p) => (
  <a href={`/th/blog/${p.slug}/`} class="card hover:scale-[1.02] transition">
    <p class="text-xs text-bakery-navy/50 mb-2">{p.date}</p>
    <h3 class="mb-3">{p.title}</h3>
    <p class="text-sm text-bakery-navy/70">{p.desc}</p>
  </a>
))}
</div>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
