  <thead class="bg-bakery-cream">
    <tr><th class="text-left p-3">ค่าใช้จ่าย</th><th class="text-left p-3">ต่อวัน (25 รอบ)</th><th class="text-left p-3">ต่อปี (อัตราตัวอย่าง)</th></tr>
