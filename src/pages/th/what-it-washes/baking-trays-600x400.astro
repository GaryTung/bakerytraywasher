---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import ImagePlaceholder from '../../../components/ImagePlaceholder.astro';
import InlineInquiryForm from '../../../components/InlineInquiryForm.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'th' as const;
const rows = [
  { label: 'V-TAI JD-3', jd3: '650 × 550 มม.', competitor: '✓ ใช่', highlight: true },
  { label: 'Hobart AMX', jd3: '500 × 500 มม.', competitor: '✗ ไม่' },
];
---
<BaseLayout title="เครื่องล้างถาดเบเกอรี่ 600×400 มม." description="เครื่องล้างจานแบบกระโจมเดียวในระดับราคานี้ที่รองรับถาดเบเกอรี่ยุโรป 600×400 มม." locale={locale} canonicalPath="/what-it-washes/baking-trays-600x400/" schemaType="Article">
<BreadcrumbNav items={[{label:'หน้าแรก',href:'/th/'},{label:'ถาด 600×400'}]} />
<section class="section">
<div class="container-page grid lg:grid-cols-3 gap-10">
<article class="lg:col-span-2">
<p class="eyebrow mb-3">⭐ การใช้งานหลัก</p>
<h1 class="mb-4">เครื่องล้างถาดเบเกอรี่ 600×400 มม.</h1>
<p class="text-lg mb-6">JD-3 เป็นเครื่องล้างจานแบบกระโจมเดียวในระดับราคานี้ที่รองรับมาตรฐานยุโรป 600×400 มม.</p>
<ImagePlaceholder alt="ถาด 600×400 ใน JD-3" ratio="16/9" label="เปรียบเทียบ 600×400" />
<h2 class="mt-10 mb-3">มาตรฐาน 600×400 คืออะไร?</h2>
<p>มาตรฐานยุโรปที่เกิดขึ้นในเยอรมนีในยุค 1960 ใช้โดยเตา Convotherm, Rational, Unox</p>
<h2 class="mt-10 mb-3">ตารางความเข้ากันได้</h2>
<ComparisonTable competitorName="รองรับ 600×400?" rows={rows} />
</article>
<aside class="lg:sticky lg:top-24 self-start"><InlineInquiryForm locale={locale} title="ขอใบเสนอราคา" /></aside>
</div>
</section>
<CTASection locale={locale} />
</BaseLayout>
