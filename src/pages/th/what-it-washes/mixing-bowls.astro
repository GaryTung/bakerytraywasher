  recommendedSettings={"รอบมาตรฐาน 2 นาที ถังล้าง 65 °C น้ำล้างสุดท้าย 82 °C น้ำยาทำความสะอาดด่างฟองต่ำสำหรับใช้เชิงพาณิชย์ แนะนำให้ล้างน้ำเปล่าสั้นๆ ก่อนเพื่อรักษาคุณภาพน้ำที่หมุนเวียน"}
  faqs={[
