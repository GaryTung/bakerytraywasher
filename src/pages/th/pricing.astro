---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import PriceCalloutBox from '../../components/PriceCalloutBox.astro';
import CTASection from '../../components/CTASection.astro';
const locale = 'th' as const;
---
<BaseLayout title="ราคา JD-3 — เริ่มต้น $2,800 FOB" description="ราคาตรงไปตรงมาสำหรับ V-TAI JD-3" locale={locale} canonicalPath="/pricing/" schemaType="Product">
<BreadcrumbNav items={[{label:'หน้าแรก',href:'/th/'},{label:'ราคา'}]} />
<section class="section"><div class="container-page">
<h1 class="text-center mb-4">ราคาตรงไปตรงมา โปร่งใส</h1>
<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
<div class="card"><h3>มาตรฐาน</h3><p class="text-3xl font-bold text-bakery-orange">$2,800</p></div>
<div class="card border-2 border-bakery-orange"><h3>+ เครื่องจ่ายสารทำความสะอาด</h3><p class="text-3xl font-bold text-bakery-orange">$3,000</p></div>
<div class="card"><h3>+ ระบบบำบัดน้ำ</h3><p class="text-3xl font-bold text-bakery-orange">$3,300</p></div>
<div class="card"><h3>+ การกู้คืนความร้อน</h3><p class="text-3xl font-bold text-bakery-orange">$3,200</p></div>
</div>
<div class="mt-6 max-w-md mx-auto"><PriceCalloutBox locale={locale} /></div>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
