---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'th' as const;
---
<BaseLayout title="คู่มือติดตั้ง JD-3" description="ข้อกำหนดพื้นที่ น้ำ ไฟฟ้า และระบายน้ำ" locale={locale} canonicalPath="/product/jd-3-installation/" schemaType="HowTo">
<BreadcrumbNav items={[{label:'หน้าแรก',href:'/th/'},{label:'ติดตั้ง'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">คู่มือติดตั้ง JD-3</h1>
<p class="text-lg mb-6">เบเกอรี่เล็กส่วนใหญ่ติดตั้ง JD-3 ได้ใน 2-4 ชั่วโมงโดยไม่ต้องปรับปรุงใหญ่</p>
<h2 class="mt-8 mb-3">รายการตรวจสอบ</h2>
<ul class="space-y-2 list-disc list-inside">
<li>พื้นที่: 850 × 850 มม.</li>
<li>ความสูง: 2,200 มม.</li>
<li>น้ำเย็น: G 3/4" แรงดัน 2.5-6 กก./ตร.ซม.</li>
<li>ระบายน้ำ: G 1½"</li>
<li>ไฟฟ้า: 380V/3N/50Hz วงจรเฉพาะ 21.5 A</li>
</ul>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
