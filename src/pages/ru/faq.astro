---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';
import { t } from '../../i18n/utils';
const locale = 'ru' as const;
const faqs = [
  { q: 'Что такое V-TAI JD-3?', a: 'Купольная коммерческая посудомоечная машина для пекарских противней. Модель VT-AE-JD-3.' },
  { q: 'Цена?', a: 'От 4 400 $ FOB Шэньчжэнь. До 4 900 $ с дополнительными опциями (автоматический дозатор моющего средства, рекуперация тепла).' },
  { q: 'Отличие от других брендов?', a: 'Корзина 650×550 мм принимает противни 600×400 мм (DIN 18876 / EN 631) — стандарт, используемый Rational, Convotherm, Unox, MIWE. Значительно ниже по цене, чем премиум-бренды при том же уровне сертификации CE.' },
  { q: 'Срок поставки?', a: '4 недели производства в Шэньчжэне, плюс морской фрахт (20–35 дней в зависимости от пункта назначения) или авиа (3–7 дней, дороже).' },
  { q: 'Гарантия?', a: '12 месяцев гарантии производителя на детали. Запчасти отправляются по всему миру в течение 5 рабочих дней.' },
  { q: 'Что делать при поломке?', a: 'Каждая машина поставляется со схемой электропроводки внутри сервисной панели. Обычный электрик может устранить большинство проблем. Запчасти доставляются по всему миру за 5 дней.' },
  { q: 'Установка?', a: 'Получите машину, посмотрите видеоинструкцию, подключите воду + электричество. Обычно 1–2 часа. Специальный техник не требуется.' },
  { q: 'Доставка в мою страну?', a: 'Да. Смотрите страницу цен DDP для 18 рынков в местной валюте. Если вашей страны нет в списке, запросите индивидуальное предложение — ответим в течение 12 часов.' },
];
---
<BaseLayout title={`${t(locale,'nav.faq')} | JD-3`} description="Часто задаваемые вопросы о V-TAI JD-3." locale={locale} canonicalPath="/faq/" schemaType="FAQPage">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/ru/'},{label: t(locale,'nav.faq')}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4 text-center">Часто задаваемые вопросы</h1>
</div></section>
<FAQSection items={faqs} title="" locale={locale} />
<CTASection locale={locale} />
</BaseLayout>
