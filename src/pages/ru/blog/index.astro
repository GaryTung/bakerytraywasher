---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'ru' as const;
const posts = [
  {
    slug: 'bakery-tray-washer-capacity-calculator',
    title: 'Сколько противней обработает мойка для пекарни? Калькулятор реальной производительности',
    desc: 'Переведите дневной объём в циклы, машинные минуты и окно мойки по проверенной загрузке: 6 стандартных противней за 2-минутный цикл. Почему 180 противней/ч — технический потолок.',
    date: '2026-08-19',
  },
  {
    slug: 'commercial-dishwasher-running-cost',
    title: "Сколько на самом деле стоит эксплуатация промышленной пекарской посудомойки? На цикл, на день, на год",
    desc: "Покупатели зациклены на цене покупки и забывают о стоимости эксплуатации. Четыре расхода — вода, электричество, моющее средство, накипь — и крупный только один. Честный, основанный на физике метод оценить каждый по вашим тарифам, пример для кофейни на 150 противней и пять рычагов снижения счёта.",
    date: '2026-06-24',
  },
  {
    slug: '600x400-tray-washer-for-small-bakeries',
    title: "Слишком велик для посудомойки, слишком мал для туннеля: проблема противня 600×400",
    desc: "Противни 600×400 мм не влезают в корзину 500×500 стандартной посудомойки, а туннельная моечная требует 3–6 м пола, которого у вас нет. JD-3 создана для этого зазора: площадь 0,65 м² как у разделочного стола, корзина 650×550 на шесть противней за цикл, плюс два моющих коромысла и ополаскивание ≥82°C, чтобы реально отмыть запечённый налёт.",
    date: '2026-06-18',
  },
  {
    slug: 'commercial-dishwasher-maintenance-schedule',
    title: "График обслуживания промышленной пекарской посудомоечной машины: ежедневные, еженедельные и ежемесячные задачи для машины на 10 лет",
    desc: "Промышленная пекарская посудомоечная машина должна служить 8–12 лет — но только при обслуживании. Главный убийца — накипь на ТЭНе, и она полностью предотвратима. Полный ежедневный/еженедельный/ежемесячный/ежеквартальный график, пятиминутная рутина в конце смены, делающая 80% работы, и как жёсткость воды задаёт интервал удаления накипи.",
    date: '2026-06-13',
  },
  {
    slug: 'commercial-dishwasher-faults-electrician-diagnose-circuit-diagram',
    title: "Семь неисправностей промышленной посудомоечной машины, которые местный электрик может диагностировать по встроенной электросхеме",
    desc: "Выезд узкого специалиста стоит 250–800 долл. ещё до того, как мастер коснётся компонента. Для семи самых частых неисправностей (80% всех вызовов) — нет питания, не греет, нет напора, выбивает автомат, насос откачки не отключается, защёлка капота, тревога ополаскивания — лицензированный промышленный электрик со схемой в руках локализует причину за 30–90 минут. По каждой даны обозначения компонентов, ожидаемые напряжения и сопротивления.",
    date: '2026-06-10',
  },
  {
    slug: 'pre-installation-checklist-commercial-dishwasher',
    title: "Чек-лист предмонтажной подготовки, который большинство пекарен пропускает",
    desc: "8 пунктов готовности площадки — электрика (32 А тип C + УЗО), вода, слив, вентиляция, пол, габариты, решение по горячей воде, изолированная цепь — с конкретными цифрами для электрика и сантехника до дня монтажа.",
    date: '2026-06-08',
  },
  {
    slug: 'chemistry-of-washing-bakery-trays',
    title: "Скрытая химия мойки пекарских противней",
    desc: "Пекарский противень — не обеденная тарелка. Четыре типа остатков — карамелизованный сахар, полимеризованный жир, запечённая яичная глазурь, остатки сброженного теста — следуют разной химии. Полевой протокол производителя.",
    date: '2026-06-05',
  },
  {
    slug: 'five-failure-modes-commercial-dishwasher',
    title: "Пять способов, которыми умирает посудомойка",
    desc: "Подшипники насоса, накипь, влага на плате, уплотнение, крыльчатка слива — и что спросить до покупки.",
    date: '2026-05-15',
  },
  {
    slug: 'sertifikat-eac-vvoz-posudomojki-iz-kitaja',
    title: 'Сертификат EAC и ввоз из Китая',
    desc: 'ТР ТС 010/2011, 004/2011, 020/2011. Процесс таможенного оформления, код ТН ВЭД 8422 11 000 0, без задержек.',
    date: '2026-04-15',
  },
  {
    slug: 'evropejskij-standart-600x400-protivnej',
    title: 'Европейский стандарт 600×400 — объяснение',
    desc: 'История стандарта DIN 18876 / EN 631 и совместимость с печами Rational, Unox, Convotherm.',
    date: '2026-01-28',
  },
  {
    slug: 'stoimost-mojki-protivnej-dostavka-moskva',
    title: 'Стоимость доставки DDP в Москву',
    desc: 'FOB Шэньчжэнь, морской фрахт, российская пошлина, НДС 20% — реальные цифры 2026.',
    date: '2026-02-11',
  },
  {
    slug: 'okupaemost-mojki-pekarnia-4-mesyatsa',
    title: 'Окупаемость за 4 месяца',
    desc: 'Конкретный расчёт ROI для малых и средних пекарен в России, Казахстане, Беларуси.',
    date: '2026-02-25',
  },
];
---
<BaseLayout title={`${t(locale,'nav.blog')} | JD-3`} description="Статьи об операциях пекарни и развёртывании JD-3." locale={locale} canonicalPath="/blog/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/ru/'},{label: t(locale,'nav.blog')}]} />
<section class="section"><div class="container-page">
<h1 class="text-center mb-10">Блог</h1>
<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
{posts.map((p) => (
  <a href={`/ru/blog/${p.slug}/`} class="card hover:scale-[1.02] transition">
    <p class="text-xs text-bakery-navy/50 mb-2">{p.date}</p>
    <h3 class="mb-3">{p.title}</h3>
    <p class="text-sm text-bakery-navy/70">{p.desc}</p>
  </a>
))}
</div>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
