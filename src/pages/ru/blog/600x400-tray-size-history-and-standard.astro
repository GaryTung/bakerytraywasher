import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'ru' as const;
---
<BaseLayout title="История и стандарт размера 600×400 (английская версия) | JD-3" description="История и стандарт размера 600×400" locale={locale} canonicalPath="/blog/600x400-tray-size-history-and-standard/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/ru/'},{label: t(locale,'nav.blog'), href:'/ru/blog/'},{label: 'История и стандарт размера 600×400'}]} />
<section class="section"><div class="container-prose">
