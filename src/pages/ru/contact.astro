---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import InlineInquiryForm from '../../components/InlineInquiryForm.astro';
const locale = 'ru' as const;
---
<BaseLayout title="Контакты V-TAI" description="Email, WhatsApp или посетите V-TAI." locale={locale} canonicalPath="/contact/">
<BreadcrumbNav items={[{label:'Главная',href:'/ru/'},{label:'Контакты'}]} />
<section class="section">
  <div class="container-page grid lg:grid-cols-2 gap-10">
    <div>
      <h1 class="mb-4">Связаться с нами</h1>
      <div class="space-y-4">
        <div class="card"><h3 class="text-lg mb-2">WhatsApp</h3><a href="https://wa.me/8613509623269" class="text-bakery-orange underline">+86 135 0962 3269</a></div>
        <div class="card"><h3 class="text-lg mb-2">Email</h3><a href="mailto:info@v-tai.com" class="text-bakery-orange underline">info@v-tai.com</a></div>
        <div class="card"><h3 class="text-lg mb-2">Офис</h3><p>Комната 2202, Центр глобальных логистических услуг, Лунган, Шэньчжэнь, Гуандун, Китай</p></div>
      </div>
    </div>
    <InlineInquiryForm locale={locale} title="Отправьте нам сообщение" />
  </div>
</section>
</BaseLayout>
