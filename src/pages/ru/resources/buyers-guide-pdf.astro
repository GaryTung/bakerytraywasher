---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'ru' as const;
---
<BaseLayout title="Руководство покупателя (PDF) | JD-3" description="Руководство покупателя (PDF)" locale={locale} canonicalPath="/resources/buyers-guide-pdf/" schemaType="Article">
<BreadcrumbNav items={[{label: t(locale,'nav.home'), href:'/ru/'},{label: t(locale,'nav.resources'), href:'/ru/resources/'},{label: 'Руководство покупателя (PDF)'}]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Руководство покупателя (PDF)</h1>
<p class="text-lg mb-6 text-bakery-navy/70">Эта страница доступна на английском:</p>
<p><a href="/resources/buyers-guide-pdf/" class="btn-primary inline-block">Руководство покупателя (PDF) (EN) →</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
