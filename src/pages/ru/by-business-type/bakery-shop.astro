---
import BusinessTypeLayout from '../../../layouts/BusinessTypeLayout.astro';
const locale = 'ru' as const;
---
<BusinessTypeLayout locale={locale} canonicalPath="/by-business-type/bakery-shop/" slug="bakery-shop" businessName="Пекарня" icon="🥐"
  title="Мойка противней для независимой пекарни"
  description="JD-3 — правильная машина для пекарни на одной локации."
  reality="Вы открыли пекарню, потому что любите пекарское дело, а не чтобы мыть противни 3 часа каждый вечер. 150-200 противней в день — это 2-3 часа труда."
  needs="Мойка должна: принимать ваши противни (если Convotherm/Rational = 600×400), окупиться за 6-12 месяцев, работать без надзора, помещаться в кухне."
  fit="JD-3 настроена для пекарни на одной локации: кассета 650×550, 180 противней/час, габарит 850×850."
  roi="Типичная пекарня: 2 мойщика × $12/ч × 3 ч × 26 дней = $1 872/мес = $22 464/год трудозатрат. С JD-3: та же работа за ~30 мин/день. Экономия ~$20 500/год. Простая окупаемость машины: 3,5 месяца; с учётом фрахта и установки: ~4–5 месяцев. Главная цифра: ~4 месяца."
  faqs={[{q:'Подойдёт форма Pullman?',a:'Да до 33 см вертикально.'}]}
/>
