---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBadgeStrip from '../../components/TrustBadgeStrip.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import PriceCalloutBox from '../../components/PriceCalloutBox.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import CTASection from '../../components/CTASection.astro';
import FAQSection from '../../components/FAQSection.astro';
const locale = 'ru' as const;

const types = [
  { name: 'Пекарня', href: '/ru/by-business-type/bakery-shop/', icon: '🥐' },
  { name: 'Кофейня', href: '/ru/by-business-type/coffee-chain/', icon: '☕' },
  { name: 'Ресторан', href: '/ru/by-business-type/small-restaurant/', icon: '🍽️' },
  { name: 'Столовая', href: '/ru/by-business-type/cafeteria/', icon: '🥪' },
  { name: 'Отель', href: '/ru/by-business-type/hotel-pastry-kitchen/', icon: '🏨' },
];

const faqs = [
  { q: 'JD-3 действительно принимает противни 600×400 мм?', a: 'Да — кассета 650×550 мм единственная в этом ценовом классе, принимающая европейский стандарт. Hobart, Jackson, CMA используют кассеты 500×500 и не подходят.' },
  { q: 'Какой срок поставки?', a: '4-6 недель производства в Шэньчжэне плюс морской фрахт 20-35 дней.' },
  { q: 'Какие сертификаты?', a: 'CE Safety для рынка ЕС, ISO 9001. Окончательная стерилизация >82°C.' },
  { q: 'Какой период окупаемости?', a: 'Для пекарни на 150-200 противней/день — обычно 4 месяца.' },
];
---
<BaseLayout
  title="Мойка пекарских противней | V-TAI JD-3 коммерческая"
  description="Мойка пекарских противней, которая окупается за 4 месяца. Моет противни 600×400 мм — размер, который не принимают большинство американских машин. CE-сертификат. От $4,400 FOB."
  locale={locale}
  canonicalPath="/"
>
<section class="bg-gradient-to-br from-bakery-cream via-white to-bakery-cream/50 section">
  <div class="container-page grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <p class="eyebrow mb-3">V-TAI JD-3 · Купольная мойка для пекарен</p>
      <h1 class="mb-5">Мойка пекарских противней, которая окупится за <span class="text-bakery-orange">4 месяца</span></h1>
      <p class="text-lg text-bakery-navy/80 mb-6 leading-relaxed">
        Моет противни 600×400 мм — европейский стандарт, который не принимают большинство американских мойщиков.
        CE-сертифицирована, нержавеющая сталь SUS304. <strong>От $4 400 FOB Шэньчжэнь.</strong>
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/ru/get-quote/" class="btn-primary">Получить расчёт</a>
        <a href="/ru/product/" class="btn-secondary">Спецификации</a>
      </div>
    </div>
    <ImagePlaceholder src="/images/jd-3-hero.webp" alt="V-TAI JD-3 мойка противней" ratio="4/3" label="JD-3 основное фото" />
  </div>
</section>

<TrustBadgeStrip locale={locale} />

<section class="section">
  <div class="container-page">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h2 class="mb-3">Устали от того, что ваша команда тратит 3 часа в день на мытье противней?</h2>
      <p class="text-bakery-navy/70 text-lg">Если у вас пекарня, кофейня или кондитерская — ручная мойка съедает вашу маржу, а команда её ненавидит.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="card"><div class="text-3xl mb-3">💸</div><h3 class="mb-2">$25 000+/год потрачены</h3><p class="text-sm text-bakery-navy/70">На зарплату мойщикам, когда машина делает работу в 4 раза быстрее.</p></div>
      <div class="card"><div class="text-3xl mb-3">⚠️</div><h3 class="mb-2">Непостоянная гигиена</h3><p class="text-sm text-bakery-navy/70">Ручная мойка редко достигает 82°C — риск проверок.</p></div>
      <div class="card"><div class="text-3xl mb-3">😤</div><h3 class="mb-2">Текучесть кадров</h3><p class="text-sm text-bakery-navy/70">Никто не хочет смену в мойке. Постоянный найм изматывает.</p></div>
    </div>
  </div>
</section>

<section class="section bg-bakery-cream">
  <div class="container-page">
    <h2 class="text-center mb-10">Какой у вас бизнес?</h2>
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
      {types.map((bt) => (
        <a href={bt.href} class="card text-center hover:scale-[1.02] transition">
          <div class="text-4xl mb-2">{bt.icon}</div>
          <p class="font-semibold">{bt.name}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container-page grid lg:grid-cols-2 gap-10 items-center">
    <div>
      <h2 class="mb-4">Честные, прозрачные цены</h2>
      <p class="text-bakery-navy/80 mb-4">JD-3 от <strong>$4 400 FOB Шэньчжэнь</strong> — с эквивалентной CE-сертифицированной производительностью по сравнению с премиум-брендами.</p>
      <ul class="space-y-2 text-bakery-navy/80">
        <li class="flex gap-2 font-bold text-bakery-orange"><span>✓</span> V-TAI JD-3 стандарт: <strong>от $4 400 FOB</strong></li>
        <li class="flex gap-2"><span class="text-bakery-orange">✓</span> + Авто-дозатор моющего средства: от $4 600</li>
        <li class="flex gap-2"><span class="text-bakery-orange">✓</span> + Рекуперация тепла: от $4 900</li>
      </ul>
    </div>
    <PriceCalloutBox locale={locale} />
  </div>
</section>

<FAQSection items={faqs} title="Быстрые вопросы от владельцев пекарен" />

<CTASection locale={locale} title="Готовы покончить с ручной мойкой?" subtitle="Индивидуальный расчёт за 12 часов." />
</BaseLayout>
