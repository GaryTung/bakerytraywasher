---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'ru' as const;
const rows = [
  { label: 'Производительность', jd3: '60 кассет/ч', competitor: '60 кассет/ч' },
  { label: 'Размер кассеты', jd3: '650×550 мм', competitor: '500×500 мм' },
  { label: 'Противни 600×400', jd3: '✓ Да', competitor: '✗ Нет', highlight: true },
  { label: 'Цена', jd3: '$2 800–$3 500 FOB', competitor: '$7 000–$9 000' },
];
---
<BaseLayout title="JD-3 vs Hobart AMX | Сравнение" description="Сравнение V-TAI JD-3 и Hobart AMX." locale={locale} canonicalPath="/product/jd-3-vs-hobart-amx/" schemaType="Article">
<BreadcrumbNav items={[{label:'Главная',href:'/ru/'},{label:'vs Hobart'}]} />
<section class="section"><div class="container-prose"><h1>JD-3 vs Hobart AMX</h1><p class="text-lg mt-4 mb-6">Hobart — лидер американского рынка. JD-3 на 60% дешевле и принимает противни 600×400, которые Hobart не принимает.</p></div>
<div class="container-page"><ComparisonTable competitorName="Hobart AMX" rows={rows} /></div></section>
<CTASection locale={locale} />
</BaseLayout>
