---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import ImagePlaceholder from '../../../components/ImagePlaceholder.astro';
import YouTubeShort from '../../../components/YouTubeShort.astro';
import ProductSpecsTable from '../../../components/ProductSpecsTable.astro';
import TrustBadgeStrip from '../../../components/TrustBadgeStrip.astro';
import PriceCalloutBox from '../../../components/PriceCalloutBox.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQSection from '../../../components/FAQSection.astro';
const locale = 'ru' as const;

const specSections = [
  { title: "Габариты и вес", rows: [
    { k: "Корпус (купол закрыт)", v: "804 × 816 × 1 550 мм" },
    { k: "Макс. высота (купол открыт)", v: "2 115 мм" },
    { k: "Высота камеры", v: "550 мм" },
    { k: "Размер корзины", v: "650 × 550 мм" },
    { k: "Нетто / брутто", v: "145 кг / 165 кг" },
    { k: "Габариты в плане", v: "0,65 м²" },
  ]},
  { title: "Производительность", rows: [
    { k: "Производительность (стандартные противни)", v: "180 противней/час" },
    { k: "Загрузка за цикл", v: "6 противней" },
    { k: "Время цикла", v: "2 минуты (120 с)" },
    { k: "Циклов в час", v: "30" },
    { k: "Расход воды за цикл", v: "2,0–2,5 л" },
    { k: "Температура моечной ванны", v: "60–65°C" },
    { k: "Финальное ополаскивание", v: "≥82°C (NSF/ANSI 3)" },
  ]},
  { title: "Совместимость", rows: [
    { k: "Противни 600×400 мм", v: "6 за цикл (вертикально)" },
    { k: "Полу-листы 18×26\"", v: "6 за цикл (плоско)" },
    { k: "Полные листы 18×26\"", v: "1–2 за цикл (диагонально)" },
    { k: "Gastronorm GN 2/1", v: "6 за цикл" },
    { k: "Формы для тортов 8\"", v: "6 за цикл" },
    { k: "Формы для тортов 12\"", v: "2 за цикл (вертикально)" },
    { k: "Противни для пиццы 14\" / 16\"", v: "4 / 3 за цикл" },
    { k: "Кастрюли (≤ 28 см диам.)", v: "2 за цикл" },
    { k: "KitchenAid 5-л чаши", v: "4 за цикл (вертикально)" },
  ]},
  { title: "Электрика", rows: [
    { k: "Полная мощность", v: "13 кВт" },
    { k: "ТЭН", v: "9 кВт" },
    { k: "Насос", v: "0,75 кВт" },
    { k: "Питание (стандартное)", v: "380V / 3N / 50Hz" },
    { k: "Альтернативные варианты", v: "400V / 50Hz · 220V / 60Hz (указать при заказе)" },
    { k: "Рабочий ток", v: "21,5 A" },
    { k: "Рекомендуемый автомат", v: "32 A тип C" },
  ]},
  { title: "Вода", rows: [
    { k: "Подвод воды", v: "G 3/4\"" },
    { k: "Давление", v: "2,5–6 кг/см²" },
    { k: "Температура подаваемой", v: "≥ 10°C (50–60°C предварительно — экономия)" },
    { k: "Слив", v: "G 1½\" шланг" },
    { k: "Расстояние до слива", v: "≤ 1,5 м" },
    { k: "Расход слива", v: "~25 л/мин" },
  ]},
  { title: "Материалы", rows: [
    { k: "Корпус", v: "SUS304 пищевая" },
    { k: "Стенки камеры", v: "SUS304 пищевая" },
    { k: "Корзина / держатель противней", v: "SUS304 пищевая" },
    { k: "Вращающиеся рычаги", v: "SUS304 пищевая" },
    { k: "Внутренние шланги", v: "Пищевой силикон + нержавейка" },
  ]},
  { title: "Сертификаты", rows: [
    { k: "Безопасность", v: "CE (полное соответствие ЕС)" },
    { k: "Качество", v: "ISO 9001:2015" },
    { k: "Дезинфекция", v: "NSF/ANSI 3, EN 12875-2, DIN 10516, FDA 4-501.112" },
    { k: "Контакт с пищей", v: "FDA, ЕС 1935/2004" },
    { k: "Машинная директива", v: "EN ISO 12100, EN 60204-1" },
  ]},
  { title: "Функционал", rows: [
    { k: "Авто-старт при закрытии", v: "Да" },
    { k: "Рекуперация тепла", v: "Опционально (15–25%)" },
    { k: "Авто-дозатор", v: "Опционально" },
    { k: "Насос ополаскивателя", v: "Опционально" },
    { k: "Блокировка двери", v: "Стандарт" },
    { k: "Защита от перенапряжения", v: "Стандарт" },
    { k: "Индикация температуры", v: "LED цифровая" },
    { k: "Уровень шума", v: "≤ 70 дБ" },
  ]}
];

const washThumbs = [
  { slug: 'baking-trays-600x400', label: "Противни 600×400 мм", img: '/images/600x400-tray-comparison.webp' },
  { slug: 'sheet-pans', label: "Американские противни", img: '/images/what-it-washes/sheet-pans.webp' },
  { slug: 'mixing-bowls', label: "Миксерные чаши", img: '/images/what-it-washes/mixing-bowls.webp' },
  { slug: 'cake-pans', label: "Формы для тортов", img: '/images/what-it-washes/cake-pans.webp' },
  { slug: 'pizza-pans', label: "Противни для пиццы", img: '/images/what-it-washes/pizza-pans.webp' },
  { slug: 'frying-baskets', label: "Корзины для жарки", img: '/images/what-it-washes/frying-baskets.webp' },
  { slug: 'stockpots', label: "Кастрюли", img: '/images/what-it-washes/stockpots.webp' },
  { slug: 'dishes-plates', label: "Посуда и тарелки", img: '/images/what-it-washes/dishes-plates.webp' },
  { slug: 'utensils-mixers', label: "Утварь и насадки", img: '/images/what-it-washes/utensils-mixers.webp' },
  { slug: 'large-bakeware', label: "Крупная форма", img: '/images/what-it-washes/large-bakeware.webp' }
];

const features = [
  { icon: "🛡️", title: "Нержавеющая сталь SUS304", text: "Вся машина из пищевой SUS304 — антикоррозийная, легко дезинфицируется, соответствует FDA." },
  { icon: "📏", title: "Очень большая камера", text: "Корзина 650×550 мм принимает противни 600×400 мм, большие кастрюли, чаши KitchenAid." },
  { icon: "💧", title: "Два вращающихся рычага + спецсопла", text: "360° очистка. Геометрия сопел оптимизирована для плоских поверхностей противней." },
  { icon: "🌡️", title: "Умное управление температурой", text: "Автоматическая дезинфекция ≥82°C с LED-дисплеем. Модульная плата управления." },
  { icon: "💦", title: "Сверхнизкий расход воды", text: "2,0–2,5 л за цикл против 5–10 л у большинства конкурентов." },
  { icon: "♻️", title: "Система рекуперации тепла", text: "Горячая вода ополаскивания возвращается в моечный бак, экономия 15–25%." },
  { icon: "🚪", title: "Изолированный купол с уплотнением", text: "Снижает выход пара до 70%. Кухня остается прохладной и сухой." },
  { icon: "🧑‍🍳", title: "Эргономичная работа", text: "Push-pull направляющие. Закрыли купол — цикл пошел, без кнопок." },
  { icon: "🔒", title: "Многоуровневая защита", text: "Блокировка двери, защита от перенапряжения." },
  { icon: "🧪", title: "Готов к авто-дозатору", text: "Предустановленные интерфейсы для дозатора и модулей водоподготовки." },
  { icon: "⚡", title: "CE Safety сертификат", text: "Соответствие ЕС. Готов к отправке в ЕС, GCC, APAC, Латинскую Америку, Африку." },
  { icon: "⏱️", title: "Автостарт при закрытии", text: "Закройте купол — цикл начнется автоматически. Без кнопок, без ожидания." }
];
---
<BaseLayout
  title="V-TAI JD-3 — Купольная посудомоечная машина для пекарен | Полная страница продукта"
  description="V-TAI JD-3 купольная мойка для пекарен: 180 противней/час, совместима с противнями 600×400 мм, SUS304, CE. От 4 400 $ FOB Шэньчжэнь. Загрузка PDF-спецификации."
  locale={locale}
  canonicalPath="/product/"
  schemaType="Product"
  schemaData={{
    name: 'V-TAI JD-3',
    sku: 'VT-AE-JD-3',
    brand: { '@type': 'Brand', name: 'V-TAI' },
    description: "V-TAI JD-3 купольная мойка для пекарен: 180 противней/час, совместима с противнями 600×400 мм, SUS304, CE. От 4 400 $ FOB Шэньчжэнь. Загрузка PDF-спецификации.",
    image: 'https://bakerytraywasher.com/images/jd-3-hero.webp',
    offers: { '@type': 'AggregateOffer', offerCount: 3, priceCurrency: 'USD', lowPrice: '4400', highPrice: '4900', priceValidUntil: '2027-12-31', availability: 'https://schema.org/InStock', url: 'https://bakerytraywasher.com/product/' },
  }}
>

<BreadcrumbNav items={[{label: "Главная", href: '/ru/'}, {label: "Продукт"}]} />

<section class="section">
  <div class="container-page grid lg:grid-cols-2 gap-10">
    <div>
      <ImagePlaceholder src="/images/jd-3-front.webp" alt="V-TAI JD-3" ratio="4/3" label="JD-3" />
      <div class="grid grid-cols-3 gap-3 mt-3">
        <ImagePlaceholder src="/images/jd-3-trays-loaded.webp" alt="JD-3 противни загружены" ratio="1/1" />
        <ImagePlaceholder src="/images/jd-3-led-control.webp" alt="JD-3 LED"      ratio="1/1" />
        <ImagePlaceholder src="/images/jd-3-wash-arms.webp"   alt="JD-3 arms"     ratio="1/1" />
      </div>
    </div>
    <div>
      <p class="eyebrow mb-2">Модель VT-AE-JD-3</p>
      <h1 class="mb-4">V-TAI JD-3 — Купольная посудомоечная машина для пекарен</h1>
      <p class="text-lg text-bakery-navy/80 mb-5" set:html={"Единственная купольная мойка в своей ценовой категории, разработанная под европейский стандарт <strong>противней 600×400 мм</strong>. Создана для небольших коммерческих кухонь — пекарен, кафе, кондитерских, отельных кондитерских."} />
      <div class="grid grid-cols-2 gap-3 mb-6">
        <div class="rounded-card border-bakery-navy/10 border p-3"><p class="text-xs text-bakery-navy/60">Производительность</p><p class="font-semibold">180 противней/час</p></div>
        <div class="rounded-card border-bakery-orange/30 bg-bakery-cream border p-3"><p class="text-xs text-bakery-brown">Размер корзины</p><p class="font-semibold">650×550 мм ⭐</p></div>
        <div class="rounded-card border-bakery-navy/10 border p-3"><p class="text-xs text-bakery-navy/60">Время цикла</p><p class="font-semibold">2 мин · 6 противней</p></div>
        <div class="rounded-card border-bakery-navy/10 border p-3"><p class="text-xs text-bakery-navy/60">Полная мощность</p><p class="font-semibold">13 кВт</p></div>
      </div>
      <PriceCalloutBox locale={locale} />

      <!-- Spec sheet PDF + Quote -->
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/downloads/jd-3-spec-sheet-en.pdf"
           class="btn-primary inline-flex items-center gap-2"
           download
           aria-label="Download spec sheet PDF">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2M7 10l5 5 5-5M12 15V3"/>
          </svg>
          <span>Скачать спецификацию (PDF)</span>
        </a>
        <a href="/ru/get-quote/" class="btn-secondary inline-flex items-center gap-2">Запросить КП</a>
      </div>
      <p class="mt-2 text-xs text-bakery-navy/60" set:html={"PDF на английском. Нужна русская версия? <a href=\"/ru/contact/\" class=\"underline\">Запросите здесь</a>."} />
    </div>
  </div>
</section>

<TrustBadgeStrip locale={locale} />

<!-- Full specifications table -->
<section class="section">
  <div class="container-page">
    <div class="text-center max-w-3xl mx-auto mb-8">
      <h2 class="mb-3">Полная спецификация</h2>
      <p class="text-bakery-navy/70" set:html={"Все, что нужно отделу закупок, инженерам и санитарному аудиту. Скачайте <a href=\"/downloads/jd-3-spec-sheet-en.pdf\" class=\"text-bakery-orange underline\" download>PDF-спецификацию</a> для офлайн-просмотра."} />
    </div>
    <ProductSpecsTable sections={specSections} />
    <div class="text-center mt-8">
      <a href="/downloads/jd-3-spec-sheet-en.pdf"
         class="btn-primary inline-flex items-center gap-2"
         download>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2M7 10l5 5 5-5M12 15V3"/>
        </svg>
        <span>Скачать полную спецификацию (PDF)</span>
      </a>
      <p class="mt-3 text-xs text-bakery-navy/60" set:html={"PDF на английском. Нужна русская версия? <a href=\"/ru/contact/\" class=\"underline\">Запросите здесь</a>."} />
    </div>
  </div>
</section>

<!-- Videos -->
<section class="section bg-bakery-cream">
  <div class="container-page">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <h2 class="mb-3">Машина в действии</h2>
      <p class="text-bakery-navy/70">Два коротких видео: установка JD-3 на вашей кухне и настройка встроенного дозатора.</p>
    </div>
    <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
      <YouTubeShort videoId="bjxEYRiRTnI" title="Инструкция по установке JD-3" caption="Установка: вода + электричество + первый цикл" />
      <YouTubeShort videoId="Zkf6h8u7mFE" title="JD-3: настройка дозатора" caption="Настройка: дозировка встроенного дозатора" />
    </div>
  </div>
</section>

<!-- How it works -->
<section class="section">
  <div class="container-page">
    <h2 class="text-center mb-10">Как это работает — 4 шага</h2>
    <div class="grid md:grid-cols-4 gap-6">
      {[
      { n: '1', t: "Загрузить", d: "Задвиньте корзины с противнями, формами или чашами в камеру." },
      { n: '2', t: "Закрыть купол", d: "Цикл запускается автоматически — без кнопок." },
      { n: '3', t: "Мойка + ополаскивание", d: "Два вращающихся рычага 360°. Финальное ополаскивание 82°C." },
      { n: '4', t: "Достать", d: "Через 2 минуты (120 с). Чисто, дезинфицировано, стекает." }
      ].map((s) => (
        <div class="text-center">
          <div class="w-12 h-12 mx-auto rounded-full bg-bakery-orange text-white font-bold flex items-center justify-center mb-3">{s.n}</div>
          <h3 class="text-base mb-2">{s.t}</h3>
          <p class="text-sm text-bakery-navy/70">{s.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Features -->
<section class="section bg-bakery-cream">
  <div class="container-page">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="mb-3">12 важных функций</h2>
      <p class="text-bakery-navy/70">Каждая деталь продумана для небольшой коммерческой кухни — не индустриальный перебор, не потребительский компромисс.</p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((f) => (
        <div class="card">
          <div class="text-3xl mb-2">{f.icon}</div>
          <h3 class="text-lg mb-1">{f.title}</h3>
          <p class="text-sm text-bakery-navy/70">{f.text}</p>
        </div>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href="/ru/product/jd-3-features/" class="btn-secondary">Подробнее о 12 функциях</a>
    </div>
  </div>
</section>

<!-- What it cleans (thumbnails) -->
<section class="section">
  <div class="container-page">
    <h2 class="text-center mb-3">Что моет</h2>
    <p class="text-center text-bakery-navy/70 max-w-2xl mx-auto mb-10">Кликните на категорию, чтобы увидеть схемы загрузки, рекомендуемые настройки и специфические FAQ.</p>
    <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {washThumbs.map((w) => (
        <a href={`/ru/what-it-washes/${w.slug}/`} class="card !p-0 overflow-hidden hover:scale-[1.03] transition flex flex-col">
          <img src={w.img} alt={w.label} class="w-full aspect-[4/3] object-cover" loading="lazy" />
          <p class="p-3 text-sm font-medium text-bakery-navy text-center">{w.label}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Configurations -->
<section class="section bg-bakery-cream">
  <div class="container-page">
    <h2 class="text-center mb-8">Варианты конфигурации</h2>
    <div class="grid md:grid-cols-3 gap-4 max-w-5xl mx-auto">
      {[
      { t: "Стандартный электрический", p: "4 400 $", d: "Базовый JD-3, 380V/3N/50Hz" },
      { t: "+ Авто-дозатор", p: "4 600 $", d: "Насосы моющего средства и ополаскивателя" },
      { t: "+ Рекуперация тепла", p: "4 900 $", d: "Усиленный энергосберегающий пакет" }
      ].map((cfg) => (
        <div class="card">
          <h3 class="text-lg mb-1">{cfg.t}</h3>
          <p class="text-2xl font-bold text-bakery-orange mb-2">От {cfg.p}</p>
          <p class="text-sm text-bakery-navy/70">{cfg.d}</p>
        </div>
      ))}
    </div>
    <p class="text-center mt-6 text-sm text-bakery-navy/60" set:html={"Все цены FOB Шэньчжэнь. Доставка и пошлины зависят от страны — см. <a href=\"/ru/pricing/by-country/\" class=\"underline\">DDP-цены по странам</a>."} />
  </div>
</section>

<FAQSection locale={locale} title="Часто задаваемые вопросы" items={[
  { q: "Что входит в комплект?", a: "JD-3, кастомный держатель противней из нержавеющей стали, шланг подачи воды, шланг слива, руководство, сертификат CE." },
  { q: "Доставка в Россию / Казахстан / Беларусь?", a: "Да. Публикуем DDP-цены в местной валюте. См. <a href=\"/ru/pricing/by-country/\" class=\"underline\">цены по странам</a>." },
  { q: "Гарантия?", a: "Заводская гарантия 12 месяцев на запчасти. Запчасти отправляются международным экспресс-курьером." },
  { q: "Запчасти через 5 лет?", a: "Все ключевые компоненты — насосы, ТЭНы, платы — на заводском складе." },
  { q: "Можно скачать PDF-спецификацию?", a: "Да. Используйте кнопку «Скачать спецификацию (PDF)» вверху. PDF на английском; для русской версии <a href=\"/ru/contact/\" class=\"underline\">свяжитесь с нами</a>." }
]} />

<CTASection locale={locale} />
</BaseLayout>
