---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import ComparisonTable from '../../../components/ComparisonTable.astro';
import CTASection from '../../../components/CTASection.astro';
const locale = 'ru' as const;
const rows = [
  { label: 'Размер кассеты', jd3: '650×550 мм', competitor: '500×500 мм' },
  { label: 'Противни 600×400', jd3: '✓ Да', competitor: '✗ Нет', highlight: true },
  { label: 'Цена', jd3: '$2 800 FOB', competitor: '$5 000–$7 000' },
];
---
<BaseLayout title="JD-3 vs CMA L-1X16-BW" description="JD-3 vs CMA L-1X16-BW." locale={locale} canonicalPath="/product/jd-3-vs-cma-l-1x16-bw/" schemaType="Article">
<BreadcrumbNav items={[{label:'Главная',href:'/ru/'},{label:'vs CMA'}]} />
<section class="section"><div class="container-prose"><h1>JD-3 vs CMA L-1X16-BW</h1><p class="text-lg mt-4 mb-6">Несмотря на маркировку "BW" (Bakery Wash), CMA использует кассету 500×500, которая не принимает 600×400. JD-3 принимает.</p></div>
<div class="container-page"><ComparisonTable competitorName="CMA L-1X16-BW" rows={rows} /></div></section>
<CTASection locale={locale} />
</BaseLayout>
