import { t } from '../../../i18n/utils';
const locale = 'ru' as const;
---
<BaseLayout title="Как выбрать мойку для противней | JD-3" description="Как выбрать мойку для противней" locale={locale} canonicalPath="/guides/how-to-choose-bakery-tray-washer/" schemaType="Article">
