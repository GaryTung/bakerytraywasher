---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'ru' as const;
---
<BaseLayout title="Требования к пространству для малой пекарни | JD-3" description="Требования к пространству для малой пекарни" locale={locale} canonicalPath="/guides/space-requirements-small-bakery/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/ru/' },
  { label: t(locale, 'nav.guides') },
  { label: "Требования к пространству для малой пекарни" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Требования к пространству для малой пекарни</h1>
<p class="text-lg mb-6">Практическое руководство для пекарен, использующих V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/space-requirements-small-bakery/" class="underline">Посмотреть полную английскую версию</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
