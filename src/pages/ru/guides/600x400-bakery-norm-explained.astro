---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'ru' as const;
---
<BaseLayout title="Стандарт пекарских противней 600×400 мм | JD-3" description="Стандарт пекарских противней 600×400 мм" locale={locale} canonicalPath="/guides/600x400-bakery-norm-explained/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/ru/' },
  { label: t(locale, 'nav.guides') },
  { label: "Стандарт пекарских противней 600×400 мм" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Стандарт пекарских противней 600×400 мм</h1>
<p class="text-lg mb-6">Практическое руководство для пекарен, использующих V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/600x400-bakery-norm-explained/" class="underline">Посмотреть полную английскую версию</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
