---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTASection from '../../../components/CTASection.astro';
import { t } from '../../../i18n/utils';
const locale = 'ru' as const;
---
<BaseLayout title="Реальная стоимость ручного мытья | JD-3" description="Реальная стоимость ручного мытья" locale={locale} canonicalPath="/guides/cost-of-manual-tray-cleaning/" schemaType="Article">
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: '/ru/' },
  { label: t(locale, 'nav.guides') },
  { label: "Реальная стоимость ручного мытья" }
]} />
<section class="section"><div class="container-prose">
<h1 class="mb-4">Реальная стоимость ручного мытья</h1>
<p class="text-lg mb-6">Практическое руководство для пекарен, использующих V-TAI JD-3.</p>
<p class="text-bakery-navy/70"><a href="/guides/cost-of-manual-tray-cleaning/" class="underline">Посмотреть полную английскую версию</a></p>
</div></section>
<CTASection locale={locale} />
</BaseLayout>
