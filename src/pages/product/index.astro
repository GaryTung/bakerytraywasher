---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import YouTubeShort from '../../components/YouTubeShort.astro';
import ProductSpecsTable from '../../components/ProductSpecsTable.astro';
import TrustBadgeStrip from '../../components/TrustBadgeStrip.astro';
import PriceCalloutBox from '../../components/PriceCalloutBox.astro';
import CTASection from '../../components/CTASection.astro';
import FAQSection from '../../components/FAQSection.astro';

const locale = 'en' as const;

const specSections = [
  { title: 'Dimensions & Weight', rows: [
    { k: 'Body (hood closed)', v: '804 × 816 × 1,550 mm' },
    { k: 'Max height (hood open)', v: '2,115 mm' },
    { k: 'Chamber height', v: '550 mm' },
    { k: 'Rack size', v: '650 × 550 mm' },
    { k: 'Net / gross weight', v: '145 kg / 165 kg' },
    { k: 'Footprint', v: '0.65 m²' },
  ]},
  { title: 'Wash Performance', rows: [
    { k: 'Throughput (standard trays)', v: '180 trays/hour' },
    { k: 'Load per cycle (standard trays)', v: '6 trays' },
    { k: 'Cycle time', v: '2 minutes (120 s)' },
    { k: 'Cycles per hour', v: '30' },
    { k: 'Water per cycle', v: '2.0–2.5 L' },
    { k: 'Wash tank temperature', v: '60–65°C' },
    { k: 'Final rinse temperature', v: '≥82°C (NSF/ANSI 3)' },
  ]},
  { title: 'Item Compatibility', rows: [
    { k: '600×400 mm EN-Norm trays', v: '6 per cycle (vertical)' },
    { k: '18×26" half sheet pans', v: '6 per cycle (flat)' },
    { k: '18×26" full sheet pans', v: '1–2 per cycle (diagonal)' },
    { k: 'GN 2/1 gastronorm pans', v: '6 per cycle' },
    { k: '8" cake pans', v: '6 per cycle' },
    { k: '12" cake pans', v: '2 per cycle (vertical)' },
    { k: '14" / 16" pizza pans', v: '4 / 3 per cycle' },
    { k: 'Stockpots (≤ 28 cm dia.)', v: '2 per cycle (upright)' },
    { k: 'KitchenAid 5 L mixing bowls', v: '4 per cycle (vertical)' },
  ]},
  { title: 'Electrical', rows: [
    { k: 'Total power', v: '13 kW' },
    { k: 'Heating element', v: '9 kW' },
    { k: 'Pump', v: '0.75 kW' },
    { k: 'Power supply (standard)', v: '380V / 3N / 50Hz' },
    { k: 'Alternative supplies', v: '400V / 50Hz · 220V / 60Hz (specify at order)' },
    { k: 'Working current', v: '21.5 A' },
    { k: 'Recommended breaker', v: '32 A type C' },
  ]},
  { title: 'Water', rows: [
    { k: 'Inlet connection', v: 'G 3/4" thread' },
    { k: 'Inlet pressure', v: '2.5–6 kg/cm²' },
    { k: 'Inlet temperature', v: '≥ 10°C (50–60°C pre-heated saves energy)' },
    { k: 'Drain connection', v: 'G 1½" hose' },
    { k: 'Drain distance', v: '≤ 1.5 m (floor drain or wall drain)' },
    { k: 'Drain flow rate', v: '~25 L / min' },
  ]},
  { title: 'Materials', rows: [
    { k: 'Outer shell', v: 'SUS304 food-grade stainless steel' },
    { k: 'Chamber walls', v: 'SUS304 food-grade stainless steel' },
    { k: 'Rack / tray support frame', v: 'SUS304 food-grade stainless steel' },
    { k: 'Rotating wash arms', v: 'SUS304 food-grade stainless steel' },
    { k: 'Internal piping', v: 'Food-grade silicone + stainless' },
  ]},
  { title: 'Certifications & Standards', rows: [
    { k: 'Safety certification', v: 'CE (full EU compliance)' },
    { k: 'Quality system', v: 'ISO 9001:2015' },
    { k: 'Sanitization standards', v: 'NSF/ANSI 3, EN 12875-2, DIN 10516, FDA Food Code 4-501.112' },
    { k: 'Food-contact materials', v: 'FDA-compliant, EU 1935/2004 compliant' },
    { k: 'Machinery directive', v: 'EN ISO 12100, EN 60204-1 (low-voltage electrical)' },
  ]},
  { title: 'Functional', rows: [
    { k: 'Door-activated auto-start', v: 'Yes (close hood to start)' },
    { k: 'Heat recovery system', v: 'Optional upgrade (15–25% energy savings)' },
    { k: 'Auto detergent dispenser', v: 'Optional upgrade' },
    { k: 'Built-in rinse-aid pump', v: 'Optional upgrade' },
    { k: 'Door interlock cutoff', v: 'Standard' },
    { k: 'Voltage overload protection', v: 'Standard' },
    { k: 'Temperature display', v: 'LED digital' },
    { k: 'Operating noise', v: '≤ 70 dB' },
  ]},
];

const washThumbs = [
  { slug: 'baking-trays-600x400',  label: '600×400 EN-Norm Trays',       img: '/images/600x400-tray-comparison.webp' },
  { slug: 'sheet-pans',            label: 'American Sheet Pans',         img: '/images/what-it-washes/sheet-pans.webp' },
  { slug: 'mixing-bowls',          label: 'Mixing Bowls',                img: '/images/what-it-washes/mixing-bowls.webp' },
  { slug: 'cake-pans',             label: 'Cake Pans',                   img: '/images/what-it-washes/cake-pans.webp' },
  { slug: 'pizza-pans',            label: 'Pizza Pans',                  img: '/images/what-it-washes/pizza-pans.webp' },
  { slug: 'frying-baskets',        label: 'Frying Baskets',              img: '/images/what-it-washes/frying-baskets.webp' },
  { slug: 'stockpots',             label: 'Stockpots',                   img: '/images/what-it-washes/stockpots.webp' },
  { slug: 'dishes-plates',         label: 'Plates & Dishware',           img: '/images/what-it-washes/dishes-plates.webp' },
  { slug: 'utensils-mixers',       label: 'Utensils & Mixer Attachments', img: '/images/what-it-washes/utensils-mixers.webp' },
  { slug: 'large-bakeware',        label: 'Large Bakeware',              img: '/images/what-it-washes/large-bakeware.webp' },
];

const features = [
  { icon: '🛡️', title: 'SUS304 Stainless Construction', text: 'Entire machine is food-grade SUS304 — rust-resistant, rodent-resistant, easy to sanitize.' },
  { icon: '📏', title: 'Extra-Large Wash Chamber', text: '650×550 mm rack fits 600×400 mm Bakery Norm trays, oversized stockpots, KitchenAid bowls.' },
  { icon: '💧', title: 'Dual Rotating Wash Arms + Tray-Specific Nozzles', text: '360° omnidirectional cleaning with tray-optimized nozzle geometry that maximizes water coverage across long flat baking-tray surfaces.' },
  { icon: '🌡️', title: 'Intelligent Temp Control', text: 'Auto-sanitize above 82°C with LED digital display. Modular control board for easy service.' },
  { icon: '💦', title: 'Ultra-Low Water Use', text: 'Just 2.0–2.5 L per cycle vs the 5–10 L most competitors consume.' },
  { icon: '♻️', title: 'Heat Recovery System', text: 'Hot water from the previous high-temp rinse flows into the main wash tank to maintain wash temperature and save energy 15–25%.' },
  { icon: '🚪', title: 'Sealed Insulated Door', text: 'Reduces steam escape by up to 70%, keeping your kitchen cooler and drier.' },
  { icon: '🧑‍🍳', title: 'Ergonomic Operation', text: 'Push-pull basket rails. Door-activated cycle start — close the hood and walk away.' },
  { icon: '🔒', title: 'Multiple Safety Protections', text: 'Door interlock cuts power on open. Voltage overload protection built in.' },
  { icon: '🧪', title: 'Auto Detergent Ready', text: 'Pre-installed interface for automatic dispenser and water-treatment modules.' },
  { icon: '⚡', title: 'CE Safety Certified', text: 'EU compliance. Ready to ship to EU, GCC, APAC, LATAM, Africa.' },
  { icon: '⏱️', title: 'Door-Activated Cycle Start', text: 'Close the hood and the wash cycle starts automatically. No buttons, no waiting.' },
];
---
<BaseLayout
  title="V-TAI JD-3 — Bakingware Hood-type Washer | Full Product"
  description="V-TAI JD-3 hood-type bakery tray washer: 180 trays/hour, 600×400 mm Bakery Norm compatibility, SUS304 stainless steel, CE-certified. From $4,400 FOB Shenzhen."
  locale={locale}
  canonicalPath="/product/"
  schemaType="Product"
  schemaData={{
    name: 'V-TAI JD-3 Bakingware Hood-type Washer',
    sku: 'VT-AE-JD-3',
    brand: { '@type': 'Brand', name: 'V-TAI' },
    description: 'Commercial hood-type dishwasher for bakeries with 650×550 mm rack — fits 600×400 mm European Bakery Norm trays. 180 trays/hour throughput, SUS304 stainless steel, CE-certified.',
    image: 'https://bakerytraywasher.com/images/jd-3-hero.webp',
    offers: { '@type': 'AggregateOffer', offerCount: 3, priceCurrency: 'USD', lowPrice: '4400', highPrice: '4900', priceValidUntil: '2027-12-31', availability: 'https://schema.org/InStock', url: 'https://bakerytraywasher.com/product/' },
  }}
>

<BreadcrumbNav items={[{label: 'Home', href: '/'}, {label: 'Product'}]} />

<section class="section">
  <div class="container-page grid lg:grid-cols-2 gap-10">
    <div>
      <ImagePlaceholder src="/images/jd-3-front.webp" alt="V-TAI JD-3 hood-type bakery tray washer, front view" ratio="4/3" label="JD-3 front view" />
      <div class="grid grid-cols-3 gap-3 mt-3">
        <ImagePlaceholder src="/images/jd-3-trays-loaded.webp" alt="JD-3 with six baking trays loaded in the rack" ratio="1/1" label="Trays loaded" />
        <ImagePlaceholder src="/images/jd-3-led-control.webp" alt="JD-3 LED control panel close-up" ratio="1/1" label="LED control" />
        <ImagePlaceholder src="/images/jd-3-wash-arms.webp" alt="JD-3 wash arms" ratio="1/1" label="Wash arms" />
      </div>
    </div>
    <div>
      <p class="eyebrow mb-2">Model VT-AE-JD-3</p>
      <h1 class="mb-4">V-TAI JD-3 Bakingware Hood-type Washer</h1>
      <p class="text-lg text-bakery-navy/80 mb-5">
        The only commercial hood-type dishwasher in its price class designed for the
        <strong>600×400&nbsp;mm European Bakery Norm</strong> tray standard. Built for
        small commercial kitchens — bakeries, cafés, patisseries, hotel pastry stations.
      </p>
      <div class="grid grid-cols-2 gap-3 mb-6">
        <div class="rounded-card border border-bakery-navy/10 p-3"><p class="text-xs text-bakery-navy/60">Throughput</p><p class="font-semibold">180 trays/hour</p></div>
        <div class="rounded-card border border-bakery-orange/30 p-3 bg-bakery-cream"><p class="text-xs text-bakery-brown">Rack size</p><p class="font-semibold">650×550 mm ⭐</p></div>
        <div class="rounded-card border border-bakery-navy/10 p-3"><p class="text-xs text-bakery-navy/60">Cycle time</p><p class="font-semibold">2 min · 6 trays</p></div>
        <div class="rounded-card border border-bakery-navy/10 p-3"><p class="text-xs text-bakery-navy/60">Total power</p><p class="font-semibold">13 kW</p></div>
      </div>
      <PriceCalloutBox locale={locale} />

      <!-- Spec sheet PDF + Quote -->
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/downloads/jd-3-spec-sheet-en.pdf"
           class="btn-primary inline-flex items-center gap-2"
           download
           aria-label="Download JD-3 spec sheet PDF">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2M7 10l5 5 5-5M12 15V3"/>
          </svg>
          <span>Download Spec Sheet PDF</span>
        </a>
        <a href="/get-quote/" class="btn-secondary inline-flex items-center gap-2">Get a Quote</a>
      </div>
    </div>
  </div>
</section>

<TrustBadgeStrip locale={locale} />

<!-- Full Specifications -->
<section class="section">
  <div class="container-page">
    <div class="text-center max-w-3xl mx-auto mb-8">
      <h2 class="mb-3">Full Specifications</h2>
      <p class="text-bakery-navy/70">Everything procurement, plant engineering, and health-inspection auditors need. Download the <a href="/downloads/jd-3-spec-sheet-en.pdf" class="text-bakery-orange underline" download>PDF version</a> for offline review.</p>
    </div>
    <ProductSpecsTable sections={specSections} />
    <div class="text-center mt-8">
      <a href="/downloads/jd-3-spec-sheet-en.pdf"
         class="btn-primary inline-flex items-center gap-2"
         download>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2M7 10l5 5 5-5M12 15V3"/>
        </svg>
        <span>Download Full Spec Sheet (PDF)</span>
      </a>
    </div>
  </div>
</section>

<!-- How it works -->
<section class="section">
  <div class="container-page">
    <h2 class="text-center mb-10">How It Works — 4 Steps</h2>
    <div class="grid md:grid-cols-4 gap-6">
      {[
        { n: '1', t: 'Load', d: 'Slide racks of trays, pans, or bowls into the chamber.' },
        { n: '2', t: 'Close hood', d: 'Cycle starts automatically — no buttons.' },
        { n: '3', t: 'Wash + rinse', d: 'Dual arms blast 360°. Final rinse hits 82°C.' },
        { n: '4', t: 'Unload', d: 'In 2 minutes (120 sec). Clean, sanitized, drip-drying.' },
      ].map((s) => (
        <div class="text-center">
          <div class="w-12 h-12 mx-auto rounded-full bg-bakery-orange text-white font-bold flex items-center justify-center mb-3">{s.n}</div>
          <h3 class="text-base mb-2">{s.t}</h3>
          <p class="text-sm text-bakery-navy/70">{s.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Watch it work -->
<section class="section">
  <div class="container-page">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <h2 class="mb-3">Watch It Work</h2>
      <p class="text-bakery-navy/70">Two short clips: how to install the JD-3 in your kitchen, and how to fine-tune the built-in detergent dispenser.</p>
    </div>
    <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
      <YouTubeShort
        videoId="bjxEYRiRTnI"
        title="JD-3 Installation Guide"
        caption="Install: water + power + first wash cycle"
      />
      <YouTubeShort
        videoId="Zkf6h8u7mFE"
        title="JD-3: How to adjust the built-in dispenser"
        caption="Adjust: built-in detergent dispenser dosing"
      />
    </div>
  </div>
</section>

<!-- Features grid -->
<section class="section bg-bakery-cream">
  <div class="container-page">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="mb-3">12 Features That Matter</h2>
      <p class="text-bakery-navy/70">Every detail is engineered for the small commercial kitchen — not industrial overkill, not consumer compromise.</p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((f) => (
        <div class="card">
          <div class="text-3xl mb-2">{f.icon}</div>
          <h3 class="text-lg mb-1">{f.title}</h3>
          <p class="text-sm text-bakery-navy/70">{f.text}</p>
        </div>
      ))}
    </div>
    <div class="text-center mt-8">
      <a href="/product/jd-3-features/" class="btn-secondary">Deep dive on all features</a>
    </div>
  </div>
</section>

<!-- What it cleans (thumbnails) -->
<section class="section">
  <div class="container-page">
    <h2 class="text-center mb-3">What It Cleans</h2>
    <p class="text-center text-bakery-navy/70 max-w-2xl mx-auto mb-10">Click any category to see loading patterns, recommended cycle settings, and item-specific FAQs.</p>
    <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {washThumbs.map((w) => (
        <a href={`/what-it-washes/${w.slug}/`} class="card !p-0 overflow-hidden hover:scale-[1.03] transition flex flex-col">
          <img src={w.img} alt={w.label} class="w-full aspect-[4/3] object-cover" loading="lazy" />
          <p class="p-3 text-sm font-medium text-bakery-navy text-center">{w.label}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Configuration options -->
<section class="section bg-bakery-cream">
  <div class="container-page">
    <h2 class="text-center mb-8">Configuration Options</h2>
    <div class="grid md:grid-cols-3 gap-4 max-w-5xl mx-auto">
      {[
        { t: 'Standard Electric', p: '$4,400', d: 'Base JD-3, 380V/3N/50Hz' },
        { t: '+ Auto Detergent Dispenser', p: '$4,600', d: 'Adds liquid detergent & rinse-aid pumps' },
        { t: '+ Heat Recovery Upgrade', p: '$4,900', d: 'Enhanced energy-saving package; hot rinse water flows back into wash tank' },
      ].map((cfg) => (
        <div class="card">
          <h3 class="text-lg mb-1">{cfg.t}</h3>
          <p class="text-2xl font-bold text-bakery-orange mb-2">From {cfg.p}</p>
          <p class="text-sm text-bakery-navy/70">{cfg.d}</p>
        </div>
      ))}
    </div>
    <p class="text-center mt-6 text-sm text-bakery-navy/60">All prices FOB Shenzhen. Shipping and duties depend on destination.</p>
  </div>
</section>

<FAQSection locale={locale} items={[
  { q: 'What is included in the box?', a: 'JD-3 machine, one custom stainless-steel baking-tray support frame, water inlet hose, drain hose, English operation manual, CE certificate.' },
  { q: 'Can it ship to the US?', a: 'Yes. US commercial kitchens typically have a 400V single-phase circuit, which the JD-3 connects to directly. CE-certified machines are imported into the US daily.' },
  { q: 'Warranty?', a: '12-month manufacturer warranty on parts. Spare parts ship globally via international express courier.' },
  { q: 'What if I need spare parts in 5 years?', a: 'All key components — pumps, heating elements, control boards — are stocked at the factory. Same-day shipment of common parts.' },
  { q: 'Can I get a PDF spec sheet?', a: 'Yes. Click the "Download Spec Sheet PDF" button at the top of the page. Need a tender-specific or custom-configuration spec document? Contact us via WhatsApp or email.' },
]} />

<CTASection locale={locale} />
</BaseLayout>
