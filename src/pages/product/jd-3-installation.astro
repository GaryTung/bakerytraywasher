---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import YouTubeShort from '../../components/YouTubeShort.astro';
import CTASection from '../../components/CTASection.astro';
import FAQSection from '../../components/FAQSection.astro';

const locale = 'en' as const;
---
<BaseLayout
  title="JD-3 Installation Guide | V-TAI Bakery Tray Washer Setup"
  description="Receive the machine, follow our video tutorial, connect water and power — and you're ready to wash. The JD-3 is built for fast self-install in any commercial kitchen."
  locale={locale}
  canonicalPath="/product/jd-3-installation/"
  schemaType="HowTo"
  schemaData={{
    name: 'How to install the V-TAI JD-3 hood-type bakery tray washer',
    step: [
      { '@type': 'HowToStep', name: 'Unbox', text: 'Unbox the machine and verify contents against the packing list' },
      { '@type': 'HowToStep', name: 'Position', text: 'Place the JD-3 on a level surface near your existing water inlet and floor drain' },
      { '@type': 'HowToStep', name: 'Connect water', text: 'Connect the G 3/4" cold-water inlet hose and the G 1½" drain hose' },
      { '@type': 'HowToStep', name: 'Connect power', text: 'Plug into a dedicated 380V three-phase circuit (or 400V single-phase per local code)' },
      { '@type': 'HowToStep', name: 'Test', text: 'Run two empty test cycles per the video tutorial and verify final rinse hits 82°C' },
    ],
  }}
>
<BreadcrumbNav items={[{label: 'Home', href: '/'}, {label: 'Product', href: '/product/'}, {label: 'Installation'}]} />

<section class="section">
  <div class="container-prose">
    <h1 class="mb-4">JD-3 Installation — Receive, Connect, Wash</h1>
    <p class="text-lg text-bakery-navy/80 mb-8">
      The JD-3 was designed for self-installation. When the machine arrives, you follow the video tutorial included with delivery, connect water and electricity, and start washing. No specialized installer required for most kitchens — a regular plumber and electrician are sufficient.
    </p>

    <YouTubeShort
      videoId="bjxEYRiRTnI"
      title="JD-3 Commercial Dishwasher Installation Guide"
      caption="Watch: receive the machine, connect water and power, run the first cycle — full self-install in under 30 seconds of video."
    />

    <h2 class="mt-10 mb-4">The Process — 3 Simple Steps</h2>

    <h3 class="mt-6 mb-2">Step 1: Unbox &amp; Position</h3>
    <p>Open the crate, lift the machine onto a level surface near your existing water inlet and floor drain. The footprint is 804 × 816 mm — about the size of a small cabinet.</p>

    <h3 class="mt-6 mb-2">Step 2: Connect Water &amp; Electricity</h3>
    <ul class="space-y-2 list-disc list-inside mt-3">
      <li><strong>Cold water inlet:</strong> G 3/4" thread, 2.5–6 kg/cm² pressure. A standard kitchen tap connection works.</li>
      <li><strong>Drain:</strong> G 1½" hose to your floor drain (or wall drain) within ~1.5 m.</li>
      <li><strong>Electricity:</strong> 380V three-phase / 50Hz, dedicated circuit, 21.5 A. A licensed electrician completes the connection in ~45 minutes.</li>
      <li>For US deployments: see the FAQ note about 400V single-phase circuits common in US commercial kitchens.</li>
    </ul>

    <h3 class="mt-6 mb-2">Step 3: Follow the Video Tutorial &amp; Start Washing</h3>
    <p>Every JD-3 ships with a printed quick-start card pointing to our video tutorial (also available via WhatsApp the moment you place an order). The tutorial walks through:</p>
    <ul class="space-y-1 list-disc list-inside mt-2">
      <li>Filling the wash tank for first use</li>
      <li>Loading racks with baking trays / pans / bowls</li>
      <li>Closing the hood — cycle auto-starts</li>
      <li>Daily cleaning routine (2 minutes at end of day)</li>
    </ul>

    <h2 class="mt-10 mb-4">What's Included in the Box</h2>
    <ul class="space-y-1 list-disc list-inside">
      <li>JD-3 machine</li>
      <li>2 standard wash racks + peg cup rack</li>
      <li>Cold-water inlet hose &amp; drain hose</li>
      <li>Basic install hardware</li>
      <li>Quick-start card with video-tutorial link</li>
      <li>English operation manual</li>
      <li>CE certificate</li>
      <li><strong>Circuit diagram</strong> (taped to the inside of the service panel — keep it there for future maintenance)</li>
    </ul>

    <h2 class="mt-10 mb-4">Typical Installation Timeline</h2>
    <p>For a competent kitchen with existing water and a dedicated electrical circuit, total install time is typically 1–2 hours. The longest single step is usually the electrician's wiring connection. We provide remote support via WhatsApp video call if anything is unclear.</p>
  </div>
</section>

<FAQSection items={[
  { q: 'Do I need a specialized installer?', a: 'No — a regular licensed plumber for the water connection and a regular licensed electrician for the power connection are sufficient. We provide a video tutorial and remote WhatsApp support.' },
  { q: 'How long does install actually take?', a: 'For a kitchen with existing water and electrical capacity, 1–2 hours typical. The water and drain connection is ~30 minutes; the electrical connection is ~45 minutes; testing is ~15 minutes.' },
  { q: 'Can it ship to the US?', a: 'Yes. US commercial kitchens typically have a 400V single-phase circuit available; the JD-3 connects to this directly. For a 220V single-phase only kitchen, ask for a 220V-conversion option in your quote.' },
  { q: 'What if the machine breaks?', a: 'Our machine ships with the circuit diagram taped inside the service panel. A regular electrician can diagnose and repair most issues using the diagram. For replacement parts, we ship globally via DHL/FedEx within 5 business days.' },
  { q: 'Can the JD-3 be moved later?', a: 'Yes. It is not bolted to the floor. Two adults can move it on a furniture dolly. Reconnecting at a new location is straightforward.' },
]} />

<CTASection locale={locale} title="Need installation help?" subtitle="Share your kitchen layout and we'll review feasibility before you commit." />
</BaseLayout>
