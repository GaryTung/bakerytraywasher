---
import BaseLayout from './BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import InlineInquiryForm from '../components/InlineInquiryForm.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import { type Locale, localizePath, t } from '../i18n/utils';

const sectionHeadings: Record<Locale, { reality: string; needs: string; fit: string; roi: string; related: string }> = {
  en: { reality: 'Your Business Reality', needs: 'What You Specifically Need From a Dishwasher', fit: 'How JD-3 Fits Your Operation', roi: 'ROI for Your Operation', related: 'Related reading' },
  es: { reality: 'Su Realidad de Negocio', needs: 'Lo que Específicamente Necesita de una Lavadora', fit: 'Cómo Encaja la JD-3 en Su Operación', roi: 'ROI para Su Operación', related: 'Lectura relacionada' },
  fr: { reality: 'Votre Réalité Commerciale', needs: 'Ce dont Vous Avez Spécifiquement Besoin', fit: "Comment le JD-3 S'intègre", roi: 'ROI pour Votre Opération', related: 'Lecture connexe' },
  de: { reality: 'Ihre Geschäftsrealität', needs: 'Was Sie speziell brauchen', fit: 'Wie der JD-3 in Ihren Betrieb passt', roi: 'ROI für Ihren Betrieb', related: 'Verwandte Beiträge' },
  ru: { reality: 'Ваша бизнес-реальность', needs: 'Что вам конкретно нужно от мойки', fit: 'Как JD-3 подходит вашему бизнесу', roi: 'Окупаемость для вашего бизнеса', related: 'Связанные материалы' },
  th: { reality: 'ความเป็นจริงของธุรกิจคุณ', needs: 'สิ่งที่คุณต้องการจากเครื่องล้าง', fit: 'JD-3 เหมาะกับการดำเนินงานคุณอย่างไร', roi: 'ROI สำหรับการดำเนินงานของคุณ', related: 'อ่านที่เกี่ยวข้อง' },
  vi: { reality: 'Thực tế kinh doanh của bạn', needs: 'Bạn cần gì cụ thể từ máy rửa', fit: 'JD-3 phù hợp với hoạt động của bạn ra sao', roi: 'ROI cho hoạt động của bạn', related: 'Đọc liên quan' },
  ar: { reality: 'واقع عملك', needs: 'ما تحتاجه تحديداً من غسالة الأطباق', fit: 'كيف يلائم JD-3 عملياتك', roi: 'العائد على الاستثمار لعملياتك', related: 'قراءات ذات صلة' },
};

interface QA { q: string; a: string }
interface Props {
  locale: Locale;
  canonicalPath: string;
  slug: string;
  businessName: string;
  title: string;
  description: string;
  reality: string;
  needs: string;
  fit: string;
  roi: string;
  faqs: QA[];
  icon?: string;
}
const { locale, canonicalPath, slug, businessName, title, description, reality, needs, fit, roi, faqs, icon = '🥐' } = Astro.props;
const h = sectionHeadings[locale];
const lp = (p: string) => localizePath(p, locale);

// Map slug → real image path (uploaded under public/images/business-types/).
// Slugs without an uploaded image fall back to the gradient placeholder.
const businessImages: Record<string, string> = {
  'bakery-shop': '/images/business-types/bakery-shop.webp',
  'coffee-chain': '/images/business-types/coffee-chain.jpeg',
  'patisserie': '/images/business-types/patisserie.webp',
  'cake-shop': '/images/business-types/cake-shop.webp',
  'small-restaurant': '/images/business-types/small-restaurant.jpeg',
  'cafeteria': '/images/business-types/cafeteria.webp',
};
const heroImage = businessImages[slug];
---
<BaseLayout title={title} description={description} locale={locale} canonicalPath={canonicalPath} schemaType="Article">
<BreadcrumbNav items={[{label: t(locale, 'nav.home'), href: lp('/')}, {label: t(locale, 'nav.business'), href: lp('/by-business-type/')}, {label: businessName}]} />

<section class="section">
  <div class="container-page grid lg:grid-cols-3 gap-10">
    <article class="lg:col-span-2 prose-section">
      <div class="text-5xl mb-4">{icon}</div>
      <h1 class="mb-3">{title}</h1>
      <p class="text-lg text-bakery-navy/80 mb-8">{description}</p>

      <ImagePlaceholder src={heroImage} alt={`${businessName} — JD-3`} ratio="16/9" label={businessName} />

      <h2 class="mt-10 mb-3">{h.reality}</h2>
      <p class="text-bakery-navy/80 leading-relaxed whitespace-pre-line">{reality}</p>

      <h2 class="mt-10 mb-3">{h.needs}</h2>
      <p class="text-bakery-navy/80 leading-relaxed whitespace-pre-line">{needs}</p>

      <h2 class="mt-10 mb-3">{h.fit}</h2>
      <p class="text-bakery-navy/80 leading-relaxed whitespace-pre-line">{fit}</p>

      <h2 class="mt-10 mb-3">{h.roi}</h2>
      <p class="text-bakery-navy/80 leading-relaxed whitespace-pre-line">{roi}</p>
    </article>

    <aside class="lg:sticky lg:top-24 self-start">
      <InlineInquiryForm locale={locale} businessTypePreset={businessName} title={businessName} />
      <div class="mt-6 card">
        <h3 class="text-base mb-3">{h.related}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={lp('/what-it-washes/baking-trays-600x400/')} class="hover:underline">600×400 mm</a></li>
          <li><a href={lp('/pricing/')} class="hover:underline">{t(locale, 'nav.pricing')}</a></li>
          <li><a href={lp('/vs/')} class="hover:underline">{t(locale, 'nav.compare')}</a></li>
          <li><a href={lp('/contact/')} class="hover:underline">{t(locale, 'nav.contact')}</a></li>
        </ul>
      </div>
    </aside>
  </div>
</section>

<FAQSection items={faqs} locale={locale} />

<CTASection locale={locale} />
</BaseLayout>
