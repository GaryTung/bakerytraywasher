---
import BaseLayout from './BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import InlineInquiryForm from '../components/InlineInquiryForm.astro';
import CTASection from '../components/CTASection.astro';
import type { CountryPrice } from '../data/countries';
import { type Locale, localizePath } from '../i18n/utils';

interface Props {
  locale: Locale;
  canonicalPath: string;
  country: CountryPrice;
}
const { locale, country, canonicalPath } = Astro.props;
const lp = (p: string) => localizePath(p, locale);

const surcharge = country.usdApprox - 4400;
---
<BaseLayout
  title={`JD-3 Delivered to ${country.name} — ${country.priceLocal} DDP ${country.city}`}
  description={`Transparent landed price for the V-TAI JD-3 bakery tray washer delivered to ${country.name}: ${country.priceLocal} DDP via ${country.port}. FOB Shenzhen $4,400 USD + freight + duties + last-mile = single all-in price.`}
  locale={locale}
  canonicalPath={canonicalPath}
  schemaType="Product"
  schemaData={{
    name: `V-TAI JD-3 — Delivered to ${country.name}`,
    offers: {
      '@type': 'Offer',
      priceCurrency: country.currency,
      price: country.usdApprox,
      availability: 'https://schema.org/InStock',
      areaServed: country.name,
    },
  }}
>
<BreadcrumbNav items={[
  { label: 'Home', href: lp('/') },
  { label: 'Pricing', href: lp('/pricing/') },
  { label: 'By Country', href: lp('/pricing/by-country/') },
  { label: country.name }
]} />

<section class="section">
  <div class="container-page grid lg:grid-cols-3 gap-10">
    <article class="lg:col-span-2 prose-section">
      <p class="eyebrow mb-2">Landed price · {country.region}</p>
      <h1 class="mb-4">JD-3 Delivered to {country.name}: <span class="text-bakery-orange">{country.priceLocal}</span> DDP {country.city}</h1>
      <p class="text-lg text-bakery-navy/80 mb-6">
        We handle ocean freight, customs clearance, import duty, and last-mile delivery to your address.
        You receive one transparent price — no surprise charges at the port, no customs-broker invoice, no last-mile mystery.
      </p>

      <!-- Big price callout -->
      <div class="card bg-gradient-to-br from-bakery-cream to-white border-2 border-bakery-orange/30 mb-8">
        <p class="eyebrow mb-1">DDP {country.city}</p>
        <p class="text-4xl md:text-5xl font-bold text-bakery-navy">
          {country.priceLocal}
        </p>
        <p class="text-sm text-bakery-navy/60 mt-2">
          (~${country.usdApprox.toLocaleString('en-US')} USD equivalent · subject to FX fluctuation)
        </p>
        <a href={lp('/get-quote/')} class="btn-primary mt-4 w-full md:w-auto">
          Get a DDP Quote for Your {country.name} Address
        </a>
      </div>

      <h2 class="mt-10 mb-3">How the Price Breaks Down</h2>
      <div class="card !p-0 overflow-hidden">
        <table class="w-full text-sm">
          <tbody>
            <tr><td class="p-3 border-b border-bakery-navy/5">FOB Shenzhen (Standard JD-3)</td><td class="p-3 border-b border-bakery-navy/5 text-right font-semibold">$4,400 USD</td></tr>
            <tr><td class="p-3 border-b border-bakery-navy/5">+ Ocean freight ({country.port})</td><td class="p-3 border-b border-bakery-navy/5 text-right text-bakery-navy/70">included</td></tr>
            <tr><td class="p-3 border-b border-bakery-navy/5">+ Customs clearance &amp; import duty</td><td class="p-3 border-b border-bakery-navy/5 text-right text-bakery-navy/70">included</td></tr>
            <tr><td class="p-3 border-b border-bakery-navy/5">+ Local VAT/GST (where included)</td><td class="p-3 border-b border-bakery-navy/5 text-right text-bakery-navy/70">see note below</td></tr>
            <tr><td class="p-3 border-b border-bakery-navy/5">+ Last-mile delivery to your {country.name} address</td><td class="p-3 border-b border-bakery-navy/5 text-right text-bakery-navy/70">included</td></tr>
            <tr class="bg-bakery-cream font-bold">
              <td class="p-3">DDP {country.city} total</td>
              <td class="p-3 text-right text-bakery-orange text-lg">{country.priceLocal}</td>
            </tr>
            <tr><td class="p-3 text-bakery-navy/60 text-xs">USD-equivalent surcharge over FOB</td><td class="p-3 text-right text-bakery-navy/60 text-xs">~${surcharge.toLocaleString('en-US')}</td></tr>
          </tbody>
        </table>
      </div>

      <h2 class="mt-10 mb-3">What&rsquo;s Included</h2>
      <ul class="list-disc list-inside space-y-2">
        <li>V-TAI JD-3 Bakingware Hood-type Washer (Standard configuration, 380V/3N/50Hz)</li>
        <li>2 standard wash racks, peg cup rack, basic tools, English operation manual</li>
        <li>CE certificate &amp; commercial invoice</li>
        <li>Sea freight Shenzhen → {country.port}</li>
        <li>Customs clearance &amp; import duty: {country.importDutyNote}</li>
        <li>Local tax: {country.vatGstNote}</li>
        <li>Last-mile delivery to your address in {country.name}</li>
        <li>12-month manufacturer warranty (parts) — replacement parts ship globally via DHL/FedEx</li>
      </ul>

      <h2 class="mt-10 mb-3">What&rsquo;s NOT Included</h2>
      <ul class="list-disc list-inside space-y-2">
        <li>Local installation labor (licensed electrician + plumber, typically $200–$500 in {country.name})</li>
        <li>Optional accessories (auto-detergent dispenser +$200, heat recovery module +$400, water treatment +$500)</li>
        <li>Operator training is provided via WhatsApp video call (30 min, included free)</li>
      </ul>

      <h2 class="mt-10 mb-3">Lead Time — Order to Your Door</h2>
      <ol class="list-decimal list-inside space-y-2">
        <li>Order confirmation &amp; 30% deposit received (Day 0)</li>
        <li>Production at our Shenzhen facility: 4–6 weeks</li>
        <li>70% balance payment + booking ocean freight</li>
        <li>Ocean freight Shenzhen → {country.port}: <strong>{country.seaFreightDays} days</strong></li>
        <li>Customs clearance: 2–5 business days</li>
        <li>Last-mile trucking to your address: 3–7 days</li>
        <li><strong>Total: typically {country.leadTimeWeeks} weeks from order to your door</strong></li>
      </ol>

      <h2 class="mt-10 mb-3">Reference City Note</h2>
      <p class="text-bakery-navy/80">{country.refCityNote}</p>

      <h2 class="mt-10 mb-3">Why DDP Pricing Matters</h2>
      <p class="text-bakery-navy/80">Most overseas exporters quote FOB and leave the freight forwarding, customs broker, and last-mile to the buyer — three separate vendors, three invoices, and surprise costs at every step. We bundle all of that into a single quoted price so you know exactly what you&rsquo;ll pay before placing the order.</p>
      <p class="text-bakery-navy/80 mt-3">The price above is what you actually pay to receive the machine at your door in {country.name}. The local-currency figure is the authoritative number; the USD equivalent is shown for reference and may shift with exchange-rate movement.</p>
    </article>

    <aside class="lg:sticky lg:top-24 self-start">
      <InlineInquiryForm locale={locale} title={`Quote for ${country.name}`} />
      <div class="mt-6 card">
        <h3 class="text-base mb-3">Other markets</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={lp('/pricing/by-country/')} class="hover:underline">See all 18 countries</a></li>
          <li><a href={lp('/pricing/')} class="hover:underline">FOB pricing &amp; tiers</a></li>
          <li><a href={lp('/product/')} class="hover:underline">Full product spec</a></li>
          <li><a href={lp('/contact/')} class="hover:underline">Contact us directly</a></li>
        </ul>
      </div>
    </aside>
  </div>
</section>

<CTASection locale={locale} title={`Need DDP delivery to ${country.name}?`} subtitle={`Request a quote with your specific city. We respond within 12 hours with a final all-in figure.`} />
</BaseLayout>
