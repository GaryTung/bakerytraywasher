const s = STRINGS[locale];
---
<BaseLayout
  title={`${s.deliveredTo} ${country.name} — ${country.priceLocal} DDP ${country.city}`}
  description={`${s.deliveredTo} ${country.name}: ${country.priceLocal} DDP via ${country.port}. FOB Shenzhen $4,400 USD.`}
  locale={locale}
  canonicalPath={canonicalPath}
  schemaType="Product"
  schemaData={{
    name: `V-TAI JD-3 — Delivered to ${country.name}`,
    description: `V-TAI JD-3 commercial bakery-tray hood-type washer delivered DDP to ${country.name}. Landed price ${country.priceLocal} via ${country.port}, includes ocean freight, customs clearance, import duty, and last-mile delivery. CE certified; 12-month parts warranty.`,
    image: [
      'https://bakerytraywasher.com/images/jd-3-hero.webp',
      'https://bakerytraywasher.com/images/jd-3-front.webp',
      'https://bakerytraywasher.com/images/jd-3-trays-loaded.webp',
    ],
    sku: `VTAI-JD-3-${country.slug.toUpperCase()}`,
    mpn: 'JD-3',
    brand: { '@type': 'Brand', name: 'V-TAI' },
    manufacturer: {
      '@type': 'Organization',
      name: 'Shenzhen Vtai Electrical Appliance Co., Ltd.',
      url: 'https://bakerytraywasher.com',
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '4.8',
      reviewCount: '47',
      bestRating: '5',
      worstRating: '1',
    },
    offers: {
      '@type': 'Offer',
      priceCurrency: country.currency,
      price: country.usdApprox,
      priceValidUntil: '2027-12-31',
      availability: 'https://schema.org/InStock',
      itemCondition: 'https://schema.org/NewCondition',
      areaServed: country.name,
      url: `https://bakerytraywasher.com${canonicalPath}`,
      seller: {
        '@type': 'Organization',
        name: 'Shenzhen Vtai Electrical Appliance Co., Ltd.',
      },
      hasMerchantReturnPolicy: {
        '@type': 'MerchantReturnPolicy',
        applicableCountry: country.name,
        returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
        merchantReturnDays: 30,
        returnMethod: 'https://schema.org/ReturnByMail',
        returnFees: 'https://schema.org/ReturnShippingFees',
      },
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        shippingRate: { '@type': 'MonetaryAmount', value: '0', currency: country.currency },
        shippingDestination: { '@type': 'DefinedRegion', addressCountry: country.name },
        deliveryTime: {
          '@type': 'ShippingDeliveryTime',
          handlingTime: { '@type': 'QuantitativeValue', minValue: 28, maxValue: 32, unitCode: 'DAY' },
          transitTime: { '@type': 'QuantitativeValue', minValue: 25, maxValue: 45, unitCode: 'DAY' },
        },
      },
    },
  }}
>
<BreadcrumbNav items={[
  { label: t(locale, 'nav.home'), href: lp('/') },
  { label: t(locale, 'nav.pricing'), href: lp('/pricing/') },
  { label: t(locale, 'nav.ddpByCountry'), href: lp('/pricing/by-country/') },
  { label: country.name }
]} />

<section class="section">
  <div class="container-page grid lg:grid-cols-3 gap-10">
    <article class="lg:col-span-2 prose-section">
      <p class="eyebrow mb-2">{s.landedPrice} · {s.region}</p>
      <h1 class="mb-4">{s.deliveredTo} {country.name}: <span class="text-bakery-orange">{country.priceLocal}</span> {s.ddp} {country.city}</h1>
      <p class="text-lg text-bakery-navy/80 mb-6">{s.intro}</p>

      <!-- Big price callout -->
      <div class="card bg-gradient-to-br from-bakery-cream to-white border-2 border-bakery-orange/30 mb-8">
        <p class="eyebrow mb-1">{s.ddp} {country.city}</p>
        <p class="text-4xl md:text-5xl font-bold text-bakery-navy">{country.priceLocal}</p>
        <p class="text-sm text-bakery-navy/60 mt-2">
          (~${country.usdApprox.toLocaleString('en-US')} {s.fxFluctuation})
        </p>
        <a href={lp('/get-quote/')} class="btn-primary mt-4 w-full md:w-auto">{s.getQuoteCta}</a>
      </div>

      <h2 class="mt-10 mb-3">{s.breakdownHeading}</h2>
      <div class="card !p-0 overflow-hidden">
        <table class="w-full text-sm">
          <tbody>
            <tr><td class="p-3 border-b border-bakery-navy/5">{s.rowFob}</td><td class="p-3 border-b border-bakery-navy/5 text-right font-semibold">$4,400 USD</td></tr>
            <tr><td class="p-3 border-b border-bakery-navy/5">+ {s.rowFreight} ({country.port})</td><td class="p-3 border-b border-bakery-navy/5 text-right text-bakery-navy/70">{s.included}</td></tr>
            <tr><td class="p-3 border-b border-bakery-navy/5">+ {s.rowCustoms}</td><td class="p-3 border-b border-bakery-navy/5 text-right text-bakery-navy/70">{s.included}</td></tr>
            <tr><td class="p-3 border-b border-bakery-navy/5">+ {s.rowVat}</td><td class="p-3 border-b border-bakery-navy/5 text-right text-bakery-navy/70">{s.seeNote}</td></tr>
            <tr><td class="p-3 border-b border-bakery-navy/5">+ {s.rowLastMile}</td><td class="p-3 border-b border-bakery-navy/5 text-right text-bakery-navy/70">{s.included}</td></tr>
            <tr class="bg-bakery-cream font-bold">
              <td class="p-3">{s.total} ({country.city})</td>
              <td class="p-3 text-right text-bakery-orange text-lg">{country.priceLocal}</td>
            </tr>
            <tr><td class="p-3 text-bakery-navy/60 text-xs">{s.surcharge}</td><td class="p-3 text-right text-bakery-navy/60 text-xs">~${surcharge.toLocaleString('en-US')}</td></tr>
          </tbody>
        </table>
      </div>

      <h2 class="mt-10 mb-3">{s.whatsIncluded}</h2>
      <ul class="list-disc list-inside space-y-2">
        {s.includesItems.map((item) => <li>{item}</li>)}
      </ul>

      <h2 class="mt-10 mb-3">{s.whatsNotIncluded}</h2>
      <ul class="list-disc list-inside space-y-2">
        {s.excludesItems.map((item) => <li>{item}</li>)}
      </ul>

      <h2 class="mt-10 mb-3">{s.leadTimeHeading}</h2>
      <ol class="list-decimal list-inside space-y-2">
        {s.leadTimeSteps.map((step) => <li>{step}</li>)}
        <li><strong>{s.totalLeadTime} {country.leadTimeWeeks} {t(locale, 'country.weekShort')}</strong></li>
      </ol>

      <h2 class="mt-10 mb-3">{s.refCityHeading}</h2>
      <p class="text-bakery-navy/80">{country.refCityNote}</p>

      <h2 class="mt-10 mb-3">{s.whyDdp}</h2>
      <p class="text-bakery-navy/80">{s.whyDdpP1}</p>
      <p class="text-bakery-navy/80 mt-3">{s.whyDdpP2}</p>
    </article>

    <aside class="lg:sticky lg:top-24 self-start">
      <InlineInquiryForm locale={locale} title={`${s.getQuoteCta} — ${country.name}`} />
      <div class="mt-6 card">
        <h3 class="text-base mb-3">{s.sidebarTitle}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={lp('/pricing/by-country/')} class="hover:underline">{s.sidebarSee18}</a></li>
          <li><a href={lp('/pricing/')} class="hover:underline">{s.sidebarFob}</a></li>
          <li><a href={lp('/product/')} class="hover:underline">{s.sidebarSpec}</a></li>
          <li><a href={lp('/contact/')} class="hover:underline">{s.sidebarContact}</a></li>
        </ul>
      </div>
    </aside>
  </div>
</section>

<CTASection locale={locale} title={s.ctaTitle} subtitle={s.ctaSubtitle} />
</BaseLayout>
