---
import BaseLayout from './BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import InlineInquiryForm from '../components/InlineInquiryForm.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import { type Locale, localizePath, t } from '../i18n/utils';
import { washesNames } from '../i18n/categories';

const headings: Record<Locale, { challenge: string; howItHandles: string; recommendedSettings: string; moreItems: string }> = {
  en: { challenge: 'The Cleaning Challenge', howItHandles: 'How the JD-3 Handles It', recommendedSettings: 'Recommended Settings', moreItems: 'More items the JD-3 washes' },
  es: { challenge: 'El Desafío de Limpieza', howItHandles: 'Cómo lo Maneja la JD-3', recommendedSettings: 'Configuración Recomendada', moreItems: 'Más artículos que lava la JD-3' },
  fr: { challenge: 'Le Défi de Nettoyage', howItHandles: 'Comment le JD-3 le Gère', recommendedSettings: 'Réglages Recommandés', moreItems: 'Autres articles lavés par le JD-3' },
  de: { challenge: 'Die Reinigungsherausforderung', howItHandles: 'Wie der JD-3 es bewältigt', recommendedSettings: 'Empfohlene Einstellungen', moreItems: 'Weitere Artikel, die der JD-3 spült' },
  ru: { challenge: 'Задача очистки', howItHandles: 'Как JD-3 справляется', recommendedSettings: 'Рекомендованные настройки', moreItems: 'Что ещё моет JD-3' },
  th: { challenge: 'ความท้าทายในการทำความสะอาด', howItHandles: 'JD-3 จัดการอย่างไร', recommendedSettings: 'การตั้งค่าที่แนะนำ', moreItems: 'รายการอื่นๆ ที่ JD-3 ล้าง' },
  vi: { challenge: 'Thách thức làm sạch', howItHandles: 'JD-3 xử lý như thế nào', recommendedSettings: 'Cài đặt được khuyến nghị', moreItems: 'Các vật khác JD-3 rửa được' },
  ar: { challenge: 'تحدي التنظيف', howItHandles: 'كيف يتعامل JD-3 معه', recommendedSettings: 'الإعدادات الموصى بها', moreItems: 'المزيد من المواد التي يغسلها JD-3' },
};

interface QA { q: string; a: string }
interface Props {
  locale: Locale;
  canonicalPath: string;
  itemName: string;
  title: string;
  description: string;
  challenge: string;
  howItHandles: string;
  recommendedSettings: string;
  faqs: QA[];
}
const { locale, canonicalPath, itemName, title, description, challenge, howItHandles, recommendedSettings, faqs } = Astro.props;
const h = headings[locale];
const lp = (p: string) => localizePath(p, locale);

// canonicalPath is /what-it-washes/{slug}/ — derive slug for the hero image.
// All 10 slugs have a matching webp in /public/images/what-it-washes/ — except
// baking-trays-600x400, which uses a wider comparison infographic instead.
const slugMatch = canonicalPath.match(/\/what-it-washes\/([^/]+)\//);
const slug = slugMatch ? slugMatch[1] : '';
const heroImage = slug === 'baking-trays-600x400'
  ? '/images/600x400-tray-comparison.webp'
  : (slug ? `/images/what-it-washes/${slug}.webp` : undefined);
---
<BaseLayout title={title} description={description} locale={locale} canonicalPath={canonicalPath} schemaType="Article">
<BreadcrumbNav items={[{label: t(locale, 'nav.home'), href: lp('/')}, {label: t(locale, 'nav.washes'), href: lp('/what-it-washes/')}, {label: itemName}]} />

<section class="section">
  <div class="container-page grid lg:grid-cols-3 gap-10">
    <article class="lg:col-span-2 prose-section">
      <h1 class="mb-4">{title}</h1>
      <p class="text-lg text-bakery-navy/80 mb-6">{description}</p>

      <ImagePlaceholder src={heroImage} alt={itemName} ratio="16/9" label={itemName} />

      <h2 class="mt-10 mb-3">{h.challenge}</h2>
      <p class="text-bakery-navy/80 leading-relaxed whitespace-pre-line">{challenge}</p>

      <h2 class="mt-10 mb-3">{h.howItHandles}</h2>
      <p class="text-bakery-navy/80 leading-relaxed whitespace-pre-line">{howItHandles}</p>

      <h2 class="mt-10 mb-3">{h.recommendedSettings}</h2>
      <p class="text-bakery-navy/80 leading-relaxed whitespace-pre-line">{recommendedSettings}</p>
    </article>

    <aside class="lg:sticky lg:top-24 self-start">
      <InlineInquiryForm locale={locale} title={t(locale, 'cta.quote')} />
      <div class="mt-6 card">
        <h3 class="text-base mb-3">{h.moreItems}</h3>
        <ul class="space-y-2 text-sm">
          {(['baking-trays-600x400','sheet-pans','mixing-bowls','cake-pans','pizza-pans','stockpots'] as const).map((slug) => (
            <li><a href={lp(`/what-it-washes/${slug}/`)} class="hover:underline">{washesNames[slug][locale]}</a></li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</section>

<FAQSection items={faqs} locale={locale} />

<CTASection locale={locale} />
</BaseLayout>
