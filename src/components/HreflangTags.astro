---
import { languages, localeLang, getTranslatedLocales, type Locale } from '../i18n/utils';

interface Props {
  canonicalPath: string; // e.g. "/product/"
}
const { canonicalPath } = Astro.props;
const site = 'https://bakerytraywasher.com';
const available = getTranslatedLocales(canonicalPath);

function localeUrl(loc: Locale, path: string) {
  return loc === 'en' ? `${site}${path}` : `${site}/${loc}${path}`;
}
---
{available.map((loc) => (
  <link rel="alternate" hreflang={localeLang[loc].toLowerCase()} href={localeUrl(loc, canonicalPath)} />
))}
<link rel="alternate" hreflang="x-default" href={`${site}${canonicalPath}`} />
