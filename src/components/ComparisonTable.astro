---
interface Row { label: string; jd3: string; competitor: string; highlight?: boolean }
interface Props { competitorName: string; rows: Row[] }
const { competitorName, rows } = Astro.props;
---
<div class="overflow-x-auto card !p-0">
  <table class="w-full text-sm">
    <thead class="bg-bakery-navy text-white">
      <tr>
        <th class="text-left p-4 font-semibold">Specification</th>
        <th class="text-left p-4 font-semibold">V-TAI JD-3</th>
        <th class="text-left p-4 font-semibold">{competitorName}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr class={r.highlight ? 'bg-bakery-cream' : ''}>
          <td class="p-4 border-t border-bakery-navy/5 font-medium">{r.label}</td>
          <td class="p-4 border-t border-bakery-navy/5 text-bakery-brown font-semibold" set:html={r.jd3} />
          <td class="p-4 border-t border-bakery-navy/5 text-bakery-navy/70" set:html={r.competitor} />
        </tr>
      ))}
    </tbody>
  </table>
</div>
