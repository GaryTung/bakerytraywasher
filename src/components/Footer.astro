---
import { t, localizePath, type Locale } from '../i18n/utils';
import { siteIdentity } from '../i18n/site-identity';

interface Props { locale: Locale }
const { locale } = Astro.props;
const lp = (p: string) => localizePath(p, locale);
const year = new Date().getFullYear();
const identity = siteIdentity[locale];
---
<footer class="bg-bakery-navy text-white mt-16">
  <div class="container-page py-12 grid md:grid-cols-5 gap-8">
    <div class="md:col-span-2">
      <a href={lp('/')} class="inline-flex mb-3" aria-label="V-TAI JD-3 Bakery Tray Washer">
        <img src="/images/vtai-logo-gold.png" alt="V-TAI" width="600" height="192" class="h-12 w-auto" loading="lazy" />
      </a>
      <p class="text-sm text-white/80 leading-relaxed mb-4">
        {t(locale, 'footer.tagline')}
      </p>
      <div class="space-y-2 text-sm text-white/80">
        <p>Email: <a href="mailto:info@v-tai.com" class="hover:text-white">info@v-tai.com</a></p>
        <p>WhatsApp: <a href="https://wa.me/8613509623269" class="hover:text-white">+86 135 0962 3269</a></p>
        <p class="text-white/60 mt-3 text-xs">{t(locale, 'footer.address')}</p>
      </div>
    </div>

    <div>
      <h3 class="text-white text-sm font-semibold uppercase tracking-wider mb-3">{t(locale, 'footer.quickLinks')}</h3>
      <ul class="space-y-2 text-sm text-white/80">
        <li><a href={lp('/product/')} class="hover:text-white">{t(locale, 'nav.product')}</a></li>
        <li><a href={lp('/by-business-type/bakery-shop/')} class="hover:text-white">{t(locale, 'nav.business')}</a></li>
        <li><a href={lp('/what-it-washes/baking-trays-600x400/')} class="hover:text-white">{t(locale, 'nav.washes')}</a></li>
        <li><a href={lp('/vs/')} class="hover:text-white">{t(locale, 'nav.compare')}</a></li>
        <li><a href={lp('/pricing/')} class="hover:text-white">{t(locale, 'nav.pricing')}</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-white text-sm font-semibold uppercase tracking-wider mb-3">{t(locale, 'footer.resources')}</h3>
      <ul class="space-y-2 text-sm text-white/80">
        <li><a href={lp('/pricing/by-country/')} class="hover:text-white">{t(locale, 'nav.ddpByCountry')}</a></li>
        <li><a href={lp('/guides/')} class="hover:text-white">{t(locale, 'nav.guides')}</a></li>
        <li><a href={lp('/case-studies/')} class="hover:text-white">{t(locale, 'nav.cases')}</a></li>
        <li><a href={lp('/blog/')} class="hover:text-white">{t(locale, 'nav.blog')}</a></li>
        <li><a href={lp('/faq/')} class="hover:text-white">{t(locale, 'nav.faq')}</a></li>
        <li><a href={lp('/about/')} class="hover:text-white">{t(locale, 'nav.about')}</a></li>
        <li><a href={lp('/contact/')} class="hover:text-white">{t(locale, 'nav.contact')}</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-white text-sm font-semibold uppercase tracking-wider mb-3">{t(locale, 'footer.languages')}</h3>
      <ul class="grid grid-cols-2 gap-2 text-sm text-white/80">
        <li><a href="/" class="hover:text-white">English</a></li>
        <li><a href="/es/" class="hover:text-white">Español</a></li>
        <li><a href="/fr/" class="hover:text-white">Français</a></li>
        <li><a href="/de/" class="hover:text-white">Deutsch</a></li>
        <li><a href="/ru/" class="hover:text-white">Русский</a></li>
        <li><a href="/ar/" class="hover:text-white">العربية</a></li>
        <li><a href="/th/" class="hover:text-white">ไทย</a></li>
        <li><a href="/vi/" class="hover:text-white">Tiếng Việt</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page py-5 grid md:grid-cols-[1fr_auto] gap-4 items-start text-xs text-white/65">
      <div class="space-y-1">
        <p>© {year} Shenzhen Vtai Electrical Appliance Co., Ltd. {t(locale, 'footer.rights')}</p>
        <p>{identity.operator}</p>
        <p>{identity.specialist}</p>
      </div>
      <div class="flex flex-wrap gap-x-3 gap-y-1 md:justify-end">
        <a href={lp('/about/')} class="hover:text-white">{t(locale, 'nav.about')}</a>
        <a href={lp('/about/') + '#official-vtai-websites'} class="hover:text-white">{identity.directoryLink}</a>
      </div>
    </div>
  </div>
</footer>
