---
interface Props {
  src?: string;
  alt: string;
  ratio?: '16/9' | '4/3' | '1/1' | '3/2';
  label?: string;
  class?: string;
}
const { src, alt, ratio = '16/9', label, class: cls = '' } = Astro.props;
const aspect = { '16/9': 'aspect-[16/9]', '4/3': 'aspect-[4/3]', '1/1': 'aspect-square', '3/2': 'aspect-[3/2]' }[ratio];
---
{src ? (
  <img src={src} alt={alt} class={`${aspect} object-cover rounded-card ${cls}`} loading="lazy" decoding="async" />
) : (
  <div class={`${aspect} ${cls} bg-gradient-to-br from-bakery-cream to-bakery-cream/50 rounded-card flex flex-col items-center justify-center text-bakery-brown border border-bakery-brown/15`}
       role="img" aria-label={alt}>
    <svg class="w-12 h-12 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 0 1 2.828 0L16 16m-2-2l1.586-1.586a2 2 0 0 1 2.828 0L20 14m-6-6h.01M6 20h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z"/>
    </svg>
    <p class="text-xs md:text-sm font-medium mt-2 px-4 text-center opacity-70">{label ?? alt}</p>
    <p class="text-[10px] opacity-40 mt-1">Placeholder · see IMAGES-NEEDED.md</p>
  </div>
)}
