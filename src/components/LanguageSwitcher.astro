---
import { languages, getTranslatedLocales, type Locale } from '../i18n/utils';

interface Props {
  canonicalPath: string;
  currentLocale: Locale;
}
const { canonicalPath, currentLocale } = Astro.props;
const available = getTranslatedLocales(canonicalPath);
---
<div class="relative inline-block group">
  <button class="px-3 py-2 text-sm font-medium text-bakery-navy hover:text-bakery-orange flex items-center gap-1" aria-haspopup="true">
    <span>{languages[currentLocale]}</span>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
  </button>
  <div class="absolute right-0 top-full mt-1 bg-white shadow-card-hover rounded-card py-2 min-w-[160px] hidden group-hover:block z-50">
    {available.map((loc) => (
      <a
        href={loc === 'en' ? canonicalPath : `/${loc}${canonicalPath}`}
        class={`block px-4 py-2 text-sm hover:bg-bakery-cream ${loc === currentLocale ? 'font-bold text-bakery-orange' : 'text-bakery-navy'}`}
      >
        {languages[loc]}
      </a>
    ))}
  </div>
</div>
