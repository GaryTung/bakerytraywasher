---
interface Props { quote: string; author: string; role?: string }
const { quote, author, role } = Astro.props;
---
<figure class="card">
  <svg class="w-8 h-8 text-bakery-orange mb-3" viewBox="0 0 24 24" fill="currentColor">
    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
  </svg>
  <blockquote class="text-bakery-navy mb-3 leading-relaxed">{quote}</blockquote>
  <figcaption class="text-sm">
    <span class="font-semibold text-bakery-navy">{author}</span>
    {role && <span class="text-bakery-navy/60"> · {role}</span>}
  </figcaption>
</figure>
