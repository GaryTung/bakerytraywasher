---
interface QA { q: string; a: string }
interface Props { items: QA[]; title?: string }
const { items, title = 'Frequently Asked Questions' } = Astro.props;

const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
};
---
<section class="section">
  <div class="container-prose">
    <h2 class="mb-6">{title}</h2>
    <div class="space-y-3">
      {items.map((it) => (
        <details class="card !p-5 group">
          <summary class="cursor-pointer font-semibold text-bakery-navy flex items-center justify-between gap-4">
            <span>{it.q}</span>
            <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <p class="mt-3 text-bakery-navy/80" set:html={it.a} />
        </details>
      ))}
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
