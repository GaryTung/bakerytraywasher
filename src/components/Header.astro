---
import { t, localizePath, type Locale } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  canonicalPath: string;
}
const { locale, canonicalPath } = Astro.props;
const lp = (p: string) => localizePath(p, locale);
---
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-bakery-navy/5">
  <div class="container-page flex items-center justify-between h-16">
    <a href={lp('/')} class="flex items-center gap-2 font-display font-bold text-bakery-navy text-lg">
      <svg class="w-7 h-7 text-bakery-orange" viewBox="0 0 24 24" fill="currentColor"><path d="M5 5h14v3H5zM5 10h14v9a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1zm3 3v4h8v-4z"/></svg>
      <span>V-TAI <span class="text-bakery-orange">JD-3</span></span>
    </a>

    <nav class="hidden lg:flex items-center gap-1 text-sm font-medium text-bakery-navy">
      <a href={lp('/product/')} class="px-3 py-2 hover:text-bakery-orange">{t(locale, 'nav.product')}</a>
      <a href={lp('/by-business-type/')} class="px-3 py-2 hover:text-bakery-orange">{t(locale, 'nav.business')}</a>
      <a href={lp('/what-it-washes/')} class="px-3 py-2 hover:text-bakery-orange">{t(locale, 'nav.washes')}</a>
      <a href={lp('/vs/')} class="px-3 py-2 hover:text-bakery-orange">{t(locale, 'nav.compare')}</a>
      <a href={lp('/pricing/')} class="px-3 py-2 hover:text-bakery-orange">{t(locale, 'nav.pricing')}</a>

      <!-- Resources dropdown -->
      <div class="relative group">
        <button class="px-3 py-2 hover:text-bakery-orange flex items-center gap-1" aria-haspopup="true">
          <span>{t(locale, 'nav.resources')}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <div class="absolute right-0 top-full mt-0 bg-white shadow-card-hover rounded-card py-2 min-w-[220px] hidden group-hover:block z-50 border border-bakery-navy/5">
          <a href={lp('/pricing/by-country/')} class="block px-4 py-2 hover:bg-bakery-cream text-bakery-navy">{t(locale, 'nav.ddpByCountry')}</a>
          <a href={lp('/guides/bakery-tray-cleaning-best-practices/')} class="block px-4 py-2 hover:bg-bakery-cream text-bakery-navy">{t(locale, 'nav.guides')}</a>
          <a href={lp('/case-studies/')} class="block px-4 py-2 hover:bg-bakery-cream text-bakery-navy">{t(locale, 'nav.cases')}</a>
          <a href={lp('/blog/')} class="block px-4 py-2 hover:bg-bakery-cream text-bakery-navy">{t(locale, 'nav.blog')}</a>
          <a href={lp('/faq/')} class="block px-4 py-2 hover:bg-bakery-cream text-bakery-navy">{t(locale, 'nav.faq')}</a>
          <div class="border-t border-bakery-navy/5 my-1"></div>
          <a href={lp('/about/')} class="block px-4 py-2 hover:bg-bakery-cream text-bakery-navy">{t(locale, 'nav.about')}</a>
          <a href={lp('/contact/')} class="block px-4 py-2 hover:bg-bakery-cream text-bakery-navy">{t(locale, 'nav.contact')}</a>
        </div>
      </div>
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher canonicalPath={canonicalPath} currentLocale={locale} />
      <a href={lp('/get-quote/')} class="btn-primary !px-4 !py-2 !text-sm">{t(locale, 'nav.quote')}</a>
      <button id="mobile-menu-btn" class="lg:hidden p-2" aria-label="Toggle menu">
        <svg class="w-6 h-6 text-bakery-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="lg:hidden hidden border-t border-bakery-navy/5 bg-white">
    <div class="container-page py-4 flex flex-col gap-1 text-sm font-medium">
      <a href={lp('/product/')} class="px-3 py-3 hover:bg-bakery-cream rounded">{t(locale, 'nav.product')}</a>
      <a href={lp('/by-business-type/')} class="px-3 py-3 hover:bg-bakery-cream rounded">{t(locale, 'nav.business')}</a>
      <a href={lp('/what-it-washes/')} class="px-3 py-3 hover:bg-bakery-cream rounded">{t(locale, 'nav.washes')}</a>
      <a href={lp('/vs/')} class="px-3 py-3 hover:bg-bakery-cream rounded">{t(locale, 'nav.compare')}</a>
      <a href={lp('/pricing/')} class="px-3 py-3 hover:bg-bakery-cream rounded">{t(locale, 'nav.pricing')}</a>
      <div class="border-t border-bakery-navy/5 my-1"></div>
      <p class="px-3 pt-2 pb-1 text-xs uppercase tracking-wider text-bakery-navy/50 font-semibold">{t(locale, 'nav.resources')}</p>
      <a href={lp('/pricing/by-country/')} class="px-3 py-2 hover:bg-bakery-cream rounded text-bakery-navy/70">{t(locale, 'nav.ddpByCountry')}</a>
      <a href={lp('/guides/bakery-tray-cleaning-best-practices/')} class="px-3 py-2 hover:bg-bakery-cream rounded text-bakery-navy/70">{t(locale, 'nav.guides')}</a>
      <a href={lp('/case-studies/')} class="px-3 py-2 hover:bg-bakery-cream rounded text-bakery-navy/70">{t(locale, 'nav.cases')}</a>
      <a href={lp('/blog/')} class="px-3 py-2 hover:bg-bakery-cream rounded text-bakery-navy/70">{t(locale, 'nav.blog')}</a>
      <a href={lp('/faq/')} class="px-3 py-2 hover:bg-bakery-cream rounded text-bakery-navy/70">{t(locale, 'nav.faq')}</a>
      <a href={lp('/about/')} class="px-3 py-2 hover:bg-bakery-cream rounded text-bakery-navy/70">{t(locale, 'nav.about')}</a>
      <a href={lp('/contact/')} class="px-3 py-2 hover:bg-bakery-cream rounded text-bakery-navy/70">{t(locale, 'nav.contact')}</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
