---
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
import { waterSoftenerBlogCopy } from '../i18n/water-softener-blog';
import { localizePath, type Locale } from '../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = waterSoftenerBlogCopy[locale];
const lp = (path: string) => localizePath(path, locale);
const faqItems = copy.faqs.map(([q, a]) => ({ q, a }));
const links = [
  '/guides/dishwasher-detergent-for-bakery/',
  '/blog/commercial-dishwasher-maintenance-schedule/',
  '/product/jd-3-specifications/',
  '/product/jd-3-installation/',
  '/get-quote/',
];
---
<BlogPostLayout
  locale={locale}
  canonicalPath="/blog/bakery-tray-washer-water-softener/"
  slug="bakery-tray-washer-water-softener"
  title={copy.title}
  description={copy.description}
  pubDate="2026-09-23"
  tldr={copy.tldr}
  faqs={faqItems}
>
  <h2>{copy.answerTitle}</h2>
  {copy.answer.map((paragraph) => <p>{paragraph}</p>)}

  <h2>{copy.factsTitle}</h2>
  <ul>{copy.facts.map((fact) => <li>{fact}</li>)}</ul>

  <h2>{copy.matrixTitle}</h2>
  <p>{copy.matrixIntro}</p>
  <div class="overflow-x-auto my-6">
    <table class="w-full text-sm border border-bakery-navy/10">
      <thead><tr>{copy.matrixHeaders.map((header) => <th class="text-start p-3 bg-bakery-cream">{header}</th>)}</tr></thead>
      <tbody>{copy.matrixRows.map((row) => <tr class="border-t border-bakery-navy/10"><td class="p-3 font-semibold">{row.evidence}</td><td class="p-3">{row.meaning}</td><td class="p-3">{row.action}</td></tr>)}</tbody>
    </table>
  </div>

  <h2>{copy.testTitle}</h2>
  <p>{copy.testIntro}</p>
  <ol>{copy.testSteps.map((step) => <li>{step}</li>)}</ol>

  <h2>{copy.sizeTitle}</h2>
  {copy.size.map((paragraph) => <p set:html={paragraph} />)}

  <h2>{copy.quoteTitle}</h2>
  <ul>{copy.quoteItems.map((item) => <li>{item}</li>)}</ul>

  <h2>{copy.redFlagsTitle}</h2>
  <ul>{copy.redFlags.map((item) => <li>{item}</li>)}</ul>

  <h2>{copy.nextTitle}</h2>
  <p>{copy.nextIntro}</p>
  <ul>{links.map((href, index) => <li><a class="underline" href={lp(href)}>{copy.links[index]}</a></li>)}</ul>
</BlogPostLayout>
