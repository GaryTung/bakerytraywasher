---
import { t, localizePath, type Locale } from '../i18n/utils';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<div class="card bg-gradient-to-br from-bakery-cream to-white border-bakery-brown/20">
  <p class="eyebrow mb-1">{t(locale, 'priceCallout.eyebrow')}</p>
  <p class="text-3xl md:text-4xl font-bold text-bakery-navy">
    <span class="text-base text-bakery-brown">{t(locale, 'common.from')}</span> $4,400
    <span class="text-base text-bakery-brown ml-2">{t(locale, 'common.fob')}</span>
  </p>
  <p class="text-sm text-bakery-navy/70 mt-2">{t(locale, 'priceCallout.tagline')}</p>
  <a href={localizePath('/get-quote/', locale)} class="btn-primary mt-4 w-full">{t(locale, 'cta.quote')}</a>
</div>
