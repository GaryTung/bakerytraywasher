---
interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;

// Google Search Console requires a non-empty `item` (URL) on every
// BreadcrumbList ListItem, and the URLs should make sense semantically
// (Home → site root; intermediate hub → hub URL; current → current URL).
//
// When a crumb provides no href (common for hub crumbs and the current
// page), derive a URL from the page's pathname. The relationship between
// crumb index and how many path segments it represents is:
//
//   segments_for_crumb(i) = segments.length - (items.length - i - 1)
//
// This works whether or not the URL has a locale prefix:
//   EN /blog/article/         → segs=['blog','article'],            crumbs=[Home,Blog,Article]
//   DE /de/guides/article/    → segs=['de','guides','article'],     crumbs=[Home,Guides,Article]
// In both cases, position 0 → site (or locale) root, last → current page.
const site = 'https://bakerytraywasher.com';
const currentPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : Astro.url.pathname + '/';

// Split current path into non-empty segments.
const segments = currentPath.split('/').filter(Boolean);

const deriveUrl = (idx: number, total: number) => {
  const trailingAfter = total - idx - 1;
  const segCount = Math.max(0, segments.length - trailingAfter);
  if (segCount === 0) return `${site}/`;
  return `${site}/${segments.slice(0, segCount).join('/')}/`;
};

const toAbs = (href: string | undefined, idx: number, total: number) => {
  if (href) {
    if (/^https?:\/\//i.test(href)) return href;
    return `${site}${href.startsWith('/') ? '' : '/'}${href}`;
  }
  return deriveUrl(idx, total);
};

const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: toAbs(c.href, i, items.length),
  })),
};
---
<nav class="container-page py-3 text-sm text-bakery-navy/60" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((c, i) => (
      <li class="flex items-center gap-2">
        {c.href ? <a href={c.href} class="hover:text-bakery-orange">{c.label}</a> : <span>{c.label}</span>}
        {i < items.length - 1 && <span aria-hidden="true">›</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
