---
interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;

// Google Search Console requires `item` on every BreadcrumbList entry.
// For the current page (the last crumb, which has no href in the visible
// nav), fall back to the page's canonical URL so the JSON-LD stays valid.
const site = 'https://bakerytraywasher.com';
const currentUrl = new URL(Astro.url.pathname, site).toString();
const toAbs = (href?: string) => {
  if (!href) return currentUrl;
  if (/^https?:\/\//i.test(href)) return href;
  return `${site}${href.startsWith('/') ? '' : '/'}${href}`;
};

const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: toAbs(c.href),
  })),
};
---
<nav class="container-page py-3 text-sm text-bakery-navy/60" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((c, i) => (
      <li class="flex items-center gap-2">
        {c.href ? <a href={c.href} class="hover:text-bakery-orange">{c.label}</a> : <span>{c.label}</span>}
        {i < items.length - 1 && <span aria-hidden="true">›</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
