---
interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;

const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: `https://bakerytraywasher.com${c.href}` } : {}),
  })),
};
---
<nav class="container-page py-3 text-sm text-bakery-navy/60" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((c, i) => (
      <li class="flex items-center gap-2">
        {c.href ? <a href={c.href} class="hover:text-bakery-orange">{c.label}</a> : <span>{c.label}</span>}
        {i < items.length - 1 && <span aria-hidden="true">›</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
