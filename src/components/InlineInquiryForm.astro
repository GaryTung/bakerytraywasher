---
import { t, type Locale } from '../i18n/utils';
interface Props { locale: Locale; businessTypePreset?: string; title?: string }
const { locale, businessTypePreset, title } = Astro.props;
const finalTitle = title ?? t(locale, 'inquiry.defaultTitle');
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || 'YOUR_WEB3FORMS_ACCESS_KEY_HERE';
const thankYouPath = locale === 'en' ? '/thank-you/' : `/${locale}/thank-you/`;
const thankYouUrl = `https://bakerytraywasher.com${thankYouPath}`;
---
<div class="card bg-bakery-cream">
  <h3 class="text-2xl font-bold mb-2">{finalTitle}</h3>
  <p class="text-bakery-navy/70 mb-4 text-sm">{t(locale, 'inquiry.replyTime')}</p>
  <form action="https://api.web3forms.com/submit" method="POST" class="quote-form space-y-3" data-thank-you={thankYouPath}>
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="[JD-3 Inline Inquiry] from bakerytraywasher.com" />
    <input type="hidden" name="from_name" value="bakerytraywasher.com" />
    <input type="hidden" name="redirect" value={thankYouUrl} />
    <input type="hidden" name="source_page" class="source-page" value="" />
    {businessTypePreset && <input type="hidden" name="business_type" value={businessTypePreset} />}
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" />

    <input type="text" name="full_name" required placeholder={t(locale, 'form.name') + ' *'}
      class="block w-full rounded-card border border-bakery-navy/15 px-4 py-3 outline-none focus:border-bakery-orange" />
    <input type="email" name="email" required placeholder={t(locale, 'form.email') + ' *'}
      class="block w-full rounded-card border border-bakery-navy/15 px-4 py-3 outline-none focus:border-bakery-orange" />
    <input type="tel" name="whatsapp" required placeholder={t(locale, 'form.whatsapp') + ' *'}
      class="block w-full rounded-card border border-bakery-navy/15 px-4 py-3 outline-none focus:border-bakery-orange" />
    <input type="text" name="country" required placeholder={t(locale, 'form.country') + ' *'}
      class="block w-full rounded-card border border-bakery-navy/15 px-4 py-3 outline-none focus:border-bakery-orange" />
    <textarea name="message" rows="3" placeholder={t(locale, 'form.message')}
      class="block w-full rounded-card border border-bakery-navy/15 px-4 py-3 outline-none focus:border-bakery-orange"></textarea>

    <button type="submit" class="btn-primary w-full">{t(locale, 'form.submit')}</button>
    <div class="form-result text-sm hidden p-3 rounded-card"></div>
  </form>
</div>

<script>
  document.querySelectorAll('.quote-form').forEach((formEl) => {
    const form = formEl as HTMLFormElement;
    if (form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';
    const result = form.querySelector('.form-result') as HTMLDivElement;
    const sourceInput = form.querySelector('.source-page') as HTMLInputElement;
    if (sourceInput) sourceInput.value = window.location.href;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const obj: any = Object.fromEntries(formData as any);
      const washes = formData.getAll('washes[]');
      if (washes.length) obj['washes'] = washes.join(', ');
      delete obj['washes[]'];

      if (result) {
        result.classList.remove('hidden');
        result.className = 'form-result text-sm p-3 rounded-card bg-bakery-cream text-bakery-navy';
        result.textContent = 'Sending…';
      }

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(obj),
        });
        const data = await res.json();
        if (data.success) {
          window.location.href = form.dataset.thankYou || '/thank-you/';
        } else if (result) {
          result.className = 'form-result text-sm p-3 rounded-card bg-red-50 text-red-800 border border-red-200';
          result.innerHTML = 'Submission failed. Please email info@v-tai.com or WhatsApp +86 135 0962 3269.';
        }
      } catch {
        if (result) {
          result.className = 'form-result text-sm p-3 rounded-card bg-red-50 text-red-800 border border-red-200';
          result.innerHTML = 'Network error. Please WhatsApp +86 135 0962 3269 directly.';
        }
      }
    });
  });
</script>
