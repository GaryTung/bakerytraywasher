---
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
import { burntGreaseBlogCopy } from '../i18n/burnt-grease-blog';
import { localizePath, type Locale } from '../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = burntGreaseBlogCopy[locale];
const lp = (path: string) => localizePath(path, locale);
const faqItems = copy.faqs.map(([q, a]) => ({ q, a }));
const links = [
  '/blog/chemistry-of-washing-bakery-trays/',
  '/blog/bakery-tray-washer-sample-wash-test/',
  '/blog/aluminum-baking-trays-commercial-dishwasher/',
  '/guides/dishwasher-detergent-for-bakery/',
  '/get-quote/',
];
---
<BlogPostLayout
  locale={locale}
  canonicalPath="/blog/bakery-tray-washer-burnt-on-grease/"
  slug="bakery-tray-washer-burnt-on-grease"
  title={copy.title}
  description={copy.description}
  pubDate="2026-09-16"
  tldr={copy.tldr}
  faqs={faqItems}
>
  <h2>{copy.answerTitle}</h2>
  {copy.answer.map((paragraph) => <p>{paragraph}</p>)}

  <h2>{copy.factsTitle}</h2>
  <ul>{copy.facts.map((fact) => <li>{fact}</li>)}</ul>

  <h2>{copy.matrixTitle}</h2>
  <p>{copy.matrixIntro}</p>
  <div class="overflow-x-auto my-6">
    <table class="w-full text-sm border border-bakery-navy/10">
      <thead><tr>{copy.matrixHeaders.map((header) => <th class="text-start p-3 bg-bakery-cream">{header}</th>)}</tr></thead>
      <tbody>{copy.matrixRows.map((row) => <tr class="border-t border-bakery-navy/10"><td class="p-3 font-semibold">{row.soil}</td><td class="p-3">{row.sign}</td><td class="p-3">{row.expectation}</td><td class="p-3">{row.action}</td></tr>)}</tbody>
    </table>
  </div>

  <h2>{copy.testTitle}</h2>
  <p>{copy.testIntro}</p>
  <ol>{copy.testSteps.map((step) => <li>{step}</li>)}</ol>

  <h2>{copy.passTitle}</h2>
  <ul>{copy.passItems.map((item) => <li>{item}</li>)}</ul>

  <h2>{copy.redFlagsTitle}</h2>
  <ul>{copy.redFlags.map((item) => <li>{item}</li>)}</ul>

  <h2>{copy.buyTitle}</h2>
  {copy.buy.map((paragraph) => <p>{paragraph}</p>)}

  <h2>{copy.nextTitle}</h2>
  <p>{copy.nextIntro}</p>
  <ul>{links.map((href, index) => <li><a class="underline" href={lp(href)}>{copy.links[index]}</a></li>)}</ul>
</BlogPostLayout>
